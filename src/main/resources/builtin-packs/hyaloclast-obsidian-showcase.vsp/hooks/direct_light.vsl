#include <vulkanshaders/v1/common.vsl>

// @hook(stage = "direct_light", priority = 100)
// Obsidian Showcase - High-contrast chiaroscuro direct shading: warm golden sunlight vs.
// deep cobalt shadow fill, plus strong backlit foliage and glacial ice subsurface scattering (0.72).
void os_direct_light(in VsSurface s, in vec3 viewDir, in vec3 lightDir, inout vec3 brdf) {
    float ndotlRaw = dot(s.normal, lightDir);
    float ndotl = max(ndotlRaw, 0.0);

    if (dot(brdf, brdf) <= 1e-8) {
        vec3 Hsum = viewDir + lightDir;
        vec3 H = dot(Hsum, Hsum) > 1e-8 ? normalize(Hsum) : s.normal;
        float ndoth = max(dot(s.normal, H), 0.0);
        float specPower = mix(112.0, 4.0, clamp(s.roughness * s.roughness, 0.02, 1.0));
        float spec = pow(ndoth, specPower) * mix(s.f0, 1.0, s.metallic);
        brdf = s.albedo * (ndotl * (1.0 - s.metallic) * (1.0 / 3.14159265)) + vec3(spec * ndotl);
    }

    // High-contrast chiaroscuro: deep cobalt shadow fill vs warm golden direct sunlight
    float sunRamp = smoothstep(0.06, 0.74, ndotl);
    float contrastCurve = mix(0.80, 1.15, sunRamp);
    vec3 chiaroscuroTint = mix(vec3(0.80, 0.90, 1.12), vec3(1.12, 1.00, 0.86), sunRamp);
    brdf *= chiaroscuroTint * contrastCurve;

    // Deep cobalt shadow-fill wrap micro-bounce along terminator edges
    float terminatorBand = smoothstep(-0.42, 0.16, ndotlRaw) * (1.0 - smoothstep(0.16, 0.62, ndotlRaw));
    vec3 cobaltFill = vec3(0.68, 0.82, 1.16);
    brdf += s.albedo * cobaltFill * (terminatorBand * 0.036 * (1.0 - s.metallic));

    if (s.subsurface > 0.01) {
        // Strong backlit foliage, glacial ice, snow, and crystal subsurface transmission (0.72)
        vec3 Hback = normalize(lightDir + s.normal * 0.34);
        float backlit = pow(clamp(dot(viewDir, -Hback), 0.0, 1.0), 2.7) * 0.72;
        float wrap = max(0.0, (ndotlRaw + 0.46) / 1.46) * 0.22;

        float maxCh = max(max(s.albedo.r, s.albedo.g), s.albedo.b);
        float minCh = min(min(s.albedo.r, s.albedo.g), s.albedo.b);
        float chroma = (maxCh > 1e-4) ? ((maxCh - minCh) / maxCh) : 0.0;
        vec3 albedoHue = s.albedo / max(maxCh, 1e-4);
        float greenDominance = smoothstep(0.04, 0.28, s.albedo.g - max(s.albedo.r, s.albedo.b));
        float snowIceMask = smoothstep(0.50, 0.84, maxCh) * (1.0 - smoothstep(0.06, 0.30, chroma));

        vec3 glacialScatter = vec3(0.80, 0.98, 1.20);
        vec3 neutralScatter = mix(vec3(0.96, 1.00, 1.08), glacialScatter, snowIceMask);
        vec3 hueScatter = mix(vec3(1.0), albedoHue * 1.18 + vec3(0.08), 0.72);
        vec3 naturalScatter = mix(neutralScatter, hueScatter, smoothstep(0.08, 0.44, chroma));
        vec3 botanicalScatter = vec3(1.16, 1.22, 0.66);
        vec3 sssTint = mix(naturalScatter, botanicalScatter, greenDominance);

        brdf += s.albedo * sssTint * (backlit + wrap) * s.subsurface;
    }
}
