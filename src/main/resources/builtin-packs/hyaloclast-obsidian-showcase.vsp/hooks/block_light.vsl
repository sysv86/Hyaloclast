#include <vulkanshaders/v1/common.vsl>

// @hook(stage = "block_light", priority = 10)
// Obsidian Showcase - High-saturation 10-kind spectral emissive curves tuned to showcase
// ReSTIR DI colored direct block lighting and SHaRC multi-bounce colored global illumination.
void os_block_light(inout vec3 radiance, in uint lightKind, in float dist) {
    float nearness = clamp(1.0 - (dist - 0.35) / 6.2, 0.0, 1.0);
    float hotCore = pow(nearness, 3.4);
    float flicker = 1.0;

    vec3 tint;
    if (lightKind == 1u) {
        // Soul fire / soul lantern: electric spectral cyan-turquoise -> pale ice-cyan core
        vec3 outerSoul = vec3(0.04, 0.46, 0.88);
        vec3 midSoul   = vec3(0.16, 0.84, 1.06);
        vec3 coreSoul  = vec3(0.70, 0.98, 1.08);
        tint = mix(mix(outerSoul, midSoul, nearness), coreSoul, hotCore);
        flicker = 0.95 + 0.05 * sin(vsWorld.gameTimeSec * 4.5 + dist * 0.75);
    } else if (lightKind == 2u) {
        // Lava / magma: deep volcanic crimson -> molten orange-gold core
        vec3 outerMagma = vec3(1.08, 0.12, 0.01);
        vec3 midMagma   = vec3(1.16, 0.44, 0.05);
        vec3 coreMagma  = vec3(1.14, 0.84, 0.24);
        tint = mix(mix(outerMagma, midMagma, nearness), coreMagma, hotCore);
        flicker = 0.96 + 0.04 * sin(vsWorld.gameTimeSec * 2.3 + dist * 0.45);
    } else if (lightKind == 3u) {
        // Sea lantern / beacon / conduit: vivid marine aqua -> luminous pearl-cyan core
        vec3 outerSea = vec3(0.14, 0.78, 0.96);
        vec3 midSea   = vec3(0.48, 0.96, 1.06);
        vec3 coreSea  = vec3(0.88, 1.02, 1.06);
        tint = mix(mix(outerSea, midSea, nearness), coreSea, hotCore);
    } else if (lightKind == 4u) {
        // Redstone torch / ore: saturated ruby crimson -> bright scarlet core
        vec3 outerRed = vec3(0.98, 0.03, 0.02);
        vec3 midRed   = vec3(1.14, 0.12, 0.06);
        vec3 coreRed  = vec3(1.16, 0.34, 0.18);
        tint = mix(mix(outerRed, midRed, nearness), coreRed, hotCore);
        flicker = 0.96 + 0.04 * sin(vsWorld.gameTimeSec * 6.8 + dist * 1.1);
    } else if (lightKind == 5u) {
        // Glowstone / shroomlight: rich honey-amber -> warm gold core
        vec3 outerAmber = vec3(1.06, 0.54, 0.08);
        vec3 midAmber   = vec3(1.14, 0.78, 0.28);
        vec3 coreAmber  = vec3(1.12, 0.96, 0.66);
        tint = mix(mix(outerAmber, midAmber, nearness), coreAmber, hotCore);
    } else if (lightKind == 6u) {
        // End rod / amethyst: vivid orchid-violet -> crystalline opal-white core
        vec3 outerAmethyst = vec3(0.64, 0.42, 1.06);
        vec3 midAmethyst   = vec3(0.86, 0.72, 1.08);
        vec3 coreAmethyst  = vec3(1.00, 0.95, 1.06);
        tint = mix(mix(outerAmethyst, midAmethyst, nearness), coreAmethyst, hotCore);
    } else if (lightKind == 7u) {
        // Sculk / deep-dark: abyssal deep-teal -> pulsing bioluminescent cyan core
        vec3 outerSculk = vec3(0.02, 0.36, 0.52);
        vec3 midSculk   = vec3(0.10, 0.78, 0.92);
        vec3 coreSculk  = vec3(0.42, 0.98, 1.06);
        tint = mix(mix(outerSculk, midSculk, nearness), coreSculk, hotCore);
        flicker = 0.88 + 0.12 * sin(vsWorld.gameTimeSec * 2.6);
    } else if (lightKind == 8u) {
        // Copper / emerald / ender flame: saturated verdigris-emerald -> vivid mint core
        vec3 outerVerdigris = vec3(0.05, 0.70, 0.38);
        vec3 midVerdigris   = vec3(0.24, 0.96, 0.60);
        vec3 coreVerdigris  = vec3(0.68, 1.06, 0.84);
        tint = mix(mix(outerVerdigris, midVerdigris, nearness), coreVerdigris, hotCore);
    } else if (lightKind == 9u) {
        // Arcane magenta / enchanted violet: saturated royal violet -> electric magenta core
        vec3 outerArcane = vec3(0.60, 0.10, 1.02);
        vec3 midArcane   = vec3(0.86, 0.36, 1.08);
        vec3 coreArcane  = vec3(1.02, 0.72, 1.08);
        tint = mix(mix(outerArcane, midArcane, nearness), coreArcane, hotCore);
    } else {
        // Default (0u): Torch / lantern / campfire - high-saturation blackbody firelight
        vec3 outerEmber = vec3(1.08, 0.26, 0.04);
        vec3 midAmber   = vec3(1.16, 0.58, 0.14);
        vec3 innerFlame = vec3(1.12, 0.92, 0.60);
        tint = mix(mix(outerEmber, midAmber, nearness), innerFlame, hotCore);
        float t = vsWorld.gameTimeSec;
        flicker = 0.955 + 0.028 * sin(t * 5.9) + 0.017 * cos(t * 11.7 + 0.8);
    }

    float falloff = 1.0 / (1.0 + dist * dist * 0.085);
    vec3 shaped = tint * (mix(0.98, 1.52, falloff) * flicker);

    if (dot(radiance, radiance) <= 1e-6) {
        radiance = shaped;
    } else {
        radiance *= shaped;
    }
}
