#include <vulkanshaders/v1/common.vsl>

// Obsidian Showcase - 10-step 3D fBm billowing cumulus with Beer-Powder self-shadowing,
// dual-lobe Henyey-Greenstein silver lining (g = 0.80 / -0.22), deep base-to-top contrast,
// high windswept cirrus veil at y = 540, and night emerald aurora bounce on cloud undersides.

float os_cloudHash13(vec3 p3) {
    p3 = fract(p3 * 0.1031);
    p3 += dot(p3, p3.zyx + 31.32);
    return fract((p3.x + p3.y) * p3.z);
}

float os_cloudNoise3D(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    vec3 u = f * f * (3.0 - 2.0 * f);

    float n000 = os_cloudHash13(i + vec3(0.0, 0.0, 0.0));
    float n100 = os_cloudHash13(i + vec3(1.0, 0.0, 0.0));
    float n010 = os_cloudHash13(i + vec3(0.0, 1.0, 0.0));
    float n110 = os_cloudHash13(i + vec3(1.0, 1.0, 0.0));
    float n001 = os_cloudHash13(i + vec3(0.0, 0.0, 1.0));
    float n101 = os_cloudHash13(i + vec3(1.0, 0.0, 1.0));
    float n011 = os_cloudHash13(i + vec3(0.0, 1.0, 1.0));
    float n111 = os_cloudHash13(i + vec3(1.0, 1.0, 1.0));

    float nx00 = mix(n000, n100, u.x);
    float nx10 = mix(n010, n110, u.x);
    float nx01 = mix(n001, n101, u.x);
    float nx11 = mix(n011, n111, u.x);
    return mix(mix(nx00, nx10, u.y), mix(nx01, nx11, u.y), u.z);
}

float os_cloudFbm3D(vec3 p) {
    float v = 0.0;
    float a = 0.54;
    vec3 shift = vec3(19.3, 11.7, 23.1);
    for (int i = 0; i < 4; ++i) {
        v += a * os_cloudNoise3D(p);
        p = p * 2.04 + shift;
        a *= 0.48;
    }
    return v;
}

float os_cloudHgPhase(float cosTheta, float g) {
    float g2 = g * g;
    float denom = max(1.0 + g2 - 2.0 * g * cosTheta, 1e-4);
    return (1.0 - g2) / (12.56637061 * pow(denom, 1.5));
}

float os_cloudDualLobePhase(float cosTheta) {
    float forward = os_cloudHgPhase(cosTheta, 0.80);
    float back = os_cloudHgPhase(cosTheta, -0.22);
    return mix(forward, back, 0.24);
}

float os_sampleCumulusDensity(
    vec3 worldPos,
    VsSkyState sky,
    float cloudBottom,
    float cloudTop,
    float biomeCloudScale,
    float stormFactor
) {
    float h = clamp((worldPos.y - cloudBottom) / max(cloudTop - cloudBottom, 1.0), 0.0, 1.0);
    if (h <= 0.0 || h >= 1.0) {
        return 0.0;
    }

    // Crisp condensation base with tall sculpted cumulus towers
    float topRoll = mix(0.42, 0.72, stormFactor);
    float heightProfile = smoothstep(0.0, 0.14, h) * smoothstep(1.0, topRoll, h);

    vec3 wind = vec3(sky.gameTimeSec * 4.8, 0.0, sky.gameTimeSec * 1.9);
    vec3 drifted = worldPos + wind;

    vec3 samplePos = drifted * vec3(0.00185, 0.0080, 0.00185);
    float baseShape = os_cloudFbm3D(samplePos);

    // Sculpted cauliflower billow detail
    float billow = 1.0 - abs(os_cloudNoise3D(samplePos * 2.20 + vec3(4.2, -h * 0.65, 7.8)) * 2.0 - 1.0);
    float sculpted = mix(baseShape, baseShape * 0.74 + billow * 0.32, 0.46);

    float coverage = clamp(mix(0.48 * biomeCloudScale, 0.85, stormFactor), 0.20, 0.88);
    float raw = sculpted * heightProfile - (1.0 - coverage) * 0.58;
    if (raw <= -0.02) {
        return 0.0;
    }

    float erode = os_cloudNoise3D(drifted * vec3(0.0092, 0.014, 0.0092) - vec3(0.0, sky.gameTimeSec * 0.07, 0.0));
    float eroded = raw - erode * 0.14 * (1.0 - h * 0.40);
    return clamp(eroded * mix(3.05, 3.70, stormFactor), 0.0, 1.0);
}

// @hook(stage = "clouds", priority = 100)
vec4 os_clouds(in vec3 dir, in vec3 cameraPos, in VsSkyState sky) {
    if (vsDimensionId() != 0) {
        return vec4(0.0, 0.0, 0.0, 1.0);
    }

    float stormFactor = clamp(sky.rain * 0.85 + sky.thunder * 0.45, 0.0, 1.0);
    float cloudBottom = mix(278.0, 250.0, stormFactor);
    float cloudTop = mix(386.0, 396.0, stormFactor);

    if (dir.y <= 0.012 && cameraPos.y < cloudBottom) {
        return vec4(0.0, 0.0, 0.0, 1.0);
    }

    float tEnter;
    float tExit;
    if (cameraPos.y < cloudBottom) {
        tEnter = (cloudBottom - cameraPos.y) / max(dir.y, 0.018);
        tExit = (cloudTop - cameraPos.y) / max(dir.y, 0.018);
    } else if (cameraPos.y > cloudTop) {
        if (dir.y >= -0.012) {
            return vec4(0.0, 0.0, 0.0, 1.0);
        }
        tEnter = (cloudTop - cameraPos.y) / min(dir.y, -0.018);
        tExit = (cloudBottom - cameraPos.y) / min(dir.y, -0.018);
    } else {
        tEnter = 0.0;
        tExit = (dir.y >= 0.0)
            ? (cloudTop - cameraPos.y) / max(dir.y, 0.018)
            : (cloudBottom - cameraPos.y) / min(dir.y, -0.018);
    }

    tEnter = max(tEnter, 0.0);
    tExit = min(tExit, 2600.0);
    if (tExit <= tEnter) {
        return vec4(0.0, 0.0, 0.0, 1.0);
    }

    const int PRIMARY_STEPS = 10;
    float stepSize = (tExit - tEnter) / float(PRIMARY_STEPS);
    float biomeCloudScale = vsBiomeCloudScale();

    vec3 sunDir = normalize(sky.sunDir + vec3(0.0, 1e-5, 0.0));
    bool isDay = sunDir.y > -0.06;
    vec3 lightDir = isDay
        ? sunDir
        : normalize(vec3(-sunDir.x, max(-sunDir.y, 0.14), -sunDir.z));
    float cosTheta = dot(dir, lightDir);
    float phase = os_cloudDualLobePhase(cosTheta);

    float dayFactor = smoothstep(-0.10, 0.22, sunDir.y);
    float nightFactor = 1.0 - dayFactor;
    float sunsetFactor = smoothstep(-0.16, 0.02, sunDir.y) * (1.0 - smoothstep(0.06, 0.30, sunDir.y));

    // Luminous sunlit tops + intense golden-coral twilight rims
    vec3 directColor = mix(vec3(0.11, 0.17, 0.32), vec3(1.24, 1.10, 0.92), dayFactor);
    directColor = mix(directColor, vec3(1.48, 0.56, 0.20), sunsetFactor * 0.94);
    directColor *= (1.0 - stormFactor * 0.60);

    // Deep sculptural base-to-top contrast: bright azure top ambient vs rich cobalt-slate bases
    vec3 skyTopAmb = mix(vec3(0.022, 0.038, 0.078), vec3(0.42, 0.56, 0.80), dayFactor);
    vec3 skyBaseAmb = mix(vec3(0.009, 0.016, 0.038), vec3(0.16, 0.23, 0.38), dayFactor);

    // Warm sunset underside bounce
    vec3 sunsetUnderside = vec3(0.92, 0.36, 0.18) * (0.45 + 0.55 * clamp(dot(dir, sunDir) * 0.5 + 0.5, 0.0, 1.0));
    skyBaseAmb = mix(skyBaseAmb, sunsetUnderside, sunsetFactor * 0.82 * (1.0 - stormFactor * 0.70));

    // Night emerald aurora bounce illuminating cloud undersides on clear nights
    skyBaseAmb += vec3(0.022, 0.088, 0.064) * nightFactor * (1.0 - stormFactor * 0.85);

    // Moody storm cloud deck darkening
    vec3 stormTop = vec3(0.20, 0.24, 0.30) * mix(0.16, 1.0, dayFactor);
    vec3 stormBottom = vec3(0.06, 0.08, 0.12) * mix(0.16, 1.0, dayFactor);
    skyTopAmb = mix(skyTopAmb, stormTop, stormFactor * 0.82);
    skyBaseAmb = mix(skyBaseAmb, stormBottom, stormFactor * 0.86);

    float transmittance = 1.0;
    vec3 scatteredLight = vec3(0.0);
    float extinctionCoeff = mix(0.046, 0.060, stormFactor);
    float rayJitter = fract(52.9829189 * fract(dot(dir.xz * 256.0 + float(vsWorld.frameIndex & 63) * vec2(17.0, 31.0), vec2(0.06711056, 0.00583715))));

    for (int i = 0; i < PRIMARY_STEPS; ++i) {
        if (transmittance < 0.02) break;
        float t = tEnter + (float(i) + rayJitter) * stepSize;
        vec3 pos = cameraPos + dir * t;
        float density = os_sampleCumulusDensity(pos, sky, cloudBottom, cloudTop, biomeCloudScale, stormFactor);
        if (density > 0.002) {
            float d1 = os_sampleCumulusDensity(pos + lightDir * 14.0, sky, cloudBottom, cloudTop, biomeCloudScale, stormFactor);
            float d2 = os_sampleCumulusDensity(pos + lightDir * 36.0, sky, cloudBottom, cloudTop, biomeCloudScale, stormFactor);
            float opticalDepth = (d1 * 14.0 + d2 * 22.0) * extinctionCoeff;

            // Multi-octave Beer-Lambert multiple scattering + Beer-Powder sugar-edge response
            float beerOct0 = exp(-opticalDepth);
            float beerOct1 = exp(-opticalDepth * 0.28) * 0.46;
            float beerOct2 = exp(-opticalDepth * 0.09) * 0.18;
            float multiScatter = max(beerOct0, beerOct1 + beerOct2);
            float powder = 1.0 - exp(-opticalDepth * 2.3);
            float powderMix = mix(1.0, 0.62 + 1.48 * powder, clamp(0.55 - 0.45 * cosTheta, 0.0, 1.0));
            float lightEnergy = multiScatter * powderMix;

            float hNorm = clamp((pos.y - cloudBottom) / max(cloudTop - cloudBottom, 1.0), 0.0, 1.0);
            vec3 stepAmbient = mix(skyBaseAmb, skyTopAmb, smoothstep(0.04, 0.88, hNorm));
            vec3 stepDirect = directColor * lightEnergy * (0.42 + 2.05 * phase);
            vec3 luminance = stepAmbient + stepDirect;

            float sigmaE = density * extinctionCoeff;
            float stepTrans = exp(-sigmaE * stepSize);
            scatteredLight += transmittance * luminance * (1.0 - stepTrans);
            transmittance *= stepTrans;
        }
    }

    // --- LAYER 2: HIGH WINDSWEPT CIRRUS VEIL (y = 540) ---
    if (dir.y > 0.05 && cameraPos.y < 520.0 && transmittance > 0.06) {
        float tCirrus = (540.0 - cameraPos.y) / max(dir.y, 0.05);
        vec3 cWorld = cameraPos + dir * min(tCirrus, 4600.0);
        vec3 cShear = cWorld * vec3(0.00062, 0.0, 0.00205)
            + vec3(sky.gameTimeSec * 0.0068, 0.0, sky.gameTimeSec * 0.0020);
        float warp = os_cloudNoise3D(cShear * 1.45);
        vec3 cWarped = cShear + vec3(warp * 0.62, 0.0, -warp * 0.36);
        float cMain = os_cloudNoise3D(cWarped) * 0.58 + os_cloudNoise3D(cWarped * 2.7 + vec3(3.1, 0.0, 1.7)) * 0.42;
        float cirrus = smoothstep(0.50, 0.84, cMain);
        float cirrusAlpha = cirrus * 0.34 * smoothstep(0.05, 0.20, dir.y) * (1.0 - stormFactor * 0.65);

        vec3 cirrusDirect = mix(directColor, vec3(1.38, 0.64, 0.34), sunsetFactor * 0.58);
        vec3 cirrusAmb = skyTopAmb * 1.25 + vec3(0.018, 0.072, 0.054) * nightFactor * (1.0 - stormFactor * 0.85);
        vec3 cirrusCol = mix(cirrusAmb, cirrusDirect * (0.80 + 0.78 * phase), 0.66);
        scatteredLight += transmittance * cirrusCol * cirrusAlpha;
        transmittance *= (1.0 - cirrusAlpha * 0.50);
    }

    float horizonFade = smoothstep(0.015, 0.15, abs(dir.y)) * (1.0 - smoothstep(1020.0, 2550.0, tEnter));
    float finalAlpha = mix(1.0, transmittance, horizonFade);
    vec3 finalScattering = scatteredLight * horizonFade;

    return vec4(max(finalScattering, vec3(0.0)), clamp(finalAlpha, 0.0, 1.0));
}
