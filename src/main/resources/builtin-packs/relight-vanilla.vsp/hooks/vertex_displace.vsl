#include <vulkanshaders/v1/common.vsl>
#include <vulkanshaders/v1/wind_common.vsl>

// @hook(stage = "vertex_displace", priority = 100)
// ReLight Vanilla - Chunk-periodic aerodynamic foliage and grass wind animation.
// The compute pass owns wind displacement when active; raster must not double-apply it.
void sv_vertex_displace(inout vec3 localPos, in VsVertexInput v) {
#if defined(VS_WIND_COMPUTE_ACTIVE) && (VS_WIND_COMPUTE_ACTIVE == 1)
    return;
#endif
    if (!VS_SPEC_ENABLE_WIND || (v.materialFlags & 1u) == 0u) {
        return;
    }

    float timeSec = vsWorld.gameTimeSec;
    float rain = clamp(vsWorld.rain, 0.0, 1.0);
    float thunder = clamp(vsWorld.thunder, 0.0, 1.0);
    float storm = clamp(rain * 0.72 + thunder * 0.55, 0.0, 1.25);

    // `v` may be the minimal raster prelude struct (only materialFlags) or the full
    // VsVertexInput; the shared helper takes explicit scalars so both forms compile.
    localPos = vsApplyWindDisplacement(localPos, v.materialFlags, timeSec, storm);
}
