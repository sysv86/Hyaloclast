#include <vulkanshaders/v1/common.vsl>

// World-space 3D value noise for subtle lava thermal convection and micro-normal relief.
// Preserves the vanilla lava texture completely while adding seamless world-space thermal motion.
float sv_lavaHash(vec3 p) {
    p = fract(p * 0.1031);
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
}

float sv_lavaNoise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float n00 = mix(sv_lavaHash(i + vec3(0.0, 0.0, 0.0)), sv_lavaHash(i + vec3(1.0, 0.0, 0.0)), f.x);
    float n10 = mix(sv_lavaHash(i + vec3(0.0, 1.0, 0.0)), sv_lavaHash(i + vec3(1.0, 1.0, 0.0)), f.x);
    float n01 = mix(sv_lavaHash(i + vec3(0.0, 0.0, 1.0)), sv_lavaHash(i + vec3(1.0, 0.0, 1.0)), f.x);
    float n11 = mix(sv_lavaHash(i + vec3(0.0, 1.0, 1.0)), sv_lavaHash(i + vec3(1.0, 1.0, 1.0)), f.x);
    return mix(mix(n00, n10, f.y), mix(n01, n11, f.y), f.z);
}

float sv_lavaConvection(vec3 p) {
    float broad = sv_lavaNoise(p);
    float fine = sv_lavaNoise(p * 2.25 + vec3(11.7, 4.3, 19.1));
    return broad * 0.65 + fine * 0.35;
}

// Compact silicate-melt Planckian blackbody tint (1100K..2800K) for thermal richness on vanilla lava
vec3 sv_lavaBlackbody(float kelvin) {
    float k = clamp(kelvin, 1000.0, 3200.0);
    vec3 c2 = vec3(20405.87, 24195.14, 30773.22);
    vec3 w = vec3(1.0, 1.7284, 5.0545);
    vec3 rad = w / max(exp(min(c2 / k, vec3(40.0))) - 1.0, vec3(1e-6));
    float peak = max(rad.r, max(rad.g, rad.b));
    return rad / max(peak, 1e-6);
}

// @hook(stage = "surface", priority = 100)
// ReLight Vanilla - Grounded vanilla-faithful LabPBR calibration across all 15 material IDs.
// Preserves authentic Minecraft textures (including vanilla lava pixel art) while elevating
// thermal emission, physical roughness/F0 contrast, crystal/foliage SSS, and micro-relief.
void sv_surface(inout VsSurface s, in vec3 worldPos, in uint flags, in uint bounce) {
    uint materialId = (flags >> 3u) & 15u;

    if (materialId == 1u) {
        // STONE / DEEPSLATE / BRICKS: matte mineral with subtle micro-sheen, never wet plastic
        s.roughness = clamp(s.roughness, 0.72, 0.88);
        s.f0 = min(s.f0, 0.038);
    } else if (materialId == 2u) {
        // DIRT / GRASS BLOCK / CLAY: dry porous earth
        s.roughness = clamp(s.roughness, 0.86, 0.95);
        s.f0 = min(s.f0, 0.028);
    } else if (materialId == 3u) {
        // WOOD / PLANKS / LOGS: natural warm satin timber
        s.roughness = clamp(s.roughness, 0.68, 0.84);
        s.f0 = min(s.f0, 0.034);
    } else if (materialId == 4u) {
        // FOLIAGE / LEAVES / CROPS / FLOWERS: luminous botanical translucency without waxy glare
        s.subsurface = max(s.subsurface, 0.74);
        s.roughness = clamp(s.roughness, 0.60, 0.78);
        s.f0 = min(s.f0, 0.030);
    } else if (materialId == 5u) {
        // SAND / GRAVEL: temper bright vanilla sand albedo while keeping warm sunlit grain
        s.albedo *= 0.84;
        s.roughness = clamp(s.roughness, 0.80, 0.92);
        s.f0 = min(s.f0, 0.036);
    } else if (materialId == 6u) {
        // METAL (iron, gold, copper, netherite, anvil, chain): crisp brushed conductor for RT reflections
        if (s.metallic < 0.1) {
            s.metallic = 0.88;
            s.roughness = clamp(s.roughness * 0.30, 0.09, 0.22);
            s.f0 = max(s.f0, 0.88);
        }
    } else if (materialId == 7u) {
        // GLASS / ICE: clear dielectric crystal with luminous glacial translucency on ice
        float iceLuma = dot(s.albedo, vec3(0.2126, 0.7152, 0.0722));
        float blueBias = smoothstep(0.02, 0.16, s.albedo.b - s.albedo.r);
        s.roughness = min(s.roughness, mix(0.04, 0.12, blueBias * iceLuma));
        s.f0 = max(s.f0, 0.048);
        s.subsurface = max(s.subsurface, blueBias * 0.45);
    } else if (materialId == 8u) {
        // WATER / FLUID FALLBACK: mirror-clean dielectric surface
        s.roughness = min(s.roughness, 0.045);
        s.f0 = 0.0204;
    } else if (materialId == 9u) {
        // LAVA: Vanilla-preserving thermal shader.
        // Keeps the authentic vanilla Minecraft lava texture intact in s.albedo and extracts its
        // molten veins vs. cooling crust directly from the vanilla texel luminance & chromaticity.
        vec3 vanillaTex = clamp(s.albedo, vec3(0.0), vec3(1.0));
        float texLuma = dot(vanillaTex, vec3(0.2126, 0.7152, 0.0722));
        float warmth = clamp((vanillaTex.r * 0.55 + vanillaTex.g * 0.95) - vanillaTex.b * 0.65, 0.0, 1.0);

        // Separate bright yellow-orange molten channels from darker cooled crust inside the vanilla sprite
        float vanillaMelt = smoothstep(0.11, 0.56, texLuma * 0.68 + warmth * 0.52);
        float vanillaHotCore = smoothstep(0.42, 0.82, texLuma * 0.55 + vanillaTex.g * 0.85);
        float vanillaCrust = 1.0 - vanillaMelt;
        // Incandescent fissure rim right along the vanilla crust-to-melt boundary
        float fissureRim = smoothstep(0.08, 0.42, vanillaMelt) * (1.0 - smoothstep(0.52, 0.88, vanillaMelt));

        // Subtle world-space convective swell (modulated by VS_PARAM_LAVA_FLOW_SPEED)
        float flow = clamp(VS_PARAM_LAVA_FLOW_SPEED, 0.0, 2.5);
        float t = mod(vsWorld.gameTimeSec * (0.45 + 0.55 * flow), 1024.0);
        vec3 q = worldPos * vec3(0.55, 0.40, 0.55) + vec3(sin(t * 0.21) * 0.45, t * 0.14, cos(t * 0.17) * 0.45);
        float convect = sv_lavaConvection(q);
        float thermalWave = 0.84 + 0.30 * convect + 0.08 * sin(t * 1.65 + convect * 6.28318);

        // Gentle normal relief so molten channels look viscous & glossy while crust stays volcanic matte
        float eps = 0.16;
        vec3 grad = vec3(
            sv_lavaConvection(q + vec3(eps, 0.0, 0.0)) - convect,
            0.0,
            sv_lavaConvection(q + vec3(0.0, 0.0, eps)) - convect
        ) / eps;
        vec3 tangentGrad = grad - s.normal * dot(grad, s.normal);
        float reliefAmp = 0.042 * (0.30 + 0.70 * vanillaMelt);
        vec3 perturbedN = s.normal - tangentGrad * reliefAmp;
        s.normal = (dot(perturbedN, perturbedN) > 1e-8) ? normalize(perturbedN) : s.normal;

        // Enrich vanilla lava colors with physical silicate blackbody warmth without erasing pixel art:
        // darker crust deepens slightly into rich volcanic basalt-crimson for silhouette contrast,
        // while hot molten veins retain vivid golden-orange incandescence that won't wash out to white.
        float kelvin = mix(1280.0, 2480.0, clamp(vanillaMelt * 0.72 + vanillaHotCore * 0.38, 0.0, 1.0))
                     * mix(0.92, 1.08, convect);
        vec3 bbTint = sv_lavaBlackbody(kelvin);
        vec3 enrichedVanilla = mix(
            vanillaTex * vec3(0.76, 0.62, 0.54),
            vanillaTex * mix(vec3(1.06, 0.94, 0.80), bbTint * 1.12, 0.32),
            vanillaMelt
        );
        // Subtle ember highlight along crust fissures
        enrichedVanilla += vec3(0.24, 0.06, 0.008) * (fissureRim * convect);
        s.albedo = clamp(enrichedVanilla, vec3(0.0), vec3(1.0));

        // Physically tiered emission: crust stays low so vanilla dark islands read crisply,
        // while molten channels & hot cores drive rich bloom and colored RT/ReSTIR bounce GI.
        float glow = clamp(VS_PARAM_LAVA_GLOW, 0.0, 2.5);
        float baseEmission = 0.20 * vanillaCrust
                           + (0.78 * vanillaMelt + 0.55 * fissureRim + 0.95 * vanillaHotCore) * thermalWave;
        s.emission = max(s.emission, baseEmission * glow);

        // Dual-phase lava material: matte volcanic crust (0.78) vs viscous glossy molten glass (0.16)
        s.roughness = mix(0.78, 0.16, clamp(vanillaMelt * 0.85 + vanillaHotCore * 0.25, 0.0, 1.0));
        s.roughness = mix(s.roughness, 0.10, fissureRim * 0.45);
        s.f0 = mix(0.036, 0.052, vanillaMelt);
        s.metallic = 0.0;
        s.subsurface = clamp(0.06 + 0.14 * vanillaMelt, 0.0, 0.22);
    } else if (materialId == 10u) {
        // MISCELLANEOUS OPAQUE / REDSTONE COMPONENTS: grounded matte finish
        s.roughness = clamp(s.roughness, 0.70, 0.88);
        s.f0 = min(s.f0, 0.038);
    } else if (materialId == 11u) {
        // WOOL / CARPET: soft matte woven textile
        s.roughness = clamp(s.roughness, 0.90, 0.98);
        s.f0 = min(s.f0, 0.022);
    } else if (materialId == 12u) {
        // GEM / CRYSTAL (diamond, emerald, amethyst, quartz, prismarine): luminous dielectric crystal
        if (s.metallic < 0.1) {
            s.f0 = clamp(s.f0, 0.085, 0.16);
            s.roughness = clamp(s.roughness, 0.06, 0.18);
            s.subsurface = max(s.subsurface, 0.24);
        }
    } else if (materialId == 13u) {
        // SNOW / HONEY / WAX / ORGANIC: soft subsurface scattering with crisp powdery sheen
        if (s.metallic < 0.1) {
            s.subsurface = max(s.subsurface, 0.44);
            s.roughness = clamp(s.roughness, 0.48, 0.74);
            s.f0 = clamp(s.f0, 0.032, 0.044);
        }
    } else if (materialId == 14u) {
        // POLISHED STONE / GLAZED TERRACOTTA / CERAMIC: refined satin-gloss mineral glaze
        if (s.metallic < 0.1) {
            s.roughness = clamp(s.roughness, 0.12, 0.28);
            s.f0 = clamp(s.f0, 0.055, 0.075);
        }
    } else if (materialId == 15u) {
        // SCULK / MAGICAL / ARCANE: dark satin arcane base ready for subtle pulsing veins
        if (s.metallic < 0.1) {
            s.roughness = clamp(s.roughness, 0.20, 0.38);
            s.f0 = max(s.f0, 0.062);
        }
    }

    // Flag-level overrides
    if ((flags & 1u) != 0u) {
        s.subsurface = max(s.subsurface, 0.58);
        s.roughness = clamp(s.roughness, 0.60, 0.78);
    }
    if ((flags & 2u) != 0u && materialId != 9u) {
        // Water fluid surface
        s.roughness = min(s.roughness, 0.045);
        s.f0 = 0.0204;
    }
    if ((flags & 4u) != 0u && materialId != 9u) {
        // Luminous emissive blocks for vibrant RT bounce GI while keeping dark lantern frames crisp
        float texLuma = dot(s.albedo, vec3(0.2126, 0.7152, 0.0722));
        float emitterMask = smoothstep(0.08, 0.54, texLuma);
        s.emission = max(s.emission, mix(0.22, 2.25, emitterMask));
        if (materialId == 15u) {
            float sculkPulse = 0.86 + 0.14 * sin(vsWorld.gameTimeSec * 2.1);
            s.emission *= sculkPulse;
        } else {
            s.roughness = max(s.roughness, 0.44);
        }
    }

    s.roughness = max(s.roughness, 0.02);
}
