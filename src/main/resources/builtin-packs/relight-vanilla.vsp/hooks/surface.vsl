#include <vulkanshaders/v1/common.vsl>

// World-space 3D value noise for the lava shader. No textures and no block-local terms,
// so neighbouring blocks share exactly the same crust/melt field.
float sv_lavaHash(vec3 p) {
    p = fract(p * 0.1031);
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
}

float sv_lavaNoise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float n00 = mix(sv_lavaHash(i + vec3(0.0, 0.0, 0.0)), sv_lavaHash(i + vec3(1.0, 0.0, 0.0)), f.x);
    float n10 = mix(sv_lavaHash(i + vec3(0.0, 1.0, 0.0)), sv_lavaHash(i + vec3(1.0, 1.0, 0.0)), f.x);
    float n01 = mix(sv_lavaHash(i + vec3(0.0, 0.0, 1.0)), sv_lavaHash(i + vec3(1.0, 0.0, 1.0)), f.x);
    float n11 = mix(sv_lavaHash(i + vec3(0.0, 1.0, 1.0)), sv_lavaHash(i + vec3(1.0, 1.0, 1.0)), f.x);
    return mix(mix(n00, n10, f.y), mix(n01, n11, f.y), f.z);
}

float sv_lavaField(vec3 p) {
    float broad = sv_lavaNoise(p);
    float fine = sv_lavaNoise(p * 2.37 + vec3(11.7, 4.3, 19.1));
    return broad * 0.66 + fine * 0.34;
}

// @hook(stage = "surface", priority = 100)
// Sunlit Vanilla - Grounded natural vanilla-faithful PBR calibration across all 15 material IDs.
// Preserves authentic Minecraft block identity without plastic glare while giving metals, crystals,
// foliage, snow/ice, ceramics, sculk, and emissives clean physical response.
void sv_surface(inout VsSurface s, in vec3 worldPos, in uint flags, in uint bounce) {
    uint materialId = (flags >> 3u) & 15u;

    if (materialId == 1u) {
        // STONE / DEEPSLATE / BRICKS: matte mineral with subtle micro-sheen, never wet plastic
        s.roughness = clamp(s.roughness, 0.72, 0.88);
        s.f0 = min(s.f0, 0.038);
    } else if (materialId == 2u) {
        // DIRT / GRASS BLOCK / CLAY: dry porous earth
        s.roughness = clamp(s.roughness, 0.86, 0.95);
        s.f0 = min(s.f0, 0.028);
    } else if (materialId == 3u) {
        // WOOD / PLANKS / LOGS: natural warm satin timber
        s.roughness = clamp(s.roughness, 0.68, 0.84);
        s.f0 = min(s.f0, 0.034);
    } else if (materialId == 4u) {
        // FOLIAGE / LEAVES / CROPS / FLOWERS: luminous botanical translucency without waxy glare
        s.subsurface = max(s.subsurface, 0.72);
        s.roughness = clamp(s.roughness, 0.62, 0.78);
        s.f0 = min(s.f0, 0.030);
    } else if (materialId == 5u) {
        // SAND / GRAVEL: temper bright vanilla sand albedo while keeping warm sunlit grain
        s.albedo *= 0.84;
        s.roughness = clamp(s.roughness, 0.80, 0.92);
        s.f0 = min(s.f0, 0.036);
    } else if (materialId == 6u) {
        // METAL (iron, gold, copper, netherite, anvil, chain): crisp brushed conductor for RT reflections
        if (s.metallic < 0.1) {
            s.metallic = 0.88;
            s.roughness = clamp(s.roughness * 0.30, 0.09, 0.22);
            s.f0 = max(s.f0, 0.88);
        }
    } else if (materialId == 7u) {
        // GLASS / ICE: clear dielectric crystal with luminous glacial translucency on ice
        float iceLuma = dot(s.albedo, vec3(0.2126, 0.7152, 0.0722));
        float blueBias = smoothstep(0.02, 0.16, s.albedo.b - s.albedo.r);
        s.roughness = min(s.roughness, mix(0.04, 0.12, blueBias * iceLuma));
        s.f0 = max(s.f0, 0.048);
        s.subsurface = max(s.subsurface, blueBias * 0.42);
    } else if (materialId == 8u) {
        // WATER / FLUID FALLBACK: mirror-clean dielectric surface
        s.roughness = min(s.roughness, 0.045);
        s.f0 = 0.02;
    } else if (materialId == 9u) {
        // LAVA: procedural world-space basaltic crust over convecting melt. The field depends
        // only on worldPos, so it never repeats at block boundaries like the vanilla sprite.
        float flow = clamp(VS_PARAM_LAVA_FLOW_SPEED, 0.0, 2.5);
        float t = vsWorld.gameTimeSec * flow;
        // Anisotropic world domain: elongated crust streaks read as flowing vanilla-style lava
        // instead of large round islands, and the Y drift advects vertical lavafalls downward.
        vec3 q = vec3(worldPos.x * 0.42, worldPos.y * 0.30, worldPos.z * 0.95)
               + vec3(sin(t * 0.17) * 0.55, t * 0.075, cos(t * 0.13) * 0.55);

        float field = sv_lavaField(q);
        float crust = smoothstep(0.56, 0.70, field);
        float melt = 1.0 - crust;

        // Thin incandescent fissures along the crust/melt transition.
        float ridge = clamp(1.0 - abs(field - 0.63) * 12.0, 0.0, 1.0);
        float cracks = smoothstep(0.50, 0.95, ridge) * (0.30 + 0.70 * melt);

        // Short-lived bubbles in the molten areas.
        float bubble = smoothstep(0.86, 0.96, sv_lavaNoise(q * 3.1 + vec3(0.0, t * 0.55, 0.0))) * melt;

        // Finite-difference relief projected onto the actual face, so horizontal lakes and
        // vertical lava flows both get a coherent, non-tiled normal.
        float e = 0.13;
        vec3 grad = vec3(sv_lavaField(q + vec3(e, 0.0, 0.0)) - field,
                         0.0,
                         sv_lavaField(q + vec3(0.0, 0.0, e)) - field) / e;
        vec3 tangentGrad = grad - s.normal * dot(grad, s.normal);
        float relief = 0.075 * (0.45 + 0.55 * melt);
        float shimmer = 0.022 * melt * sin(t * 2.4 + field * 15.0);
        s.normal = normalize(s.normal - tangentGrad * relief + vec3(shimmer, 0.0, -shimmer * 0.7));

        float heat = clamp(melt * 0.80 + cracks * 0.75 + bubble * 0.9, 0.0, 1.0);
        // Saturated red-orange like vanilla lava. Keeping these darker is essential: the engine
        // multiplies albedo * emission * ~2.0, and pale highlights get desaturated by tone mapping.
        vec3 basalt = vec3(0.140, 0.035, 0.018);
        vec3 dullRed = vec3(0.400, 0.055, 0.010);
        vec3 orange = vec3(0.820, 0.150, 0.008);
        vec3 yellow = vec3(1.000, 0.400, 0.045);
        vec3 col = mix(basalt, dullRed, smoothstep(0.03, 0.34, heat));
        col = mix(col, orange, smoothstep(0.30, 0.72, heat));
        col = mix(col, yellow, smoothstep(0.70, 0.98, heat));
        s.albedo = clamp(col, vec3(0.0), vec3(1.0));

        // The engine applies albedo * emission * ~2.0: molten areas reach bloom range while
        // crusted basalt stays nearly dark, which is what gives the crust its silhouette.
        float glow = clamp(VS_PARAM_LAVA_GLOW, 0.0, 2.5);
        float pulse = 0.88 + 0.12 * sin(t * 1.31 + field * 8.0);
        float emission = (0.30 * crust + (0.55 + 0.45 * cracks + 0.35 * bubble) * melt) * pulse * glow;
        s.emission = max(s.emission, emission);

        s.roughness = mix(0.84, 0.11, smoothstep(0.10, 0.85, heat));
        s.roughness = mix(s.roughness, 0.055, cracks * 0.55);
        s.f0 = 0.04;
        s.metallic = 0.0;
        s.subsurface = clamp(0.05 + 0.09 * melt, 0.0, 0.16);
    } else if (materialId == 10u) {
        // MISCELLANEOUS OPAQUE / REDSTONE COMPONENTS: grounded matte finish
        s.roughness = clamp(s.roughness, 0.70, 0.88);
        s.f0 = min(s.f0, 0.038);
    } else if (materialId == 11u) {
        // WOOL / CARPET: soft matte woven textile
        s.roughness = clamp(s.roughness, 0.90, 0.98);
        s.f0 = min(s.f0, 0.022);
    } else if (materialId == 12u) {
        // GEM / CRYSTAL (diamond, emerald, amethyst, quartz, prismarine): luminous dielectric crystal
        if (s.metallic < 0.1) {
            s.f0 = clamp(s.f0, 0.085, 0.16);
            s.roughness = clamp(s.roughness, 0.06, 0.18);
            s.subsurface = max(s.subsurface, 0.22);
        }
    } else if (materialId == 13u) {
        // SNOW / HONEY / WAX / ORGANIC: soft subsurface scattering with crisp powdery sheen
        if (s.metallic < 0.1) {
            s.subsurface = max(s.subsurface, 0.42);
            s.roughness = clamp(s.roughness, 0.48, 0.74);
            s.f0 = clamp(s.f0, 0.032, 0.044);
        }
    } else if (materialId == 14u) {
        // POLISHED STONE / GLAZED TERRACOTTA / CERAMIC: refined satin-gloss mineral glaze
        if (s.metallic < 0.1) {
            s.roughness = clamp(s.roughness, 0.12, 0.28);
            s.f0 = clamp(s.f0, 0.055, 0.075);
        }
    } else if (materialId == 15u) {
        // SCULK / MAGICAL / ARCANE: dark satin arcane base ready for subtle pulsing veins
        if (s.metallic < 0.1) {
            s.roughness = clamp(s.roughness, 0.20, 0.38);
            s.f0 = max(s.f0, 0.062);
        }
    }

    // Flag-level overrides
    if ((flags & 1u) != 0u) {
        s.subsurface = max(s.subsurface, 0.56);
        s.roughness = clamp(s.roughness, 0.62, 0.78);
    }
    if ((flags & 2u) != 0u && materialId != 9u) {
        // Water fluid surface
        s.roughness = min(s.roughness, 0.045);
        s.f0 = 0.02;
    }
    if ((flags & 4u) != 0u && materialId != 9u) {
        // Luminous emissive blocks for vibrant RT bounce GI while keeping dark lantern frames crisp
        float texLuma = dot(s.albedo, vec3(0.2126, 0.7152, 0.0722));
        float emitterMask = smoothstep(0.08, 0.54, texLuma);
        s.emission = max(s.emission, mix(0.22, 2.15, emitterMask));
        if (materialId == 15u) {
            float sculkPulse = 0.88 + 0.12 * sin(vsWorld.gameTimeSec * 2.1);
            s.emission *= sculkPulse;
        } else {
            s.roughness = max(s.roughness, 0.44);
        }
    }

    s.roughness = max(s.roughness, 0.02);
}
