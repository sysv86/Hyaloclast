#include <vulkanshaders/v1/common.vsl>

// Engine-provided multi-entity water interaction ring buffer (mobs, boats, items, player trail).
// The hook linker emits this declaration verbatim: the struct name is Vs-prefixed and the
// layout-qualified buffer line is ignored by its top-level symbol collector.
#ifdef VS_HAS_WATER_INTERACTION_BUFFER
struct VsWaterRippleEvent {
    vec4 posTime;
    vec4 velRadius;
};
layout(set = 1, binding = 5, std430) buffer WaterInteractionSSBO {
    uvec4 header;
    VsWaterRippleEvent events[64];
} uWaterRipples;
#endif

float sv_waterHash21(vec2 p) {
    p = mod(p, 256.0);
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

vec2 sv_waterRot2(vec2 v, float c, float s) {
    return vec2(c * v.x - s * v.y, s * v.x + c * v.y);
}

// Large-scale wind-gust / wave-group envelope traveling at group speed
// so calm oceans show organic glassy slicks and rippled wind patches
float sv_waterGroupEnvelope(vec2 p, float t, float rain) {
    const float TAU = 6.28318530718;
    float a1 = mod(p.x * 0.19 + p.y * 0.11, TAU) - mod(t * 0.24, TAU);
    float a2 = mod(-p.x * 0.09 + p.y * 0.16, TAU) - mod(t * 0.17, TAU);
    float env = 0.96 + 0.17 * sin(a1) + 0.11 * sin(a2);
    return clamp(env, 0.72 + 0.12 * rain, 1.24);
}

// Accumulates a single 2nd-order Stokes wave octave with exact analytical derivative,
// Gaussian Nyquist anti-aliasing, and Bruneton-Neyret unresolved slope-variance tracking.
void sv_waterAccumWave(
    vec2 p,
    vec2 dir,
    float k,
    float omega,
    float baseAmp,
    float steepness,
    float timeSec,
    float phaseOffset,
    float sigmaFilter,
    float macroCalm,
    float groupMod,
    float rainBoost,
    float ampScale,
    inout float height,
    inout vec2 grad,
    inout float unresolvedVar
) {
    const float TAU = 6.28318530718;
    float x = k * sigmaFilter;
    float w = exp(-0.5 * x * x) * macroCalm;

    // Conservation of microfacet slope variance when high frequencies filter out
    float fullSlope = baseAmp * rainBoost * k * ampScale;
    unresolvedVar += 0.5 * fullSlope * fullSlope * max(1.0 - w * w, 0.0);

    if (w < 0.004) {
        return;
    }

    float phasePos = mod(dot(p, dir) * k, TAU);
    float phaseTime = mod(timeSec * omega, TAU);
    float phi = phasePos - phaseTime + phaseOffset;
    float s = sin(phi);
    float c = cos(phi);

    float a = baseAmp * rainBoost * groupMod * w;
    // 2nd-order Stokes elevation: sin(phi) - 0.5 * eps * cos(2*phi) = sin(phi) + 0.5 * eps * (1 - 2*cos^2(phi))
    height += a * (s + 0.5 * steepness * (1.0 - 2.0 * c * c));
    // Exact derivative w.r.t. phi: cos(phi) * (1 + 2 * eps * sin(phi))
    float dh = a * k * c * (1.0 + 2.0 * steepness * s);
    grad += dir * dh;
}

// Physically bounded capillary-gravity raindrop wave packet with dual-ring wave train
// and fresh-impact crown-splash mask (returned in .z) for visible rainy-surface micro-splashes.
vec3 sv_waterRainPacket(vec2 p, float timeSec, float rate, float rainDensity) {
    vec2 cell = floor(p);
    vec2 local = fract(p) - 0.5;

    float cellSeed = sv_waterHash21(cell);
    float cycleTime = timeSec * rate + cellSeed;
    float cycle = mod(floor(cycleTime), 256.0);
    float age = fract(cycleTime);

    float dropSeed = sv_waterHash21(cell + vec2(cycle * 13.37, cycle * 7.19));
    float threshold = 1.0 - rainDensity * 0.94;
    float dropActive = smoothstep(threshold, threshold + 0.10, dropSeed);
    if (dropActive <= 0.001) {
        return vec3(0.0);
    }

    vec2 center = (vec2(fract(dropSeed * 19.31), fract(dropSeed * 37.73)) - 0.5) * 0.38;
    vec2 d = local - center;
    float dist = length(d);

    // Sublinear expansion r(t) ~ t^0.75 via fast nested sqrt
    float radius = 0.014 + 0.275 * sqrt(age * sqrt(age));
    float ring1 = dist - radius;
    float ring2 = dist - radius * 0.66;

    float edgeMask = 1.0 - smoothstep(0.38, 0.495, max(abs(local.x), abs(local.y)));
    float centerMask = smoothstep(0.0, 0.020, dist);
    float attack = smoothstep(0.0, 0.045, age);

    // Primary gravity-capillary ring + secondary trailing capillary ripple
    float env1 = exp(-ring1 * ring1 * 185.0) * exp(-age * 2.0) * (1.0 - age) * attack
               * inversesqrt(radius + 0.12);
    float env2 = exp(-ring2 * ring2 * 260.0) * exp(-age * 2.5) * (1.0 - age) * attack * 0.55
               * inversesqrt(radius * 0.66 + 0.12);

    float deriv = (sin(ring1 * 56.0) * env1 + sin(ring2 * 74.0) * env2) * edgeMask * centerMask * dropActive;
    vec2 grad = (dist > 1e-4) ? (d / dist) * deriv : vec2(0.0);

    // Fresh impact crown-splash highlight right at the center for the first ~14% of the cycle
    float splashAge = smoothstep(0.0, 0.03, age) * (1.0 - smoothstep(0.05, 0.16, age));
    float splashRing = exp(-abs(dist - 0.022 - age * 0.18) * 65.0) * splashAge * edgeMask * dropActive;
    return vec3(grad, splashRing);
}

// Live player swimming & wading interactive water wake (concentric treading ripples + Kelvin V-wake).
// Uses real camera position, per-frame cameraDelta velocity, and eyeInFluid from WorldUBO.
// Returns vec3(slopeX, slopeZ, wakeFoam).
vec3 sv_waterPlayerInteraction(
    vec3 worldPos,
    vec3 camPos,
    float eyeInWater,
    float timeSec,
    float sigmaFilter
) {
    const float TAU = 6.28318530718;

    // Multi-entity / mob / boat / item wakes are independent of the local-player gates below,
    // so they are accumulated first and returned even when the player is nowhere near water.
    vec3 interactionEvents = vec3(0.0);
#ifdef VS_HAS_WATER_INTERACTION_BUFFER
    float eventFilterAtten = exp(-0.5 * (7.5 * sigmaFilter) * (7.5 * sigmaFilter));
    if (eventFilterAtten >= 0.02) {
        uint rippleCount = min(uWaterRipples.header.x, 64u);
        for (uint i = 0u; i < rippleCount; ++i) {
            VsWaterRippleEvent ripple = uWaterRipples.events[i];
            vec3 ripplePos = ripple.posTime.xyz;
            float rippleAge = clamp(vsWorld.gameTimeSec - ripple.posTime.w, 0.0, 4.0);
            vec2 rippleDelta = worldPos.xz - ripplePos.xz;
            float rippleR = length(rippleDelta);
            float rippleCamDist = length(ripplePos.xz - camPos.xz);
            if (rippleAge >= 4.0 || rippleCamDist > 24.0 || rippleR > 12.0) {
                continue;
            }

            float rippleStrength = clamp(ripple.velRadius.w, 0.0, 1.5);
            vec2 rippleVelXZ = ripple.velRadius.xz;
            float rippleVelMag = length(rippleVelXZ);
            float ringRadius = rippleStrength * 0.35 + rippleAge * (1.1 + 0.30 * min(rippleVelMag, 4.0));
            float ring = rippleR - ringRadius;
            float rippleDy = worldPos.y - ripplePos.y;
            float rippleHeightFade = exp(-rippleDy * rippleDy * 0.55);
            float rippleCamFade = 1.0 - smoothstep(12.0, 24.0, rippleCamDist);
            float rippleLife = (1.0 - 0.25 * rippleAge) * exp(-rippleAge * 1.6);
            float ringEnv = exp(-ring * ring * 3.2) * rippleLife * inversesqrt(rippleR + 0.5)
                          * rippleHeightFade * rippleCamFade * eventFilterAtten;
            float rippleAmp = clamp(rippleStrength * ringEnv, 0.0, 1.0);

            vec2 rippleDir = (rippleR > 1e-4) ? (rippleDelta / rippleR) : vec2(0.0);
            interactionEvents.xy += rippleDir * (sin(ring * 7.0) * rippleAmp * 0.30);
            interactionEvents.z += ringEnv * (0.45 + 0.55 * max(sin(ring * 7.0), 0.0)) * 0.16;

            if (rippleVelMag > 0.15) {
                vec2 rippleFwd = rippleVelXZ / max(rippleVelMag, 1e-4);
                vec2 rippleRight = sv_waterRot2(rippleFwd, 0.0, 1.0);
                float behind = -dot(rippleDelta, rippleFwd);
                if (behind > 0.10 && behind < 5.0) {
                    float lateral = abs(dot(rippleDelta, rippleRight));
                    float armDist = abs(lateral - behind * 0.34 - 0.18);
                    float wakeEnv = exp(-armDist * armDist * 9.5) * exp(-behind * 0.45)
                                  * smoothstep(0.10, 0.45, behind) * (1.0 - 0.25 * rippleAge)
                                  * rippleStrength * rippleHeightFade * rippleCamFade * eventFilterAtten;
                    float wakePhase = armDist * 15.0 + behind * 4.5 - mod(vsWorld.gameTimeSec * 7.0, TAU);
                    vec2 wakeDir = normalize(rippleRight * sign(dot(rippleDelta, rippleRight) + 1e-5)
                                             - rippleFwd * 0.34);
                    interactionEvents.xy += wakeDir * (cos(wakePhase) * clamp(wakeEnv, 0.0, 1.0) * 0.20);
                    interactionEvents.z += clamp(wakeEnv, 0.0, 1.0) * 0.12;
                }
            }
        }
    }
    interactionEvents.z = clamp(interactionEvents.z, 0.0, 0.45);
#endif

    // Approximate player torso/feet plane relative to camera eye height (~1.62m standing, ~0.4m swimming)
    float bodyWaterY = (eyeInWater > 0.5) ? (camPos.y + 0.15) : (camPos.y - 1.38);
    float vertDist = abs(worldPos.y - bodyWaterY);
    float vertProx = exp(-vertDist * vertDist * 0.55);
    if (vertProx < 0.02) {
        return interactionEvents;
    }

    vec2 relXZ = worldPos.xz - camPos.xz;
    float r = length(relXZ);
    if (r > 7.5 || r < 0.08) {
        return interactionEvents;
    }

    float filterAtten = exp(-0.5 * (7.5 * sigmaFilter) * (7.5 * sigmaFilter));
    if (filterAtten < 0.02) {
        return interactionEvents;
    }

    vec2 radDir = relXZ / r;
    vec2 velXZ = vsWorld.cameraDelta.xz;
    float speed = length(velXZ);
    // Normalize frame displacement (~0.07 blocks/frame walking, ~0.12+ sprinting/swimming at 60 FPS)
    float moveEnergy = clamp(speed * 14.0, 0.0, 1.35);
    float swimPresence = clamp(eyeInWater * 0.85 + (1.0 - smoothstep(0.35, 1.65, vertDist)) * 0.70, 0.0, 1.0);
    float activity = clamp(swimPresence * (0.28 + 0.92 * moveEnergy), 0.0, 1.35);
    if (activity < 0.03) {
        return interactionEvents;
    }

    // 1. Outward dispersive concentric ripples from treading/swimming/wading
    float radialDecay = exp(-r * 0.58) * inversesqrt(r + 0.25) * smoothstep(0.10, 0.45, r);
    float phi1 = r * 8.4 - mod(timeSec * 6.8, TAU);
    float phi2 = r * 14.2 - mod(timeSec * 9.6, TAU) + 1.4;
    float rippleDeriv = (cos(phi1) * 0.65 + cos(phi2) * 0.35) * radialDecay * activity;
    vec2 slope = radDir * (rippleDeriv * 0.24);
    float foam = smoothstep(0.35, 0.95, sin(phi1) * 0.5 + 0.5) * exp(-r * 1.15) * activity * 0.22;

    // 2. Classic Kelvin V-wake (half-angle ~19.47 deg -> tan(19.47 deg) ~= 0.353) trailing behind motion
    if (moveEnergy > 0.12) {
        vec2 fwd = velXZ / max(speed, 1e-5);
        vec2 right = vec2(-fwd.y, fwd.x);
        float behind = -dot(relXZ, fwd);
        float lateral = abs(dot(relXZ, right));
        if (behind > 0.10 && behind < 6.5) {
            float armLine = behind * 0.36 + 0.22;
            float armDist = abs(lateral - armLine);
            float armEnv = exp(-armDist * armDist * 9.5) * exp(-behind * 0.42) * smoothstep(0.10, 0.55, behind);
            float kelvinPhase = (lateral - armLine) * 16.5 + behind * 5.2 - mod(timeSec * 8.5, TAU);
            float wakeWave = cos(kelvinPhase) * armEnv * moveEnergy;
            vec2 wakeNormalDir = normalize(right * sign(dot(relXZ, right) + 1e-5) - fwd * 0.36);
            slope += wakeNormalDir * (wakeWave * 0.28);
            foam += armEnv * (0.45 + 0.55 * max(sin(kelvinPhase), 0.0)) * moveEnergy * 0.34;
        }
    }

    float scale = vertProx * filterAtten;
    return vec3(slope * scale + interactionEvents.x, clamp(foam * scale + interactionEvents.y, 0.0, 0.45));
}

// Thunderstorm lightning strike shockwave & ionized specular flash on water.
// Synchronized with sv_cloudStormLightning storm cells using vsWorld.thunder & vsWorld.gameTimeSec.
// Returns vec3(slopeX, slopeZ, electroFlash).
vec3 sv_waterLightningShockwave(
    vec2 worldXZ,
    float timeSec,
    float thunder,
    float sigmaFilter
) {
    if (thunder <= 0.08) {
        return vec3(0.0);
    }

    vec2 slope = vec2(0.0);
    float electroFlash = 0.0;

    // Exact real-time EntityTypes.LIGHTNING_BOLT strike impact position & timestamp.
    // A negative timestamp means no active strike and produces no shockwave or flash.
#ifdef VS_HAS_LIGHTNING_STRIKE_UBO
    vec2 exactDelta = worldXZ - vsWorld.lightningStrikePosTime.xz;
    float exactAge = timeSec - vsWorld.lightningStrikePosTime.w;
    if (vsWorld.lightningStrikePosTime.w >= 0.0 && exactAge >= 0.0 && exactAge < 3.5) {
        float exactR = length(exactDelta);
        float shockR = 0.4 + exactAge * 6.5;
        float ring = exactR - shockR;
        float env = exp(-ring * ring * 1.8) * exp(-exactAge * 1.15) * inversesqrt(exactR + 0.5);
        slope += ((exactR > 1e-3) ? (exactDelta / exactR) : vec2(0.0)) * (sin(ring * 7.5) * env * 0.38);
        electroFlash += exp(-exactAge * 7.0) * exp(-exactR * 0.045);
    }
#endif

    // Deterministic storm-cell strike synchronization (live today with vsWorld.thunder):
    // Matches the cell grid & discharge rhythm of clouds.vsl so sky flashes trigger real water shockwaves.
    vec2 cell = floor(worldXZ * 0.045);
    vec2 local = fract(worldXZ * 0.045) - 0.5;
    float cellSeed = sv_waterHash21(cell);
    float cycle = timeSec * 0.38 + cellSeed * 11.0;
    float slot = mod(floor(cycle), 256.0);
    float localT = fract(cycle);
    float pick = sv_waterHash21(cell + vec2(slot * 7.13, 3.71));
    float gate = smoothstep(0.88 - 0.08 * thunder, 0.97, pick) * smoothstep(0.08, 0.75, thunder);

    if (gate > 0.002) {
        vec2 strikeLocal = (vec2(fract(pick * 23.1), fract(pick * 41.7)) - 0.5) * 0.42;
        vec2 d = (local - strikeLocal) / 0.045;
        float r = length(d);
        float shockRadius = 0.35 + localT * 11.5;
        float ring = r - shockRadius;
        float filterW = exp(-0.5 * (6.0 * sigmaFilter) * (6.0 * sigmaFilter));
        float env = exp(-ring * ring * 1.15) * exp(-localT * 2.2) * smoothstep(0.0, 0.04, localT)
                  * inversesqrt(r + 0.65) * gate * filterW;
        if (r > 1e-3) {
            slope += (d / r) * (sin(ring * 6.2) * env * 0.30);
        }
        // Double-peak ionized flash synchronized with cloud discharge
        float f1 = exp(-abs(localT - 0.14) * 14.0);
        float f2 = exp(-abs(localT - 0.28) * 18.0) * 0.65;
        electroFlash += (f1 + f2) * smoothstep(0.0, 0.03, localT) * exp(-r * 0.06) * gate;
    }

    return vec3(slope, clamp(electroFlash, 0.0, 1.2));
}

// Smooth lacy micro-aeration pattern for storm whitecaps and waterfall streaks
float sv_waterFoamLace(vec2 p, float timeSec) {
    const float TAU = 6.28318530718;
    float t1 = mod(timeSec * 0.45, TAU);
    float t2 = mod(timeSec * 0.68, TAU);
    float a1 = mod(p.x * 2.7 + p.y * 1.9, TAU) - t1;
    float a2 = mod(p.x * 1.6 - p.y * 3.1, TAU) + t2;
    float a3 = mod(p.x * 5.3 - p.y * 4.1, TAU) + t2;
    float a4 = mod(p.x * 4.4 + p.y * 5.7, TAU) - t1;
    float n1 = sin(a1) * cos(a2);
    float n2 = sin(a3) * cos(a4);
    return clamp(0.55 + 0.35 * n1 + 0.22 * n2, 0.0, 1.0);
}

// Exact unpolarized water-to-air Fresnel (n = 1.333 -> 1.0, critical angle 48.61 deg)
// mapped to effective Schlick F0 so Snell's window and Total Internal Reflection work cleanly
float sv_waterInternalF0(float cosThetaI) {
    const float N_WATER = 1.333;
    float mu = clamp(cosThetaI, 0.0, 1.0);
    float sin2T = (N_WATER * N_WATER) * (1.0 - mu * mu);

    float R = 1.0;
    if (sin2T < 1.0) {
        float cosT = sqrt(max(1.0 - sin2T, 0.0));
        float rs = (N_WATER * mu - cosT) / max(N_WATER * mu + cosT, 1e-5);
        float rp = (mu - N_WATER * cosT) / max(mu + N_WATER * cosT, 1e-5);
        R = 0.5 * (rs * rs + rp * rp);
    }

    float om = 1.0 - mu;
    float s5 = om * om * om * om * om;
    float f0 = (R - s5) / max(1.0 - s5, 1e-4);
    return clamp(f0, 0.0204, 0.96);
}

// @hook(stage = "water_surface", priority = 100)
// ReLight Vanilla - Physically grounded dispersive Stokes waves, Bruneton-Neyret normal-to-roughness
// anti-aliasing, live player swimming/wading Kelvin wakes, dual-ring capillary raindrop impacts,
// thunderstorm lightning shockwaves, biome-preserving Beer-Lambert tinting, and Snell's window TIR.
void sv_water_surface(inout VsSurface s, in vec3 worldPos, in float waveHeight) {
    const float WATER_F0 = 0.0204;

    float rain = clamp(vsWorld.rain, 0.0, 1.0);
    float thunder = clamp(vsWorld.thunder, 0.0, 1.0);
    float sea = clamp(rain * 0.72 + thunder * 0.52, 0.0, 1.25);

    float userStrength = clamp(VS_PARAM_WATER_WAVE_STRENGTH, 0.0, 1.0);
    float effStrength = userStrength / (1.0 + 0.35 * userStrength);
    float amp = effStrength * (0.195 + 0.150 * sea);

    vec3 camPos = uSharc.cfg.cameraPosition.xyz;
    vec3 toCam = camPos - worldPos;
    float camDist = length(toCam);
    vec3 viewDir = (camDist > 1e-4) ? (toCam / camDist) : vec3(0.0, 1.0, 0.0);

    // Safe scalar check across int/uint/float eyeInFluid (1 = water; excludes air=0 and lava=2)
    float eif = float(vsWorld.eyeInFluid);
    float eyeInWater = clamp(eif, 0.0, 1.0) * step(eif, 1.5);

    vec3 geomNormal = vsSafeNormalize(s.normal, vec3(0.0, 1.0, 0.0));
    bool isHorizontal = abs(geomNormal.y) > 0.5;
    bool isUnderwaterSnell = isHorizontal && (eyeInWater > 0.5) && (viewDir.y < 0.0);

    // Analytical perspective + grazing-foreshortening footprint (monotonic, derivative-free for RT/PT)
    float absMuGeom = isHorizontal ? abs(viewDir.y) : abs(dot(geomNormal, viewDir));
    float muFilter = max(absMuGeom, 0.10);
    float foreshorten = 1.0 + 0.55 * (inversesqrt(muFilter) - 1.0);
    float sigmaFilter = camDist * 0.00333 * foreshorten;
    float macroCalm = 1.0 - 0.60 * smoothstep(120.0, 400.0, camDist);

    float timeSec = vsWorld.gameTimeSec;
    float waveTime = timeSec * (1.0 + 0.18 * sea);

    vec3 baseAlbedo = clamp(s.albedo, vec3(0.0), vec3(1.0));
    // Infer optical clarity from biome water chromaticity (high for oceans/rivers, low for murky swamps)
    float clarity = clamp((baseAlbedo.b - baseAlbedo.r) / max(baseAlbedo.g + baseAlbedo.b, 0.05), 0.0, 1.0);

    if (isHorizontal) {
        vec2 p = worldPos.xz;
        float groupEnv = sv_waterGroupEnvelope(p, waveTime, rain);
        float swellMod = mix(1.0, groupEnv, 0.35);
        float steepScale = 0.85 + 0.30 * sea;

        float h = 0.0;
        vec2 grad = vec2(0.0);
        float unresolvedVar = 0.0;

        // Octaves 0-1: Primary wind-aligned gravity swells
        sv_waterAccumWave(p, vec2( 0.891007,  0.453990), 0.74, 1.078, 1.180, 0.24 * steepScale,
                          waveTime, 0.000, sigmaFilter, macroCalm, swellMod, 1.0 + 0.22 * sea, amp,
                          h, grad, unresolvedVar);
        sv_waterAccumWave(p, vec2( 0.990268,  0.139173), 1.59, 1.580, 0.464, 0.20 * steepScale,
                          waveTime, 1.713, sigmaFilter, macroCalm, swellMod, 1.0 + 0.35 * sea, amp,
                          h, grad, unresolvedVar);

        // Octaves 2-3: Crossing medium gravity chop with mild orbital advection from primary swells
        vec2 pMid = p + grad * (0.065 * macroCalm);
        sv_waterAccumWave(pMid, vec2( 0.500000,  0.866025), 3.17, 2.231, 0.200, 0.15 * steepScale,
                          waveTime, 3.426, sigmaFilter, macroCalm, groupEnv, 1.0 + 0.52 * sea, amp,
                          h, grad, unresolvedVar);
        sv_waterAccumWave(pMid, vec2( 0.939693, -0.342020), 5.75, 3.005, 0.097, 0.11 * steepScale,
                          waveTime, 5.139, sigmaFilter, macroCalm, groupEnv, 1.0 + 0.68 * sea, amp,
                          h, grad, unresolvedVar);

#ifdef VS_LIGHTING_MODE
#if VS_LIGHTING_MODE >= VS_MODE_COMPUTE
        // Octaves 4-5 (Tier 2+): Sub-block wind ripples for sharp ray-traced reflection micro-facets
        vec2 pFine = p + grad * (0.035 * macroCalm);
        sv_waterAccumWave(pFine, vec2( 0.121869,  0.992546), 9.85, 3.933, 0.050, 0.07 * steepScale,
                          waveTime, 0.852, sigmaFilter, macroCalm, groupEnv, 1.0 + 0.78 * sea, amp,
                          h, grad, unresolvedVar);
        sv_waterAccumWave(pFine, vec2( 0.656059, -0.754710), 15.90, 5.000, 0.028, 0.05 * steepScale,
                          waveTime, 2.565, sigmaFilter, macroCalm, groupEnv, 1.0 + 0.85 * sea, amp,
                          h, grad, unresolvedVar);
#endif
#if VS_LIGHTING_MODE >= VS_MODE_PATH
        // Octaves 6-7 (Tier 3 PT): Close-range micro-ripples (< ~20m) for path-traced refractions & glints
        sv_waterAccumWave(pFine, vec2(-0.422618,  0.906308), 23.40, 6.073, 0.0175, 0.0,
                          waveTime, 4.278, sigmaFilter, macroCalm, groupEnv, 1.0 + 0.88 * sea, amp,
                          h, grad, unresolvedVar);
        sv_waterAccumWave(pFine, vec2( 0.224951, -0.974370), 34.20, 7.358, 0.0110, 0.0,
                          waveTime, 5.991, sigmaFilter, macroCalm, groupEnv, 1.0 + 0.90 * sea, amp,
                          h, grad, unresolvedVar);
#endif
#endif

        vec2 slopeXZ = -grad * amp;
        float rainSplashFoam = 0.0;

        // 1. Raindrop impact rings & crown-splash micro-aeration
        // PLACEHOLDER HOOK: sky-exposure mask for covered caves/roofs (see PLACEHOLDERS_HANDOFF.md #3)
        float rainSkyExposure = 1.0;
#ifdef VS_HAS_WATER_SKY_EXPOSURE
        rainSkyExposure = smoothstep(0.45, 0.85, vsWaterSkyLight);
#endif
        if (rain > 0.02 && rainSkyExposure > 0.01) {
            float rainEnable = smoothstep(0.0, 0.08, max(userStrength, 0.12));
            float rainAmp = (0.165 + 0.065 * thunder) * rainEnable * (0.48 + 0.52 * rain) * rainSkyExposure;
            float rainFilter = exp(-0.5 * (13.0 * sigmaFilter) * (13.0 * sigmaFilter));
            unresolvedVar += 0.22 * rainAmp * rainAmp * max(1.0 - rainFilter * rainFilter, 0.0);

            if (rainFilter > 0.012 && rainEnable > 0.001) {
                vec2 pR1 = sv_waterRot2(p * 1.15, 0.80, -0.60);
                vec3 r1 = sv_waterRainPacket(pR1, timeSec, 1.12 + 0.28 * rain, rain);
                vec2 rWorld = sv_waterRot2(r1.xy, 0.80, 0.60);
                rainSplashFoam += r1.z;

                vec2 pR2 = sv_waterRot2(p * 1.67 + vec2(4.3, 7.1), 0.60, 0.80);
                vec3 r2 = sv_waterRainPacket(pR2, timeSec + 0.41, 1.34 + 0.30 * rain, rain);
                rWorld += sv_waterRot2(r2.xy, 0.60, -0.80) * 0.76;
                rainSplashFoam += r2.z * 0.72;

#ifdef VS_LIGHTING_MODE
#if VS_LIGHTING_MODE >= VS_MODE_COMPUTE
                float fineRainFilter = exp(-0.5 * (21.0 * sigmaFilter) * (21.0 * sigmaFilter));
                if (fineRainFilter > 0.02) {
                    vec2 pR3 = sv_waterRot2(p * 2.38 + vec2(9.2, 2.6), 0.96, -0.28);
                    vec3 r3 = sv_waterRainPacket(pR3, timeSec + 0.73, 1.58 + 0.34 * rain, rain);
                    rWorld += sv_waterRot2(r3.xy, 0.96, 0.28) * (0.54 * fineRainFilter / max(rainFilter, 0.015));
                    rainSplashFoam += r3.z * 0.45 * fineRainFilter;
                }
#endif
#endif

                float underScale = isUnderwaterSnell ? 0.65 : 1.0;
                slopeXZ += -rWorld * (rainAmp * rainFilter * underScale);
                rainSplashFoam = clamp(rainSplashFoam * rainFilter * rain * rainSkyExposure * 0.28, 0.0, 0.26);
            }
        }

        // 2. Live player swimming & wading Kelvin V-wake + concentric treading ripples
        vec3 playerWake = sv_waterPlayerInteraction(worldPos, camPos, eyeInWater, timeSec, sigmaFilter);
        slopeXZ += playerWake.xy * (isUnderwaterSnell ? 0.55 : 1.0);
        float wakeFoam = playerWake.z;

        // 3. Thunderstorm lightning shockwaves & ionized specular flash
        vec3 lightningFx = sv_waterLightningShockwave(p, timeSec, thunder, sigmaFilter);
        slopeXZ += lightningFx.xy * (isUnderwaterSnell ? 0.50 : 1.0);
        float lightningFlash = lightningFx.z;

        vec3 upNormal = vsSafeNormalize(vec3(slopeXZ.x, 1.0, slopeXZ.y), vec3(0.0, 1.0, 0.0));
        s.normal = upNormal * sign(geomNormal.y);

        // Refracted optical path length via Snell's law (n = 1.333)
        float muView = clamp(abs(dot(upNormal, viewDir)), 0.0, 1.0);
        float sin2I = max(1.0 - muView * muView, 0.0);
        float cosT = sqrt(max(1.0 - sin2I / (1.333 * 1.333), 0.18));
        float oblique = clamp((1.0 / cosT - 1.0) * 1.95, 0.0, 1.0);

        float combinedH = h + clamp(waveHeight * 2.2, -1.2, 1.2);
        float crest = clamp(combinedH * 0.34 + 0.48, 0.0, 1.0);
        float trough = clamp(0.50 - combinedH * 0.34, 0.0, 1.0);

        // Physical crest-steepness micro-foam + interactive player wake foam + raindrop splash sparkles
        float slopeMag = length(slopeXZ);
        float foamDrive = clamp(sea * 0.95 + max(userStrength - 0.55, 0.0) * 0.65, 0.0, 1.0);
        float foamBase = smoothstep(0.58, 0.92, crest) * smoothstep(0.11, 0.26, slopeMag) * foamDrive;
        float foamFade = 1.0 - smoothstep(12.0, 48.0, camDist);
        float foam = 0.0;
        if (foamBase > 0.002 && foamFade > 0.002) {
            float lace = sv_waterFoamLace(p + grad * 0.12, waveTime);
            foam = clamp(foamBase * lace * foamFade * 0.52, 0.0, 0.42);
        }
        foam = clamp(foam + wakeFoam + rainSplashFoam, 0.0, 0.62);

        // Biome-adaptive Beer-Lambert absorption (Pope-Fry clear spectrum vs CDOM/chlorophyll murky spectrum)
        vec3 sigmaClear = vec3(0.52, 0.14, 0.045);
        vec3 sigmaMurky = vec3(0.48, 0.28, 0.55);
        vec3 sigma = mix(sigmaMurky, sigmaClear, clarity);
        float optDepth = 0.25 + oblique * 2.10 + trough * 0.55;
        vec3 beer = exp(-sigma * optDepth);

        vec3 shallowCol = mix(baseAlbedo, vec3(0.035, 0.40, 0.54), 0.18 * clarity);
        vec3 deepCol = shallowCol * (0.45 + 0.55 * beer);
        vec3 col = mix(shallowCol, deepCol, 0.55 * oblique);

        // Subtle emerald-aqua forward scattering through thin wave crests
        vec3 crestTint = vec3(0.03, 0.36, 0.42) * clarity + baseAlbedo * (0.25 * (1.0 - clarity));
        col += crestTint * (crest * 0.22 * (1.0 - 0.45 * rain));

        if (isUnderwaterSnell) {
            float snellOpen = smoothstep(0.62, 0.78, muView);
            col = mix(col, vec3(0.06, 0.48, 0.64), 0.24 * clarity * snellOpen);
        }

        float colLum = vsLuminance(col);
        col = mix(col, vec3(colLum), 0.16 * rain);
        vec3 foamCol = vec3(0.82, 0.88, 0.92) * (1.0 - 0.14 * rain);
        s.albedo = clamp(mix(col, foamCol, foam), vec3(0.0), vec3(1.0));

        // Ionized ozone-blue sheen when lightning strikes nearby water
        if (lightningFlash > 0.01) {
            s.emission = max(s.emission, lightningFlash * (0.35 + 0.65 * clamp(slopeMag * 3.0, 0.0, 1.0)));
            s.albedo = clamp(mix(s.albedo, vec3(0.68, 0.84, 1.00), clamp(lightningFlash * 0.42, 0.0, 0.48)), vec3(0.0), vec3(1.0));
        }

        // Bruneton-Neyret roughness from unresolved slope variance + tier-tuned specular floor
        float baseRough = 0.010;
        float sssTierBoost = 1.0;
#ifdef VS_LIGHTING_MODE
#if VS_LIGHTING_MODE >= VS_MODE_PATH
        baseRough = 0.006;
        sssTierBoost = 1.25;
#elif VS_LIGHTING_MODE >= VS_MODE_HYBRID
        baseRough = 0.008;
        sssTierBoost = 1.10;
#endif
#endif
        float rough = sqrt(baseRough * baseRough + 0.14 * unresolvedVar);
        rough = mix(rough, 0.36, foam);
        if (isUnderwaterSnell) {
            rough *= mix(0.85, 1.0, smoothstep(0.62, 0.78, muView));
        }
        s.roughness = clamp(rough, 0.005, 0.55);

        s.f0 = isUnderwaterSnell ? sv_waterInternalF0(muView) : WATER_F0;
        s.metallic = 0.0;

        float sss = (0.06 + 0.26 * crest * crest)
                  * (0.35 + 0.65 * clarity)
                  * (1.0 - 0.50 * rain)
                  * sssTierBoost;
        s.subsurface = clamp(mix(sss, 0.10, foam), 0.0, 0.42);

        float troughAo = mix(0.92, 1.0, clamp(combinedH * 0.35 + 0.65, 0.0, 1.0));
        s.ao *= troughAo;
    } else {
        // Vertical flowing water / waterfall faces (seamless continuous world-space sheet)
        float fallSpeed = 1.0 + 0.16 * sea;

        vec3 kw1 = vec3( 3.325, 0.648,  2.312);
        vec3 kw2 = vec3(-3.118, 0.759,  6.107);
        vec3 kw3 = vec3( 3.500, 1.750, -11.875);

        float wf1 = exp(-0.5 * (4.1 * sigmaFilter) * (4.1 * sigmaFilter)) * macroCalm;
        float wf2 = exp(-0.5 * (6.9 * sigmaFilter) * (6.9 * sigmaFilter)) * macroCalm;
        float wf3 = exp(-0.5 * (12.5 * sigmaFilter) * (12.5 * sigmaFilter)) * macroCalm;

        float tFall = timeSec * fallSpeed;
        float ph1 = dot(worldPos, kw1) + tFall * 2.27;
        float ph2 = dot(worldPos, kw2) + tFall * 3.00;
        float ph3 = dot(worldPos, kw3) + tFall * 6.00;

        vec3 wfGrad = kw1 * (cos(ph1) * 0.028 * wf1)
                    + kw2 * (cos(ph2) * 0.015 * wf2)
                    + kw3 * (cos(ph3) * 0.006 * wf3);
        vec3 wfTan = wfGrad - geomNormal * dot(wfGrad, geomNormal);
        float wfStrength = 0.60 + 0.85 * effStrength;
        s.normal = vsSafeNormalize(geomNormal - wfTan * wfStrength, geomNormal);

        float unresolved = 0.5 * (1.0 - wf1 * wf1) * (4.1 * 0.028) * (4.1 * 0.028)
                         + 0.5 * (1.0 - wf2 * wf2) * (6.9 * 0.015) * (6.9 * 0.015)
                         + 0.5 * (1.0 - wf3 * wf3) * (12.5 * 0.006) * (12.5 * 0.006);

        float bandA = 0.5 + 0.5 * cos(ph1);
        float bandB = 0.5 + 0.5 * cos(ph2 + 1.9 * sin(ph3 * 0.7));
        float strandA = smoothstep(0.70, 0.995, bandA);
        float strandB = smoothstep(0.80, 0.995, bandB);
        float strands = max(strandA, 0.85 * strandB);

        float fallFade = 1.0 - smoothstep(14.0, 56.0, camDist);
        float mistFoam = clamp(strands * fallFade * (0.26 + 0.16 * sea) * (0.65 + 0.35 * clarity), 0.0, 0.34);

        float streakDensity = 0.5 + 0.5 * cos(ph1 + 0.5 * ph2);
        float sheetRough = mix(0.09, 0.18, clamp(0.30 + 0.45 * streakDensity + 0.25 * sea, 0.0, 1.0));
        float rough = sqrt(sheetRough * sheetRough + 0.10 * unresolved);
        rough = mix(rough, 0.42, clamp(mistFoam * 3.0, 0.0, 1.0));

        float albedoLuma = max(vsLuminance(baseAlbedo), 0.04);
        vec3 sheetTint = clamp(baseAlbedo / albedoLuma, vec3(0.35), vec3(2.2));
        sheetTint /= max(vsLuminance(sheetTint), 0.25);

        float sheetLevel = 0.28 + 0.07 * strands;
        vec3 fallCol = mix(sheetTint * sheetLevel, vec3(0.05, 0.44, 0.58), 0.16 * clarity);
        vec3 foamCol = vec3(0.84, 0.90, 0.94) * (1.0 - 0.16 * rain);
        s.albedo = clamp(mix(fallCol, foamCol, mistFoam), vec3(0.0), vec3(1.0));
        s.roughness = clamp(rough, 0.02, 0.55);
        s.f0 = WATER_F0;
        s.metallic = 0.0;
        float sss = 0.12 * (0.45 + 0.55 * clarity);
        s.subsurface = clamp(mix(sss, 0.06, clamp(mistFoam * 2.0, 0.0, 1.0)), 0.0, 0.22);
    }
}
