#include <vulkanshaders/v1/common.vsl>

// ReLight Vanilla - Physically based sculpted 16-block vanilla voxel clouds with convective morphing,
// weather-driven condensation altitude and cumulonimbus towers, Rayleigh + Ozone golden-hour optics,
// 3-order Wrenninge multi-scattering, continuous twilight handoff, high-altitude cirrus at y = 540,
// clear-night geomagnetic Aurora Borealis curtains, and a dedicated End void atmosphere featuring
// stratified voxel clouds, cosmic dust veils, and a pixel-art relativistic black hole.

float sv_cloudHash21(vec2 p) {
    p = mod(p, 512.0);
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

float sv_cloudNoise2D(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    float a = sv_cloudHash21(i);
    float b = sv_cloudHash21(i + vec2(1.0, 0.0));
    float c = sv_cloudHash21(i + vec2(0.0, 1.0));
    float d = sv_cloudHash21(i + vec2(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

// Henyey-Greenstein phase function using denom * sqrt(denom) instead of pow(denom, 1.5)
float sv_cloudHgPhase(float cosTheta, float g) {
    float g2 = g * g;
    float denom = max(1.0 + g2 - 2.0 * g * cosTheta, 1e-4);
    return (1.0 - g2) / (12.56637061 * denom * sqrt(denom));
}

// Physical solar transmittance through Rayleigh (lambda^-4) + Ozone Chappuis absorption vs sun elevation
vec3 sv_cloudSolarTransmittance(float sunY) {
    float elev = max(sunY, 0.0);
    float airMass = 1.0 / (sqrt(elev * elev + 0.0085) + 0.032);
    float twilightLimb = max(-sunY, 0.0) * 32.0;
    float optMass = min(airMass + twilightLimb, 18.0);
    vec3 betaRayleigh = vec3(0.052, 0.132, 0.305);
    vec3 betaOzone = vec3(0.026, 0.038, 0.003);
    return exp(-(betaRayleigh + betaOzone) * (optMass - 0.92));
}

// Sculpted 2-tier 16-block vanilla voxel cloud density with slow constant-rate convective animation
float sv_sampleVoxelCloudDensity(
    vec3 worldPos,
    VsSkyState sky,
    float cloudBottom,
    float cloudTop,
    float biomeCloudScale,
    float stormFactor,
    float thunderFactor
) {
    const float TAU = 6.28318530718;
    float h = clamp((worldPos.y - cloudBottom) / max(cloudTop - cloudBottom, 1.0), 0.0, 1.0);
    if (h <= 0.0 || h >= 1.0) {
        return 0.0;
    }

    // Constant base wind velocity prevents cloud teleporting when rain/thunder changes dynamically
    vec2 drift = vec2(sky.gameTimeSec * 3.1, sky.gameTimeSec * 0.55);
    vec2 xz = (worldPos.xz + drift) / 16.0;
    vec2 cell = floor(xz);
    vec2 local = fract(xz);

    // Slow convective billowing per 16-block cumulus cell (constant frequency, weather-scaled depth)
    float cellPhase = mod(cell.x * 0.37 - cell.y * 0.29, TAU);
    float morphTime = mod(sky.gameTimeSec * 0.055, TAU);
    float morph = sin(cellPhase + morphTime) * (0.042 + 0.036 * stormFactor);

    float macro = sv_cloudNoise2D(cell * 0.14) * 0.66
                + sv_cloudNoise2D(cell * 0.31 + vec2(17.3, 9.1)) * 0.34
                + morph;
    float baseCoverage = mix(0.44 * biomeCloudScale, 0.82, stormFactor);
    float threshold = 1.0 - clamp(baseCoverage, 0.22, 0.86);

    float occupied = smoothstep(threshold - 0.04, threshold + 0.06, macro);
    if (occupied <= 0.001) {
        return 0.0;
    }

    // Soft bevel inside each 16-block voxel cell keeps crisp vanilla silhouettes without edge aliasing
    vec2 edgeDist = min(local, 1.0 - local);
    float bevel = smoothstep(0.0, 0.12, min(edgeDist.x, edgeDist.y));
    float cellBlend = mix(0.74, 1.0, bevel);

    // 2-tier sculpted vanilla cumulus: flat condensation deck + stepped 8-block inset crown turrets
    float baseLift = smoothstep(0.0, 0.10, h);
    float lowTop = 0.44 + 0.14 * stormFactor;
    float lowCap = 1.0 - smoothstep(lowTop - 0.10, lowTop, h);

    float coreMask = smoothstep(threshold + 0.05, threshold + 0.24, macro);
    float crownTop = mix(0.62, 0.98, clamp(coreMask + thunderFactor * 0.22, 0.0, 1.0));
    float crownFadeStart = max(crownTop - 0.16, 0.24);
    float crownCap = 1.0 - smoothstep(crownFadeStart, max(crownTop, crownFadeStart + 0.02), h);

    vec2 subLocal = fract(xz * 2.0);
    vec2 subEdge = min(subLocal, 1.0 - subLocal);
    float subBevel = smoothstep(0.0, 0.15, min(subEdge.x, subEdge.y));
    float turretProfile = crownCap * coreMask * mix(0.80, 1.0, subBevel);

    float verticalProfile = baseLift * max(lowCap, turretProfile);
    float densityScale = mix(1.42, 1.62, stormFactor);
    return clamp(occupied * cellBlend * verticalProfile * densityScale, 0.0, 1.0);
}

// Localized intra-cloud sheet-lightning glow inside dense cumulonimbus cores during thunderstorms
float sv_cloudStormLightning(vec3 worldPos, float timeSec, float thunderFactor) {
    if (thunderFactor <= 0.15) {
        return 0.0;
    }
    vec2 stormCell = floor(worldPos.xz * 0.011);
    float cellSeed = sv_cloudHash21(stormCell);
    float cycle = timeSec * 0.38 + cellSeed * 11.0;
    float slot = mod(floor(cycle), 256.0);
    float localT = fract(cycle);
    float flashPick = sv_cloudHash21(stormCell + vec2(slot * 7.13, 3.71));
    float flashGate = smoothstep(0.90 - 0.06 * thunderFactor, 0.98, flashPick);
    if (flashGate <= 0.001) {
        return 0.0;
    }
    // Smooth double-peak lightning discharge pulse (avoids harsh 1-frame TAA strobe)
    float p1 = exp(-abs(localT - 0.14) * 14.0);
    float p2 = exp(-abs(localT - 0.28) * 18.0) * 0.65;
    float pulse = (p1 + p2) * smoothstep(0.0, 0.04, localT);
    return pulse * flashGate * smoothstep(0.15, 1.0, thunderFactor);
}

// Volumetric ray-marched geomagnetic Aurora Borealis curtains (95km -> 260km altitude march).
// Models field-aligned vertical drapery with magnetic-zenith inclination shear, multi-arc
// Alfvén-wave folding, bright vertical ray pillars, and authentic upper-atmosphere spectroscopy:
//   - Lower sharp edge (~95-110km):  N2+ 1NG violet-magenta / crimson fringe (427.8nm / 670nm)
//   - Primary bright core (~110-165km): O(1S) emerald-green (557.7nm) -> N2+ cyan-turquoise
//   - Upper diffuse veil (~175-260km):  O(1D) deep ruby-violet (630.0nm)
float sv_auroraFbm(vec2 p) {
    float v = sv_cloudNoise2D(p) * 0.56;
    v += sv_cloudNoise2D(p * 2.13 + vec2(17.1, 31.7)) * 0.29;
    v += sv_cloudNoise2D(p * 4.41 + vec2(43.2, 11.9)) * 0.15;
    return v;
}

vec3 sv_cloudAuroraCurtains(
    vec3 dir,
    float timeSec,
    float nightFactor,
    float stormFactor,
    vec3 moonDir
) {
    const float TAU = 6.28318530718;
    if (nightFactor <= 0.005 || stormFactor >= 0.82 || dir.y <= 0.04) {
        return vec3(0.0);
    }

    float clearSky = 1.0 - smoothstep(0.06, 0.78, stormFactor);
    // Allow curtains to arch gracefully high overhead while fading smoothly near the horizon
    float elevFade = smoothstep(0.04, 0.16, dir.y) * (1.0 - smoothstep(0.84, 0.995, dir.y));

    // Biome responsiveness: dramatic in cold/taiga/snowy biomes, graceful ethereal presence in temperate nights
    float bTemp = vsBiomeTemperature();
    float coldBoost = 1.0 - smoothstep(0.08, 0.42, bTemp);
    float biomePresence = mix(0.68, 1.32, coldBoost);

    // Subtle preference for the northern sky while still allowing overhead coronal arches
    float northArc = 0.42 + 0.58 * smoothstep(-0.45, 0.45, -dir.z);

    // Keep moon disk crisp by softly attenuating aurora right across the lunar disc
    float moonDot = clamp(dot(dir, moonDir), 0.0, 1.0);
    float m2 = moonDot * moonDot;
    float m4 = m2 * m2;
    float moonKeepout = 1.0 - 0.78 * (m4 * m4);

    // Natural geomagnetic substorm activity cycle (~140s swell + gentle harmonic)
    float substorm = 0.72 + 0.28 * sin(mod(timeSec * 0.045, TAU))
                   + 0.10 * sin(mod(timeSec * 0.113, TAU) + 1.2);
    float mask = nightFactor * clearSky * elevFade * northArc * moonKeepout * substorm * biomePresence;
    if (mask <= 0.002) {
        return vec3(0.0);
    }

    float tFold = mod(timeSec * 0.055, TAU);
    float tWave = mod(timeSec * 0.22, TAU);
    float rayDrift = mod(timeSec * 0.095, 512.0);
    float invY = 1.0 / max(dir.y, 0.085);

    // Static view-locked IGN dithering along altitude march eliminates horizontal slice banding
    float ign = fract(52.9829189 * fract(dot(dir.xz * 256.0, vec2(0.06711056, 0.00583715))));

    int stepCount = 8;
#ifdef VS_LIGHTING_MODE
#if VS_LIGHTING_MODE >= VS_MODE_COMPUTE
    stepCount = 12;
#endif
#endif

    vec3 acc = vec3(0.0);
    float invSteps = 1.0 / float(stepCount);

    for (int s = 0; s < 12; ++s) {
        if (s >= stepCount) {
            break;
        }
        float hFrac = (float(s) + 0.18 + 0.64 * ign) * invSteps;
        // Exponential altitude mapping (95km base -> 260km crown)
        float hAlt = 1.0 + hFrac * 1.45 + hFrac * hFrac * 0.65;

        // Magnetic-field inclination shear tilts curtains organically toward the magnetic zenith
        vec2 p = dir.xz * invY * hAlt + vec2(0.14, -0.32) * hFrac;
        float px = p.x;
        float pz = p.y;

        // Curved geomagnetic oval coordinates with domain-warped Alfvén-wave folding
        float ovalZ = pz + 0.065 * px * px;
        float warp = (sv_auroraFbm(vec2(px * 0.24 + rayDrift * 0.18, ovalZ * 0.22 - rayDrift * 0.10)) - 0.5) * 1.35;

        // Arc 1: Primary bright folded auroral curtain
        float fold1 = sin(mod(px * 0.62, TAU) + tFold) * 0.58
                    + sin(mod(px * 1.38, TAU) - tFold * 1.35) * 0.26
                    + warp * 0.65;
        float d1 = (ovalZ + 1.85 - fold1) * 1.55;
        float r1 = exp(-d1 * d1);

        // Arc 2: Secondary sweeping outer ribbon
        float fold2 = sin(mod(px * 0.48 + 1.9, TAU) - tFold * 0.78) * 0.72
                    - warp * 0.52;
        float d2 = (ovalZ + 3.25 - fold2) * 1.15;
        float r2 = exp(-d2 * d2) * 0.82;

        // Arc 3: High-latitude coronal veil
        float fold3 = sin(mod(px * 0.85 - 1.1, TAU) + tFold * 0.92) * 0.44
                    + warp * 0.45;
        float d3 = (ovalZ + 0.65 - fold3) * 1.35;
        float r3 = exp(-d3 * d3) * 0.62;

        float curtain = max(max(r1, r2), r3);
        if (curtain <= 0.004) {
            continue;
        }

        // Field-aligned vertical ray pillars & traveling Alfvén shimmer
        float pillarNoise = sv_auroraFbm(vec2(px * 2.6 + rayDrift * 0.42, ovalZ * 0.55 - warp * 0.35));
        float fineRays = 0.42 + 0.58 * sin(mod(px * 9.8 + pillarNoise * 5.8, TAU) + tWave);
        float brightPillars = pow(clamp(pillarNoise * 1.15, 0.0, 1.0), 1.65) * (0.45 + 0.55 * fineRays);

        // Vertical emission profile: sharp luminous lower border (~105km), long tapering upper tail (~260km)
        float verticalProfile = smoothstep(0.0, 0.14, hFrac) * exp(-hFrac * 1.75);

        // True upper-atmosphere spectroscopic color gradient by altitude
        vec3 colLowerEdge = vec3(0.76, 0.14, 0.62); // N2+ 1NG magenta-violet fringe
        vec3 colGreen     = vec3(0.09, 1.00, 0.46); // O(1S) 557.7nm emerald green
        vec3 colCyan      = vec3(0.08, 0.84, 0.86); // N2+ cyan-turquoise transition
        vec3 colCrimson   = vec3(0.62, 0.13, 0.50); // O(1D) 630.0nm ruby-violet crown

        vec3 spectral = mix(colLowerEdge, colGreen, smoothstep(0.03, 0.17, hFrac));
        spectral = mix(spectral, colCyan, smoothstep(0.24, 0.54, hFrac) * (0.55 + 0.45 * pillarNoise));
        spectral = mix(spectral, colCrimson, smoothstep(0.56, 0.92, hFrac));

        acc += spectral * (curtain * (0.28 + 1.15 * brightPillars) * verticalProfile * invSteps);
    }

    return acc * (mask * 2.45);
}

// Keplerian differential accretion filament pattern: angular speed Omega(r) ~ r^(-3/2)
float sv_endDiskStripes(float rVal, float angleVal, float timeSec) {
    const float TAU = 6.28318530718;
    float rc = clamp(rVal, 1.0, 4.0);
    float omega = 1.15 / (rc * sqrt(rc));
    float phi = mod(angleVal - mod(timeSec * omega, TAU), TAU);
    float s1 = 0.5 + 0.5 * sin(mod(rc * 7.2 + phi * 2.0, TAU));
    float s2 = 0.5 + 0.5 * sin(mod(rc * 12.5 - phi * 3.0, TAU) + 1.1);
    return 0.56 + 0.28 * s1 + 0.16 * s2;
}

// Minecraft pixel-art relativistic Schwarzschild/Kerr Black Hole with photon ring,
// gravitationally lensed upper/lower arches, Keplerian shear, Doppler beaming, and polar jets.
// Returns vec4(emissive_radiance, horizon_shadow_mask).
vec4 sv_endBlackHole(
    vec3 dir,
    vec3 bhDir,
    vec3 bhRight,
    vec3 bhUp,
    float timeSec
) {
    const float TAU = 6.28318530718;
    float cosBH = dot(dir, bhDir);
    if (cosBH <= 0.35) {
        return vec4(0.0);
    }

    float invCos = 1.0 / max(cosBH, 0.25);
    float uRaw = (dot(dir, bhRight) * invCos) / 0.10;
    float vRaw = (dot(dir, bhUp) * invCos) / 0.10;
    float rRaw = sqrt(uRaw * uRaw + vRaw * vRaw);

    // Smooth radial crepuscular accretion light rays streaming into the surrounding End void
    float rayAngle = atan(vRaw, (abs(uRaw) < 1e-4) ? 1e-4 : uRaw);
    float rayT = mod(timeSec * 0.085, TAU);
    float rayWave1 = 0.5 + 0.5 * sin(mod(rayAngle * 7.0, TAU) + rayT);
    float rayWave2 = 0.5 + 0.5 * sin(mod(rayAngle * 13.0, TAU) - rayT * 1.4 + 1.2);
    float rayAngular = rayWave1 * (0.45 + 0.55 * rayWave2);
    float rayRadial = smoothstep(0.95, 1.85, rRaw) * exp(-max(rRaw - 1.4, 0.0) * 0.24);
    float coneFade = smoothstep(0.35, 0.62, cosBH);
    vec3 haloGlow = vec3(0.42, 0.20, 0.64) * (exp(-rRaw * 0.52) * 0.28 * coneFade);
    vec3 crepuscularRays = vec3(0.76, 0.54, 1.05) * (rayRadial * rayAngular * 0.22 * coneFade);

    if (cosBH <= 0.72) {
        return vec4(haloGlow + crepuscularRays, 0.0);
    }

    // Quantize onto a crisp world-locked Minecraft pixel-art grid in the BH tangent plane
    const float PX = 0.115;
    float u = (floor(uRaw / PX) + 0.5) * PX;
    float v = (floor(vRaw / PX) + 0.5) * PX;
    float b = sqrt(u * u + v * v);
    float bSafe = max(b, 1e-4);

    // Event horizon shadow at critical Schwarzschild impact parameter b_c = 3*sqrt(3)/2 * r_s (normalized to 1.0)
    float shadow = 1.0 - smoothstep(0.92, 1.06, b);

    // Unstable photon-sphere lensing ring right around b = 1.04
    float dPhoton = b - 1.04;
    float photonRing = exp(-(dPhoton * dPhoton) * 145.0) * 1.38;

    // Inclined (~8 deg) front equatorial accretion disk crossing in front of the event horizon
    const float SIN_INC = 0.145;
    float rFront = sqrt(u * u + (v / SIN_INC) * (v / SIN_INC));
    float frontHalf = 1.0 - smoothstep(-0.04, 0.14, v);
    float frontRadial = smoothstep(1.00, 1.24, rFront) * (1.0 - smoothstep(2.55, 4.00, rFront));
    float wingBand = exp(-((v / 0.24) * (v / 0.24)))
                   * smoothstep(1.00, 1.24, abs(u))
                   * (1.0 - smoothstep(2.60, 4.00, abs(u)));
    float frontCore = frontRadial * frontHalf;
    float frontMask = max(frontCore, wingBand * 0.90);

    // Gravitationally lensed far-side disk arches (upper primary arch + lower secondary underside arch)
    float upperHemi = smoothstep(-0.12, 0.20, v);
    float upperArch = smoothstep(0.98, 1.12, b)
                    * (1.0 - smoothstep(1.42, 2.25, b))
                    * upperHemi
                    * (1.0 - shadow * 0.92);
    float lowerHemi = 1.0 - smoothstep(-0.20, 0.08, v);
    float lowerArch = smoothstep(0.98, 1.10, b)
                    * (1.0 - smoothstep(1.22, 1.68, b))
                    * lowerHemi
                    * (1.0 - shadow * 0.92)
                    * 0.78;
    float lensedMask = max(upperArch, lowerArch);

    float angFront = atan(v / SIN_INC, u);
    float angLens = atan(v, u);
    float eFront = frontMask * sv_endDiskStripes(rFront, angFront, timeSec);
    float eLens = lensedMask * sv_endDiskStripes(b * 1.12, angLens, timeSec) * 0.90;
    float totalDisk = max(eFront, eLens) + min(eFront, eLens) * 0.30;
    float rEff = max((eFront >= eLens) ? rFront : b, 1.02);

    // Relativistic Doppler beaming D = 1 / (gamma * (1 - beta * cos_los)) and D^3 flux shift
    float beta = sqrt(clamp(0.18 / rEff, 0.0, 0.24));
    float invGamma = sqrt(max(1.0 - beta * beta, 0.42));
    float cosLos = clamp(-u / max(bSafe, 1.05), -1.0, 1.0) * 0.86;
    float doppler = invGamma / max(1.0 - beta * cosLos, 0.48);
    float dBoost = clamp(doppler * doppler * doppler, 0.72, 1.82);

    // Shakura-Sunyaev radial temperature profile T(r) ~ r^(-3/4) via nested sqrt (no pow)
    float rInv075 = 1.0 / (sqrt(rEff) * sqrt(sqrt(rEff)));
    float temp = clamp(rInv075 * doppler * 0.96, 0.0, 1.55);

    vec3 colOuter = vec3(0.68, 0.22, 0.82);
    vec3 colMid = vec3(0.98, 0.56, 1.06);
    vec3 colWarm = vec3(1.32, 0.86, 0.72);
    vec3 colHot = vec3(1.24, 1.24, 1.52);
    vec3 diskCol = mix(colOuter, colMid, smoothstep(0.18, 0.64, temp));
    diskCol = mix(diskCol, mix(colWarm, colHot, smoothstep(0.94, 1.26, doppler)), smoothstep(0.56, 1.12, temp));

    // Front equatorial disk cleanly passes in front of the black hole shadow
    float shadowVis = shadow * (1.0 - clamp(frontCore * 1.85, 0.0, 1.0));

    // Collimated Blandford-Znajek relativistic polar jets along +-v spin axis
    float absV = abs(v);
    float jetEnv = smoothstep(1.05, 1.75, absV) * (1.0 - smoothstep(3.20, 6.20, absV));
    float jetWidth = 0.14 + 0.065 * absV;
    float jetCore = exp(-((u / jetWidth) * (u / jetWidth)));
    float jetWave = 0.68 + 0.32 * sin(mod(absV * 2.6, TAU) - mod(timeSec * 1.25, TAU));
    vec3 jetRad = vec3(0.52, 0.68, 1.22) * (jetEnv * jetCore * jetWave * 0.40);

    vec3 photonCol = mix(vec3(1.14, 0.74, 1.26), vec3(1.45, 1.38, 1.62), smoothstep(0.86, 1.28, doppler));
    vec3 bhRad = diskCol * (totalDisk * dBoost * 0.76)
               + photonCol * (photonRing * (0.68 + 0.32 * clamp(doppler, 0.60, 1.55)))
               + jetRad
               + haloGlow
               + crepuscularRays;

    return vec4(max(bhRad, vec3(0.0)), clamp(shadowVis, 0.0, 1.0));
}

// Sculpted 16-block voxel End void clouds: stratified ethereal archipelago bands with slow harmonic morph
float sv_sampleEndCloudDensity(
    vec3 worldPos,
    float timeSec,
    float cloudBottom,
    float cloudTop,
    float biomeScale
) {
    const float TAU = 6.28318530718;
    float h = clamp((worldPos.y - cloudBottom) / max(cloudTop - cloudBottom, 1.0), 0.0, 1.0);
    if (h <= 0.0 || h >= 1.0) {
        return 0.0;
    }

    vec2 drift = vec2(timeSec * 2.1, -timeSec * 0.85);
    vec2 xz = (worldPos.xz + drift) / 16.0;
    vec2 cell = floor(xz);
    vec2 local = fract(xz);

    // Slow stratified harmonic ripple across End void cells
    float morphPhase = mod(cell.x * 0.31 + cell.y * 0.23, TAU) + mod(timeSec * 0.048, TAU);
    float morph = sin(morphPhase) * 0.045;

    // Stretched filamentary macro structure (distinct from puffy Overworld cumulus)
    float n1 = sv_cloudNoise2D(cell * vec2(0.09, 0.17));
    float n2 = sv_cloudNoise2D(cell * vec2(0.24, 0.19) + vec2(11.7, 23.4));
    float macro = n1 * 0.62 + n2 * 0.38 + morph;

    float coverage = clamp(0.40 * biomeScale, 0.24, 0.56);
    float threshold = 1.0 - coverage;
    float occupied = smoothstep(threshold - 0.04, threshold + 0.07, macro);
    if (occupied <= 0.001) {
        return 0.0;
    }

    vec2 edgeDist = min(local, 1.0 - local);
    float bevel = smoothstep(0.0, 0.14, min(edgeDist.x, edgeDist.y));
    float cellBlend = mix(0.70, 1.0, bevel);

    // Thin terraced twin-stratum voxel ribbons (floating End shelves rather than heavy tall domes)
    float lowerDeck = smoothstep(0.0, 0.14, h) * (1.0 - smoothstep(0.36, 0.56, h));
    float upperMask = smoothstep(threshold + 0.07, threshold + 0.22, macro);
    float upperShelf = smoothstep(0.46, 0.62, h) * (1.0 - smoothstep(0.78, 0.96, h)) * upperMask;
    float verticalProfile = max(lowerDeck, upperShelf * 0.85);

    return clamp(occupied * cellBlend * verticalProfile * 1.10, 0.0, 1.0);
}

// Complete End atmosphere: sculpted ethereal voxel void clouds, high-altitude dust veil,
// abyssal under-void mist, and pixel-art relativistic black hole with polar jets and crepuscular rays.
vec4 sv_endClouds(in vec3 dir, in vec3 cameraPos, in VsSkyState sky) {
    float timeSec = sky.gameTimeSec;

    // Exact orthonormal celestial frame for the relativistic black hole (~34 deg elevation, ~18 deg spin tilt)
    vec3 bhDir = vec3(0.300526, 0.560983, -0.771351);
    vec3 bhRight = vec3(0.816626, 0.266478, 0.511968);
    vec3 bhUp = vec3(-0.492753, 0.783765, 0.378029);

    vec3 biomeFog = vsHasBiomeTelemetry() ? clamp(vsBiomeFogTint(), vec3(0.0), vec3(1.0)) : vec3(0.09, 0.05, 0.14);
    vec3 voidAmbientBase = mix(vec3(0.036, 0.020, 0.072), biomeFog * 0.55, 0.35);
    vec3 voidAmbientTop = mix(vec3(0.078, 0.044, 0.145), biomeFog * 0.85, 0.35);
    vec3 bhLightColor = vec3(0.82, 0.58, 1.15);

    float cosBH = dot(dir, bhDir);
    float bhForward = sv_cloudHgPhase(cosBH, 0.74) * 0.76 + sv_cloudHgPhase(cosBH, -0.20) * 0.24;
    float bhPhase = 0.42 + clamp(bhForward * 2.8, 0.0, 2.0);

    // 1. Sculpted 16-block voxel End void clouds (6 steps x 2 taps = 12 evals, half of Overworld budget)
    const float endBottom = 206.0;
    const float endTop = 254.0;
    float voxelTrans = 1.0;
    vec3 voxelScattered = vec3(0.0);
    float tEnter = 0.0;
    float tExit = 0.0;
    bool hitBand = false;

    if (cameraPos.y < endBottom) {
        if (dir.y > 0.015) {
            tEnter = (endBottom - cameraPos.y) / max(dir.y, 0.02);
            tExit = (endTop - cameraPos.y) / max(dir.y, 0.02);
            hitBand = true;
        }
    } else if (cameraPos.y > endTop) {
        if (dir.y < -0.015) {
            tEnter = (endTop - cameraPos.y) / min(dir.y, -0.02);
            tExit = (endBottom - cameraPos.y) / min(dir.y, -0.02);
            hitBand = true;
        }
    } else {
        tEnter = 0.0;
        tExit = (dir.y >= 0.0)
            ? (endTop - cameraPos.y) / max(dir.y, 0.02)
            : (endBottom - cameraPos.y) / min(dir.y, -0.02);
        hitBand = true;
    }

    if (hitBand) {
        tEnter = max(tEnter, 0.0);
        tExit = min(tExit, 2000.0);
        if (tExit > tEnter) {
            const int END_STEPS = 6;
            float stepSize = (tExit - tEnter) / float(END_STEPS);
            float biomeScale = vsBiomeCloudScale();
            float extinction = 0.028;

            // Static view-locked IGN jitter (no frame-index snapping in dim End void)
            float jitter = fract(52.9829189 * fract(dot(dir.xz * 256.0, vec2(0.06711056, 0.00583715))));
            float invHeight = 1.0 / max(endTop - endBottom, 1.0);

            for (int i = 0; i < END_STEPS; ++i) {
                if (voxelTrans < 0.35) {
                    break;
                }
                float t = tEnter + (float(i) + jitter) * stepSize;
                vec3 pos = cameraPos + dir * t;
                float density = sv_sampleEndCloudDensity(pos, timeSec, endBottom, endTop, biomeScale);
                if (density > 0.003) {
                    float dLight = sv_sampleEndCloudDensity(pos + bhDir * 24.0, timeSec, endBottom, endTop, biomeScale);
                    float optDepth = dLight * 24.0 * extinction;
                    float bhEnergy = exp(-optDepth) * 0.72 + exp(-optDepth * 0.25) * 0.28;

                    float hNorm = clamp((pos.y - endBottom) * invHeight, 0.0, 1.0);
                    vec3 ambCol = mix(voidAmbientBase, voidAmbientTop, hNorm);
                    // Subtle warm-lavender accretion rim on black-hole-facing edges
                    vec3 rimCol = mix(bhLightColor, vec3(1.18, 0.86, 0.96), smoothstep(0.65, 0.96, cosBH));
                    vec3 litCol = ambCol + rimCol * (bhEnergy * bhPhase * mix(0.22, 0.52, hNorm));

                    float stepTrans = exp(-density * extinction * stepSize);
                    voxelScattered += voxelTrans * litCol * (1.0 - stepTrans);
                    voxelTrans *= stepTrans;
                }
            }
        }
    }

    // Keep End clouds translucent so the End sky and stars remain readable behind them
    float bandFade = hitBand
        ? smoothstep(0.015, 0.14, abs(dir.y)) * (1.0 - smoothstep(900.0, 2000.0, tEnter))
        : 0.0;
    vec3 scattered = voxelScattered * bandFade;
    float transmittance = mix(1.0, max(voxelTrans, 0.45), bandFade);

    // 2. High-altitude luminous End void-dust veil at y = 430 (independent horizon fade)
    if (dir.y > 0.035 && cameraPos.y < 420.0 && transmittance > 0.08) {
        float tVeil = (430.0 - cameraPos.y) / max(dir.y, 0.035);
        float veilFade = smoothstep(0.035, 0.16, dir.y) * (1.0 - smoothstep(2400.0, 4400.0, tVeil));
        if (veilFade > 0.005) {
            vec2 vWorld = cameraPos.xz + dir.xz * min(tVeil, 4400.0);
            vec2 vDrift = vec2(mod(timeSec * 0.0042, 512.0), mod(-timeSec * 0.0024, 512.0));
            vec2 vUv = vWorld * vec2(0.00052, 0.00128) + vDrift;
            float warp = sv_cloudNoise2D(vUv * 1.35);
            vec2 vWarped = vUv + vec2(warp * 0.58, -warp * 0.36);
            float filament = sv_cloudNoise2D(vWarped) * 0.60
                           + sv_cloudNoise2D(vWarped * 2.5 + vec2(5.3, 1.9)) * 0.40;
            float veilMask = smoothstep(0.50, 0.86, filament);
            float veilAlpha = veilMask * 0.24 * veilFade;

            vec3 dustTint = mix(vec3(0.16, 0.09, 0.28), vec3(0.58, 0.38, 0.82), smoothstep(0.25, 0.92, cosBH));
            dustTint *= (0.75 + 0.55 * clamp(bhForward * 2.2, 0.0, 1.5));
            scattered += transmittance * dustTint * veilAlpha;
            transmittance *= (1.0 - veilAlpha * 0.28);
        }
    }

    // 3. Subtle abyssal void mist drifting below floating End islands (dir.y < -0.04)
    if (dir.y < -0.04 && transmittance > 0.10) {
        float tAbyss = max((cameraPos.y + 120.0) / max(-dir.y, 0.04), 0.0);
        float abyssFade = smoothstep(0.04, 0.22, -dir.y) * (1.0 - smoothstep(1400.0, 3200.0, tAbyss));
        if (abyssFade > 0.005) {
            vec2 aWorld = cameraPos.xz + dir.xz * min(tAbyss, 3200.0);
            vec2 aDrift = vec2(mod(-timeSec * 0.0030, 512.0), mod(timeSec * 0.0020, 512.0));
            vec2 aUv = aWorld * 0.00075 + aDrift;
            float aNoise = sv_cloudNoise2D(aUv) * 0.65 + sv_cloudNoise2D(aUv * 2.2 + vec2(3.1, 7.4)) * 0.35;
            float aMask = smoothstep(0.46, 0.84, aNoise) * 0.18 * abyssFade;
            vec3 abyssCol = mix(vec3(0.055, 0.030, 0.115), vec3(0.14, 0.08, 0.24), aNoise);
            scattered += transmittance * abyssCol * aMask;
            transmittance *= (1.0 - aMask * 0.22);
        }
    }

    // 4. Pixel-art relativistic Black Hole + polar jets + crepuscular rays composited behind End clouds
    if (transmittance > 0.02) {
        vec4 bh = sv_endBlackHole(dir, bhDir, bhRight, bhUp, timeSec);
        scattered += transmittance * bh.rgb;
        // Event horizon shadow absorbs background sky strictly inside its compact pixel silhouette
        transmittance *= (1.0 - bh.a * 0.94);
    }

    return vec4(max(scattered, vec3(0.0)), clamp(transmittance, 0.0, 1.0));
}

// @hook(stage = "clouds", priority = 100)
vec4 sv_clouds(in vec3 dir, in vec3 cameraPos, in VsSkyState sky) {
    int dim = vsDimensionId();
    if (dim == 1) {
        return vec4(0.0, 0.0, 0.0, 1.0);
    }
    if (dim == 2 && vsHasBiomeTelemetry()) {
        return sv_endClouds(dir, cameraPos, sky);
    }
    if (dim != 0) {
        return vec4(0.0, 0.0, 0.0, 1.0);
    }

    float rain = clamp(sky.rain, 0.0, 1.0);
    float thunder = clamp(sky.thunder, 0.0, 1.0);
    float stormFactor = clamp(rain * 0.80 + thunder * 0.38, 0.0, 1.0);

    // Weather-driven atmospheric cloud deck: rain lowers LCL and thickens layer; storms grow cumulonimbus tops
    float cloudBottom = mix(256.0, 228.0, stormFactor);
    float cloudTop = mix(292.0, 308.0, stormFactor) + thunder * 16.0;

    vec3 sunDir = vsSafeNormalize(sky.sunDir, vec3(0.0, 1.0, 0.0));
    vec3 moonDir = -sunDir;

    // Continuous zero-pop twilight handoff at sunDir.y = -0.10:
    // sunDirectWeight reaches exact 0.0 before moonDirectWeight begins rising
    float sunDirectWeight = smoothstep(-0.10, 0.05, sunDir.y);
    float moonDirectWeight = smoothstep(0.10, 0.24, moonDir.y);
    bool useSunLight = (sunDir.y >= -0.10);
    vec3 lightDir = useSunLight ? sunDir : moonDir;

    float dayFactor = smoothstep(-0.08, 0.22, sunDir.y);
    float twilightFactor = smoothstep(-0.16, 0.01, sunDir.y) * (1.0 - smoothstep(0.05, 0.28, sunDir.y));
    float nightFactor = 1.0 - smoothstep(-0.22, -0.06, sunDir.y);

    vec3 sunTrans = sv_cloudSolarTransmittance(sunDir.y);
    vec3 sunDirect = sunTrans * vec3(1.14, 1.05, 0.88) * sunDirectWeight * (1.0 + 0.42 * twilightFactor);
    vec3 moonDirect = vec3(0.11, 0.16, 0.27) * moonDirectWeight;
    vec3 directColor = (useSunLight ? sunDirect : moonDirect) * (1.0 - stormFactor * 0.66);

    // Hemisphere-aware sky ambient: clean blue-grey day, warm sun-side + violet-indigo shadow at sunset, dim night
    float cosSun = dot(dir, sunDir);
    float sunHemi = clamp(0.5 + 0.5 * cosSun, 0.0, 1.0);
    float sunHemi2 = sunHemi * sunHemi;

    vec3 ambTop = mix(vec3(0.020, 0.032, 0.062), vec3(0.33, 0.42, 0.56), dayFactor);
    vec3 ambBase = mix(vec3(0.011, 0.018, 0.038), vec3(0.23, 0.30, 0.42), dayFactor);

    vec3 twiAmbTop = mix(vec3(0.15, 0.13, 0.34), vec3(0.74, 0.32, 0.19), sunHemi2);
    vec3 twiAmbBase = mix(vec3(0.09, 0.08, 0.24), vec3(0.48, 0.19, 0.18), sunHemi2);
    float twiMix = twilightFactor * (1.0 - stormFactor * 0.75);
    ambTop = mix(ambTop, twiAmbTop, twiMix * 0.72);
    ambBase = mix(ambBase, twiAmbBase, twiMix * 0.85);

    float stormLumScale = mix(0.15, 1.0, dayFactor);
    ambTop = mix(ambTop, vec3(0.30, 0.33, 0.38) * stormLumScale, stormFactor * 0.80);
    ambBase = mix(ambBase, vec3(0.10, 0.12, 0.17) * stormLumScale, stormFactor * 0.90);

    // 3-order Wrenninge multi-scattering phase terms (precomputed once per ray)
    float cosTheta = useSunLight ? cosSun : -cosSun;
    float p0 = sv_cloudHgPhase(cosTheta, 0.78) * 0.68 + sv_cloudHgPhase(cosTheta, -0.22) * 0.32;
    float p1 = sv_cloudHgPhase(cosTheta, 0.38) * 0.72 + 0.07957747 * 0.28;
    float phaseOrder0 = 0.44 + clamp(p0 * 3.2, 0.0, 1.85);
    float phaseOrder1 = 0.50 + clamp(p1 * 2.2, 0.0, 0.90);
    float deepBleed = mix(0.18, 0.09, twiMix);
    float powderAngle = clamp(0.60 - 0.50 * cosTheta, 0.0, 1.0);

    float voxelTrans = 1.0;
    vec3 voxelScattered = vec3(0.0);
    float tEnter = 0.0;
    float tExit = 0.0;
    bool hitVoxelBand = false;

    if (cameraPos.y < cloudBottom) {
        if (dir.y > 0.015) {
            tEnter = (cloudBottom - cameraPos.y) / max(dir.y, 0.02);
            tExit = (cloudTop - cameraPos.y) / max(dir.y, 0.02);
            hitVoxelBand = true;
        }
    } else if (cameraPos.y > cloudTop) {
        if (dir.y < -0.015) {
            tEnter = (cloudTop - cameraPos.y) / min(dir.y, -0.02);
            tExit = (cloudBottom - cameraPos.y) / min(dir.y, -0.02);
            hitVoxelBand = true;
        }
    } else {
        tEnter = 0.0;
        tExit = (dir.y >= 0.0)
            ? (cloudTop - cameraPos.y) / max(dir.y, 0.02)
            : (cloudBottom - cameraPos.y) / min(dir.y, -0.02);
        hitVoxelBand = true;
    }

    if (hitVoxelBand) {
        tEnter = max(tEnter, 0.0);
        tExit = min(tExit, 2200.0);
        if (tExit > tEnter) {
            const int STEPS = 8;
            float stepSize = (tExit - tEnter) / float(STEPS);
            float biomeCloudScale = vsBiomeCloudScale();
            float extinction = mix(0.058, 0.086, stormFactor);

            // Golden-ratio temporal IGN jitter for smooth TAA/SVGF convergence
            float frameMod = mod(float(vsWorld.frameIndex), 64.0);
            float ign = fract(52.9829189 * fract(dot(dir.xz * 256.0, vec2(0.06711056, 0.00583715))));
            float jitter = fract(ign + frameMod * 0.61803399);

            float invBandHeight = 1.0 / max(cloudTop - cloudBottom, 1.0);

            for (int i = 0; i < STEPS; ++i) {
                if (voxelTrans < 0.03) {
                    break;
                }
                float t = tEnter + (float(i) + jitter) * stepSize;
                vec3 pos = cameraPos + dir * t;
                float density = sv_sampleVoxelCloudDensity(
                    pos, sky, cloudBottom, cloudTop, biomeCloudScale, stormFactor, thunder
                );
                if (density > 0.003) {
                    // 2-tap optical depth along active light direction (same 8x3 budget as baseline)
                    float d1 = sv_sampleVoxelCloudDensity(
                        pos + lightDir * 16.0, sky, cloudBottom, cloudTop, biomeCloudScale, stormFactor, thunder
                    );
                    float d2 = sv_sampleVoxelCloudDensity(
                        pos + lightDir * 38.0, sky, cloudBottom, cloudTop, biomeCloudScale, stormFactor, thunder
                    );
                    float opticalDepth = (d1 * 16.0 + d2 * 22.0) * extinction;

                    float multiScatter = exp(-opticalDepth) * phaseOrder0
                                       + 0.42 * exp(-opticalDepth * 0.32) * phaseOrder1
                                       + deepBleed * exp(-opticalDepth * 0.10);
                    float powder = 1.0 - exp(-opticalDepth * 2.0);
                    float powderMod = mix(1.0, 0.72 + 0.56 * powder, powderAngle);

                    float hNorm = clamp((pos.y - cloudBottom) * invBandHeight, 0.0, 1.0);
                    vec3 ambCol = mix(ambBase, ambTop, hNorm);
                    vec3 litCol = ambCol + directColor * (multiScatter * powderMod * mix(0.40, 1.06, hNorm));
                    // Subtle geomagnetic emerald-teal aurora bounce illuminating cloud undersides on clear nights
                    if (nightFactor > 0.05 && stormFactor < 0.65) {
                        float auroraBounce = nightFactor * (1.0 - stormFactor * 1.35) * (1.0 - hNorm) * 0.032;
                        litCol += vec3(0.10, 0.78, 0.56) * max(auroraBounce, 0.0);
                    }

                    // Localized intra-cloud sheet-lightning glow inside thick storm cells
                    if (thunder > 0.15 && density > 0.30) {
                        float flash = sv_cloudStormLightning(pos, sky.gameTimeSec, thunder);
                        litCol += vec3(0.70, 0.82, 1.05) * (flash * density * 0.85);
                    }

                    float stepTrans = exp(-density * extinction * stepSize);
                    voxelScattered += voxelTrans * litCol * (1.0 - stepTrans);
                    voxelTrans *= stepTrans;
                }
            }
        }
    }

    // Horizon fade dedicated to the voxel band (keeps distant horizon clean without dimming cirrus)
    float voxelHorizonFade = hitVoxelBand
        ? smoothstep(0.015, 0.14, abs(dir.y)) * (1.0 - smoothstep(950.0, 2200.0, tEnter))
        : 0.0;
    vec3 scattered = voxelScattered * voxelHorizonFade;
    float transmittance = mix(1.0, voxelTrans, voxelHorizonFade);

    // High-altitude cirrus veil at y = 540 with independent horizon fade and alpine twilight afterglow
    if (dir.y > 0.04 && cameraPos.y < 535.0 && transmittance > 0.05) {
        float tCirrus = (540.0 - cameraPos.y) / max(dir.y, 0.04);
        float cirrusHorizonFade = smoothstep(0.04, 0.18, dir.y) * (1.0 - smoothstep(2600.0, 4400.0, tCirrus));
        if (cirrusHorizonFade > 0.005) {
            vec2 cWorld = cameraPos.xz + dir.xz * min(tCirrus, 4400.0);
            vec2 cDrift = vec2(mod(sky.gameTimeSec * 0.0055, 512.0), mod(sky.gameTimeSec * 0.0018, 512.0));
            vec2 cUv = cWorld * vec2(0.00058, 0.00150) + cDrift;
            float warp = sv_cloudNoise2D(cUv * 1.40);
            vec2 cWarped = cUv + vec2(warp * 0.52, -warp * 0.32);
            float cFilament = sv_cloudNoise2D(cWarped) * 0.62
                            + sv_cloudNoise2D(cWarped * 2.4 + vec2(4.1, 2.3)) * 0.38;
            float cirrusMask = smoothstep(0.54, 0.88, cFilament);
            float cirrusAlpha = cirrusMask * 0.24 * cirrusHorizonFade * (1.0 - stormFactor * 0.72);

            // High-altitude ice crystals catch sunlight slightly longer at dusk/dawn (real alpine afterglow)
            float cirrusSunW = smoothstep(-0.14, 0.02, sunDir.y);
            float cirrusSunHalo = 0.78 + 0.48 * clamp(sv_cloudHgPhase(cosSun, 0.68) * 2.4, 0.0, 1.8);
            float cirrusMoonHalo = 0.82 + 0.36 * clamp(sv_cloudHgPhase(-cosSun, 0.55) * 2.0, 0.0, 1.4);
            vec3 cirrusSun = sv_cloudSolarTransmittance(sunDir.y + 0.035) * vec3(1.18, 1.10, 0.96) * (cirrusSunW * cirrusSunHalo);
            vec3 cirrusDirect = (cirrusSun + moonDirect * cirrusMoonHalo) * (1.0 - stormFactor * 0.60);
            vec3 cirrusTint = mix(ambTop * 1.18, cirrusDirect, 0.68);

            scattered += transmittance * cirrusTint * cirrusAlpha;
            transmittance *= (1.0 - cirrusAlpha * 0.42);
        }
    }

    // Clear-night geomagnetic Aurora Borealis composited strictly behind clouds (transmittance unchanged)
    if (nightFactor > 0.005 && transmittance > 0.03) {
        vec3 aurora = sv_cloudAuroraCurtains(dir, sky.gameTimeSec, nightFactor, stormFactor, moonDir);
        scattered += transmittance * aurora;
    }

    return vec4(max(scattered, vec3(0.0)), clamp(transmittance, 0.0, 1.0));
}
