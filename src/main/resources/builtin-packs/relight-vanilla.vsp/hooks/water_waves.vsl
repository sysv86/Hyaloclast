#include <vulkanshaders/v1/common.vsl>

// Sea-state index combining rainfall and thunderstorm squall energy
float sv_waterSeaState(float rain, float thunder) {
    return clamp(rain * 0.72 + thunder * 0.48, 0.0, 1.2);
}

// Two-mode incommensurate wave-group modulation (golden-ratio frequency pair)
// to model natural swell packets without visible periodic looping
float sv_waveGroupBreath(float timeSec, float seaState) {
    const float TAU = 6.28318530718;
    float p1 = mod(timeSec * 0.31, TAU);
    float p2 = mod(timeSec * 0.5016, TAU) + 1.17;
    float modDepth = 0.055 + 0.045 * seaState;
    return 1.0 + modDepth * (0.65 * sin(p1) + 0.35 * sin(p2));
}

// @hook(stage = "water_waves", priority = 100)
// ReLight Vanilla - Physically coupled sea-state wave displacement parameters.
// Grows amplitude and phase speed during storms while slightly lengthening dominant swells.
void sv_water_waves(inout float strength, inout float speed, inout float scale) {
    float rain = clamp(vsWorld.rain, 0.0, 1.0);
    float thunder = clamp(vsWorld.thunder, 0.0, 1.0);
    float seaState = sv_waterSeaState(rain, thunder);
    float breath = sv_waveGroupBreath(vsWorld.gameTimeSec, seaState);
    float userStrength = clamp(VS_PARAM_WATER_WAVE_STRENGTH, 0.0, 1.0);

    strength = userStrength * (0.92 + rain * 0.36 + thunder * 0.24) * breath;
    speed = 1.42 + rain * 0.58 + thunder * 0.34;
    scale = 2.12 - 0.34 * clamp(seaState, 0.0, 1.0);
}
