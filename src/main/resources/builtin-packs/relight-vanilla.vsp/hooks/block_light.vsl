#include <vulkanshaders/v1/common.vsl>

// Branch-free 3-band Planck blackbody radiation fit to CIE 1931 -> linear Rec.709 (1000K..14000K)
vec3 sv_blockPlanckLinear(float kelvin) {
    float k = max(kelvin, 900.0);
    vec3 c2 = vec3(20405.87, 24195.14, 30773.22);
    vec3 weights = vec3(1.0, 1.7284, 5.0545);
    vec3 rad = weights / max(exp(min(c2 / k, vec3(40.0))) - 1.0, vec3(1e-6));
    float peak = max(rad.r, max(rad.g, rad.b));
    return rad / max(peak, 1e-6);
}

// Smooth channel-preserving highlight knee above threshold to avoid wall washout near sources
vec3 sv_blockSoftKnee(vec3 color, float knee) {
    float peak = max(color.r, max(color.g, color.b));
    if (peak <= knee) {
        return color;
    }
    float excess = peak - knee;
    float compressed = knee + excess / (1.0 + excess * 2.2);
    return color * (compressed / max(peak, 1e-6));
}

// Low-frequency incommensurate turbulent flame breath (< 1.45 Hz, temporally stable in TAA/SVGF)
float sv_blockFlamePulse(float timeSec, float stormDraft) {
    const float TAU = 6.28318530718;
    float w1 = sin(mod(timeSec * 3.05, TAU));
    float w2 = sin(mod(timeSec * 4.94, TAU) + 1.3);
    float w3 = sin(mod(timeSec * 7.99, TAU) + 2.7);
    return (0.55 * w1 + 0.30 * w2 + 0.15 * w3) * (0.032 + 0.014 * stormDraft);
}

// @hook(stage = "block_light", priority = 10)
// ReLight Vanilla - Physically grounded 10-kind block & dynamic light spectral curves using
// Planckian blackbody radiation, Stefan-Boltzmann flicker-to-temperature coupling, dual-zone
// near-core/far-scatter color separation, Helmholtz-Kohlrausch luminance balance, and Beer-Lambert underwater shift.
void sv_block_light(inout vec3 radiance, in uint lightKind, in float dist) {
    const float TAU = 6.28318530718;

    float d = max(dist, 0.0);
    float d2 = d * d;

    // Smooth C-infinity dual-zone radial profiles (incandescent core -> warm mid -> atmospheric tail)
    float nearness = 1.0 / (1.0 + d2 * 0.135);
    float coreDen = 1.0 + d2 * 0.42;
    float hotCore = 1.0 / (coreDen * coreDen);
    float nearGainCurve = 1.0 / (1.0 + d2 * 0.095);
    float farTail = 1.0 - nearness;

    // Stefan-Boltzmann Kelvin shift from VS_PARAM_TORCH_INTENSITY without double-applying linear intensity
    float intensityParam = max(VS_PARAM_TORCH_INTENSITY, 0.1);
    float relPower = clamp(intensityParam / 1.15, 0.25, 2.20);
    float tempScale = sqrt(sqrt(sqrt(relPower)));

    // Anti-clipping headroom when torch intensity is raised above default 1.15
    float hiExcess = clamp((intensityParam - 1.15) / 1.35, 0.0, 1.0);
    float loDeficit = clamp((1.15 - intensityParam) / 0.85, 0.0, 1.0);

    float baseCoreBoost = 1.22;
    float ptTempCoupling = 0.75;
#ifdef VS_ACTIVE_RENDER_TIER
#if VS_ACTIVE_RENDER_TIER >= 3
    baseCoreBoost = 1.18;
    ptTempCoupling = 1.15;
#elif VS_ACTIVE_RENDER_TIER >= 2
    baseCoreBoost = 1.20;
    ptTempCoupling = 0.95;
#endif
#endif

    float timeSec = vsWorld.gameTimeSec;
    float rain = clamp(vsWorld.rain, 0.0, 1.0);
    float thunder = clamp(vsWorld.thunder, 0.0, 1.0);
    float stormDraft = clamp(rain * 0.60 + thunder * 0.45, 0.0, 1.0);

    // Damp modulation amplitude softly with distance while keeping phase uniform (no traveling rings)
    float flickerDamp = 0.64 + 0.36 * nearness;
    float flicker = 1.0;
    float targetBright = 0.90;
    vec3 tint = vec3(1.0);

    if (lightKind == 1u) {
        // Soul fire / soul lantern: CH* (431nm) + C2 Swan (473-516nm) chemiluminescence -> sapphire-cyan plasma core
        float w1 = sin(mod(timeSec * 2.55, TAU));
        float w2 = sin(mod(timeSec * 4.13, TAU) + 1.1);
        float pulse = (0.65 * w1 + 0.35 * w2) * (0.024 + 0.011 * stormDraft) * flickerDamp;
        flicker = 1.0 + pulse;

        vec3 outerSoul = vec3(0.06, 0.42, 0.98);
        vec3 midSoul   = vec3(0.18, 0.74, 1.00);
        vec3 coreSoul  = sv_blockPlanckLinear(11500.0 * tempScale * (1.0 + pulse * ptTempCoupling))
                       * vec3(0.88, 1.00, 1.06);
        tint = mix(mix(outerSoul, midSoul, nearness), coreSoul, hotCore * 0.78);
        targetBright = 0.88;
    } else if (lightKind == 2u) {
        // Lava / magma: silicate melt Planckian blackbody (1180K crust -> 1780K molten -> 2680K core)
        float w0 = sin(mod(timeSec * 0.37, TAU));
        float w1 = sin(mod(timeSec * 1.32, TAU));
        float w2 = sin(mod(timeSec * 2.14, TAU) + 0.8);
        float pulse = (0.48 * w0 + 0.36 * w1 + 0.16 * w2)
                    * (0.032 + 0.008 * stormDraft) * flickerDamp;
        flicker = 1.0 + pulse;

        float kelvin = mix(mix(1180.0, 1780.0, nearness), 2680.0, hotCore)
                     * tempScale * (1.0 + pulse * ptTempCoupling);
        tint = sv_blockPlanckLinear(kelvin);
        targetBright = 0.90;
    } else if (lightKind == 3u) {
        // Sea lantern / beacon / conduit: crisp marine aqua (490nm) -> clean pearl-cyan core
        float w1 = sin(mod(timeSec * 1.55, TAU));
        flicker = 1.0 + 0.005 * w1 * flickerDamp;

        vec3 outerSea = vec3(0.16, 0.78, 0.94);
        vec3 midSea   = vec3(0.45, 0.92, 0.99);
        vec3 coreSea  = vec3(0.78, 0.98, 1.00);
        tint = mix(mix(outerSea, midSea, nearness), coreSea, hotCore * 0.70);
        targetBright = 0.92;
    } else if (lightKind == 4u) {
        // Redstone torch / ore: narrowband 640nm ruby-crimson -> warm incandescent scarlet core
        float w1 = sin(mod(timeSec * 4.70, TAU));
        float w2 = sin(mod(timeSec * 7.61, TAU) + 0.5);
        flicker = 1.0 + (0.65 * w1 + 0.35 * w2) * 0.018 * flickerDamp;

        vec3 outerRed = vec3(0.96, 0.06, 0.04);
        vec3 midRed   = vec3(1.00, 0.18, 0.08);
        vec3 coreRed  = vec3(1.00, 0.42, 0.20);
        tint = mix(mix(outerRed, midRed, nearness), coreRed, hotCore * 0.74);
        targetBright = 0.78;
    } else if (lightKind == 5u) {
        // Glowstone / shroomlight / amber lantern: steady warm honey-mineral blackbody (2480K -> 4550K)
        float kelvin = mix(mix(2480.0, 3420.0, nearness), 4550.0, hotCore * 0.78) * tempScale;
        tint = sv_blockPlanckLinear(kelvin) * vec3(1.02, 0.97, 0.85);
        targetBright = 0.92;
    } else if (lightKind == 6u) {
        // End rod / amethyst: cool crystalline periwinkle-lavender -> starlight pearl core
        vec3 outerAmethyst = vec3(0.56, 0.48, 0.98);
        vec3 midAmethyst   = vec3(0.76, 0.70, 1.00);
        vec3 coreAmethyst  = vec3(0.92, 0.89, 1.00);
        tint = mix(mix(outerAmethyst, midAmethyst, nearness), coreAmethyst, hotCore * 0.70);
        targetBright = 0.90;
    } else if (lightKind == 7u) {
        // Sculk / deep dark: abyssal marine-teal bioluminescence with slow asymmetric organic breath
        float phase = mod(timeSec * 1.88, TAU);
        float breath01 = 0.5 + 0.5 * sin(phase);
        float asymBreath = breath01 * sqrt(max(breath01, 1e-4));
        flicker = 0.93 + 0.12 * asymBreath * flickerDamp;

        vec3 outerSculk = vec3(0.03, 0.42, 0.50);
        vec3 midSculk   = vec3(0.08, 0.74, 0.78);
        vec3 coreSculk  = vec3(0.32, 0.94, 0.96);
        tint = mix(mix(outerSculk, midSculk, nearness), coreSculk, hotCore * 0.74);
        targetBright = 0.70;
    } else if (lightKind == 8u) {
        // Copper bulb / emerald / ender flame: Cu(II) 525nm verdigris-emerald -> luminous jade-mint core
        float w1 = sin(mod(timeSec * 2.05, TAU));
        flicker = 1.0 + 0.008 * w1 * flickerDamp;

        vec3 outerCopper = vec3(0.08, 0.76, 0.40);
        vec3 midCopper   = vec3(0.24, 0.94, 0.58);
        vec3 coreCopper  = vec3(0.58, 1.00, 0.78);
        tint = mix(mix(outerCopper, midCopper, nearness), coreCopper, hotCore * 0.70);
        targetBright = 0.86;
    } else if (lightKind == 9u) {
        // Arcane magenta / enchanted violet: dual-band violet+crimson -> luminous royal-orchid core
        float w1 = sin(mod(timeSec * 2.35, TAU));
        float w2 = sin(mod(timeSec * 3.80, TAU) + 1.4);
        flicker = 1.0 + (0.70 * w1 + 0.30 * w2) * 0.016 * flickerDamp;

        vec3 outerArcane = vec3(0.62, 0.14, 0.96);
        vec3 midArcane   = vec3(0.84, 0.34, 1.00);
        vec3 coreArcane  = vec3(0.95, 0.62, 1.00);
        tint = mix(mix(outerArcane, midArcane, nearness), coreArcane, hotCore * 0.72);
        targetBright = 0.84;
    } else {
        // Default (0u): Torch / lantern / campfire - Planckian hearth firelight (1960K amber tail -> 2780K -> 3950K core)
        float pulse = sv_blockFlamePulse(timeSec, stormDraft) * flickerDamp;
        flicker = 1.0 + pulse;

        float kelvin = mix(mix(1960.0, 2780.0, nearness), 3950.0, hotCore * 0.80)
                     * tempScale * (1.0 + pulse * ptTempCoupling);
        tint = sv_blockPlanckLinear(kelvin);
        // Subtle warm atmospheric extinction in the far falloff tail
        tint *= mix(vec3(1.0), vec3(1.04, 0.94, 0.84), farTail * 0.35);
        targetBright = 0.92;
    }

    // Helmholtz-Kohlrausch perceptual brightness balance across all 10 spectral light kinds
    float lum = vsLuminance(tint);
    float peak = max(tint.r, max(tint.g, tint.b));
    float hkBright = mix(lum, peak, 0.58);
    tint *= targetBright / max(hkBright, 0.08);

    // Underwater Beer-Lambert spectral attenuation (eyeInFluid == 1 only; excludes air=0 and lava=2)
    float eif = float(vsWorld.eyeInFluid);
    float eyeInWater = clamp(eif, 0.0, 1.0) * step(eif, 1.5);
    if (eyeInWater > 0.5) {
        float waterPath = min(d, 7.0);
        vec3 beer = exp(-vec3(0.18, 0.036, 0.012) * waterPath);
        tint = mix(tint, tint * beer, 0.68);
    }

    float coreBoost = baseCoreBoost - 0.10 * hiExcess + 0.05 * loDeficit;
    float gain = mix(0.95, coreBoost, nearGainCurve) * flicker;
    vec3 shaped = sv_blockSoftKnee(tint * gain, 1.12);

    if (dot(radiance, radiance) <= 1e-6) {
        radiance = shaped;
    } else {
        radiance *= shaped;
    }
}
