#version 460

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D uNoisyColor;
layout(set = 0, binding = 1) uniform sampler2D uNormalRoughness;
layout(set = 0, binding = 2) uniform sampler2D uLinearDepth;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D uFilteredColor;
layout(set = 0, binding = 4) uniform sampler2D gAlbedo;
#if VS_ACTIVE_RENDER_TIER >= 2
layout(set = 0, binding = 5) uniform sampler2D uSharpRadiance;
#endif

layout(push_constant) uniform AtrousPush {
    int stepSize;
    float phiColor;
    float phiNormal;
    float phiDepth;
} pc;

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

float filterDepth(ivec2 p) {
    float depth = texelFetch(uLinearDepth, p, 0).r;
#if VS_ACTIVE_RENDER_TIER == 3
    return (depth > 0.0 && depth < 65536.0) ? depth : 0.0;
#else
    return depth > 1e-6 ? 0.05 / depth : 0.0;
#endif
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uFilteredColor);
    if (any(greaterThanEqual(p, size))) return;

    vec4 guide = texelFetch(uNormalRoughness, p, 0);
#if VS_ACTIVE_RENDER_TIER >= 2
    vec4 sharp = texelFetch(uSharpRadiance, p, 0);
#if VS_ACTIVE_RENDER_TIER == 2
    bool isWaterPixel = sharp.a > 0.5;
#else
    bool isWaterPixel = guide.a > 1.0;
#endif
    if (isWaterPixel) {
        imageStore(uFilteredColor, p, vec4(pc.stepSize <= 0 ? sharp.rgb : vec3(0.0), 1.0));
        return;
    }
#endif
    float depth = filterDepth(p);
    vec3 center = texelFetch(uNoisyColor, p, 0).rgb;
    if (depth == 0.0) {
        imageStore(uFilteredColor, p, vec4(center, 1.0));
        return;
    }

    int stride = pc.stepSize > 0 ? pc.stepSize : 8;
    float phiColor = pc.phiColor > 1e-4 ? pc.phiColor : 4.0;
    float phiNormal = pc.phiNormal > 1e-4 ? pc.phiNormal : 16.0;
    float phiDepth = pc.phiDepth > 1e-4 ? pc.phiDepth : 1.0;

    vec3 rawGuideN = guide.xyz * 2.0 - 1.0;
    vec3 normal = dot(rawGuideN, rawGuideN) > 1e-6 ? normalize(rawGuideN) : vec3(0.0, 1.0, 0.0);
    float centerLuma = dot(center, LUMA);
    float depthDenom = max(phiDepth * 0.014 * depth, 0.015);
    float normalExp = clamp(phiNormal, 2.0, 128.0);

    // Gather 8-tap a-trous neighborhood once and compute local luminance variance inline.
    vec3 tapColors[8];
    float tapLumas[8];
    float tapGeoWeights[8];
    int tapCount = 0;

    float sumL = centerLuma;
    float sumL2 = centerLuma * centerLuma;
    float lumaCount = 1.0;

    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            if (x == 0 && y == 0) continue;
            ivec2 q = p + ivec2(x, y) * stride;
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size))) continue;
            vec4 other = texelFetch(uNormalRoughness, q, 0);
#if VS_ACTIVE_RENDER_TIER >= 2
#if VS_ACTIVE_RENDER_TIER == 2
            if (texelFetch(uSharpRadiance, q, 0).a > 0.5) continue;
#else
            if (other.a > 1.0) continue;
#endif
#endif
            float otherDepth = filterDepth(q);
            if (otherDepth == 0.0) continue;
            vec3 rawOtherN = other.xyz * 2.0 - 1.0;
            vec3 otherN = dot(rawOtherN, rawOtherN) > 1e-6 ? normalize(rawOtherN) : normal;
            float alignment = max(dot(normal, otherN), 0.0);
            if (alignment < 0.80 || abs(guide.w - other.w) > 0.15) continue;

            vec3 value = texelFetch(uNoisyColor, q, 0).rgb;
            float tapLuma = dot(value, LUMA);
            sumL += tapLuma;
            sumL2 += tapLuma * tapLuma;
            lumaCount += 1.0;

            float wDepth = exp(-abs(depth - otherDepth) / depthDenom);
            float wNormal = pow(alignment, normalExp);
            float wKernel = (x == 0 || y == 0) ? 0.70 : 0.42;
            tapColors[tapCount] = value;
            tapLumas[tapCount] = tapLuma;
            tapGeoWeights[tapCount] = wDepth * wNormal * wKernel;
            ++tapCount;
        }
    }

    float meanL = sumL / lumaCount;
    float sigmaL = sqrt(max(sumL2 / lumaCount - meanL * meanL, 0.0));
    float colorDenom = max(phiColor * (sigmaL + 0.06) + centerLuma * 0.18, 0.04);

    vec3 sum = center;
    float totalWeight = 1.0;
    for (int i = 0; i < tapCount; ++i) {
        float wColor = exp(-abs(centerLuma - tapLumas[i]) / colorDenom);
        float w = tapGeoWeights[i] * wColor;
        sum += tapColors[i] * w;
        totalWeight += w;
    }

    vec3 filtered = sum / totalWeight;
    if (pc.stepSize <= 0) {
        // uNoisyColor is the temporal output, which stores DEMODULATED diffuse (raw minus
        // sharp, divided by albedo) and omits sharp entirely: remultiply albedo and add
        // sharp back here or the image loses albedo tint and all specular reflections.
#if defined(VS_ACTIVE_RENDER_TIER) && (VS_ACTIVE_RENDER_TIER >= 3)
        vec3 albedo = max(texelFetch(gAlbedo, p, 0).rgb, vec3(0.0));
#else
        vec3 albedo = pow(max(texelFetch(gAlbedo, p, 0).rgb, vec3(0.0)), vec3(2.2));
#endif
        filtered = filtered * max(albedo, vec3(0.035));
#if VS_ACTIVE_RENDER_TIER >= 2
        filtered += sharp.rgb;
#endif
    }
    imageStore(uFilteredColor, p, vec4(filtered, 1.0));
}
