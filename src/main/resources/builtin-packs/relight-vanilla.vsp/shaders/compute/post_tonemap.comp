#version 460

#include <vulkanshaders/v1/common.vsl>
#include <vulkanshaders/v1/restir.vsl>

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 1) uniform sampler2D uWorldHdr;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D uOutSrgb;
layout(set = 0, binding = 3) uniform sampler2D uActiveAlbedo;
layout(set = 0, binding = 4) uniform sampler2D uGbufferNormal;
layout(set = 0, binding = 5) uniform sampler2D uGbufferMaterial;
layout(set = 0, binding = 6) uniform sampler2D uVelocity;
layout(set = 0, binding = 7) uniform sampler2D uActiveDepth;
layout(set = 0, binding = 8) uniform sampler2D uRawRadiance;
layout(set = 0, binding = 9) uniform sampler2D uSharpRadiance;
layout(set = 0, binding = 10) uniform sampler2D uSvgfMoments;

#if VS_ACTIVE_RENDER_TIER >= 2
layout(std140, set = 1, binding = 2) uniform SharcConfigUBO {
    SharcConfig cfg;
} uSharcDebug;
layout(set = 1, binding = 3, std430) readonly buffer EmissiveLightSSBO {
    uvec4 header;
    VsEmissiveLight lights[];
} uEmissiveLightsDebug;
layout(set = 1, binding = 4, std430) readonly buffer RestirReservoirSSBO {
    VsRestirReservoir cells[];
} uRestirDebug;

layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer VsPostSharcHashTable {
    uint64_t keys[];
};
struct VsPostSharcResolvedVoxel {
    vec3 radiance;
    float sampleWeight;
    uint age;
    uint pad0;
    uint pad1;
    uint pad2;
};
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer VsPostSharcResolvedTable {
    VsPostSharcResolvedVoxel voxels[];
};

vec3 sampleSharcDebug(vec2 uv) {
    uint capacity = uSharcDebug.cfg.capacity;
    uint64_t hashAddress = vsPackU64(uSharcDebug.cfg.hashEntriesAddress);
    uint64_t resolvedAddress = vsPackU64(uSharcDebug.cfg.resolvedAddress);
    if (capacity == 0u || hashAddress == 0ul || resolvedAddress == 0ul) {
        return vec3(0.0);
    }
    uint slot = min(uint(uv.y * float(textureSize(uWorldHdr, 0).y))
        * uint(textureSize(uWorldHdr, 0).x) + uint(uv.x * float(textureSize(uWorldHdr, 0).x)), capacity - 1u);
    VsPostSharcHashTable hashTable = VsPostSharcHashTable(hashAddress);
    uint64_t key = hashTable.keys[slot];
    if (key == 0ul || key == 0xFFFFFFFFFFFFFFFFul) {
        return vec3(0.015, 0.020, 0.030);
    }
    VsPostSharcResolvedTable resolvedTable = VsPostSharcResolvedTable(resolvedAddress);
    VsPostSharcResolvedVoxel voxel = resolvedTable.voxels[slot];
    float support = clamp(voxel.sampleWeight / 24.0, 0.0, 1.0);
    float freshness = exp(-float(voxel.age) * 0.08);
    return mix(vec3(0.04, 0.12, 0.18), vec3(0.18, 0.85, 0.35), support * freshness);
}

vec3 sampleRestirDebug(vec2 uv) {
    uint count = uEmissiveLightsDebug.header.x;
    uvec2 dimensions = max(uEmissiveLightsDebug.header.yz, uvec2(1u));
    uvec2 cell = min(uvec2(uv * vec2(dimensions)), dimensions - uvec2(1u));
    uint totalCells = dimensions.x * dimensions.y;
    uint bank = (uEmissiveLightsDebug.header.w & 1u) * totalCells;
    uint index = bank + cell.y * dimensions.x + cell.x;
    if (index >= uint(uRestirDebug.cells.length())) {
        return vec3(0.0);
    }
    VsRestirReservoir reservoir = uRestirDebug.cells[index];
    if (reservoir.selectedLight >= count || reservoir.M <= 0.0) {
        return vec3(0.0);
    }
    float hue = fract(sin(float(reservoir.selectedLight + 1u) * 12.9898) * 43758.5453);
    vec3 lightColor = 0.5 + 0.5 * cos(6.2831853 * (hue + vec3(0.0, 0.3333, 0.6667)));
    float confidence = clamp(0.25 + log2(1.0 + reservoir.M) * 0.15, 0.25, 1.0);
    return lightColor * confidence;
}
#endif

// Restrained, non-glowstick bloom threshold and soft knee:
// Gives sun corona, torches, lanterns, and magma a wide, soft optical halo without harsh fringes.
const float BLOOM_THRESHOLD = 1.08;
const float BLOOM_KNEE = 0.65;
const float BLOOM_TEXEL_LIMIT = 7.0;

vec3 evaluateBloomWeight(vec3 s) {
    if (any(isnan(s)) || any(isinf(s))) {
        return vec3(0.0);
    }
    s = clamp(s, vec3(0.0), vec3(BLOOM_TEXEL_LIMIT));
    float luma = dot(s, vec3(0.2126, 0.7152, 0.0722));
    float soft = clamp(luma - BLOOM_THRESHOLD + BLOOM_KNEE, 0.0, 2.0 * BLOOM_KNEE);
    soft = (soft * soft) / (4.0 * BLOOM_KNEE + 1e-4);
    float contrib = max(soft, luma - BLOOM_THRESHOLD) / max(luma, 1e-4);
    float karis = 1.0 / (1.0 + luma * 0.40);
    return s * (contrib * karis);
}

vec3 extractSoftBloomTap(vec2 uv) {
    vec3 s = textureLod(uWorldHdr, clamp(uv, vec2(0.0), vec2(1.0)), 0.0).rgb;
    return evaluateBloomWeight(max(s, vec3(0.0)));
}

// 3-ring Karis-weighted optical halo (1.8px, 4.5px, 9.5px) for smooth wide glow.
vec3 sampleKarisTentBloom(vec2 uv, vec2 texelSize, vec3 centerHdr) {
    vec2 r1 = texelSize * 1.8;
    vec2 r2 = texelSize * 4.5;
    vec2 r3 = texelSize * 9.5;
    vec3 c0 = evaluateBloomWeight(centerHdr) * 0.16;

    vec3 ring1 = (
        extractSoftBloomTap(uv + vec2( r1.x,  r1.y)) +
        extractSoftBloomTap(uv + vec2(-r1.x,  r1.y)) +
        extractSoftBloomTap(uv + vec2( r1.x, -r1.y)) +
        extractSoftBloomTap(uv + vec2(-r1.x, -r1.y))
    ) * 0.095;

    vec3 ring2 = (
        extractSoftBloomTap(uv + vec2( r2.x,  0.0)) +
        extractSoftBloomTap(uv + vec2(-r2.x,  0.0)) +
        extractSoftBloomTap(uv + vec2( 0.0,  r2.y)) +
        extractSoftBloomTap(uv + vec2( 0.0, -r2.y))
    ) * 0.070;

    vec3 ring3 = (
        extractSoftBloomTap(uv + vec2( r3.x,  r3.y) * 0.7071) +
        extractSoftBloomTap(uv + vec2(-r3.x,  r3.y) * 0.7071) +
        extractSoftBloomTap(uv + vec2( r3.x, -r3.y) * 0.7071) +
        extractSoftBloomTap(uv + vec2(-r3.x, -r3.y) * 0.7071)
    ) * 0.045;

    return c0 + ring1 + ring2 + ring3;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 res = imageSize(uOutSrgb);
    if (px.x >= res.x || px.y >= res.y) {
        return;
    }

    vec2 texelSize = 1.0 / vec2(res);
    vec2 uv = (vec2(px) + 0.5) * texelSize;

    vec3 hdr = textureLod(uWorldHdr, uv, 0.0).rgb;
    if (any(isnan(hdr)) || any(isinf(hdr))) {
        hdr = vec3(0.0);
    }
    hdr = max(hdr, vec3(0.0));

    int debugView = int(VS_PARAM_DEBUG_VIEW + 0.5);
    if (debugView > 0) {
        vec4 albedo = textureLod(uActiveAlbedo, uv, 0.0);
        vec4 normalRough = textureLod(uGbufferNormal, uv, 0.0);
        vec4 material = textureLod(uGbufferMaterial, uv, 0.0);
        vec2 motion = textureLod(uVelocity, uv, 0.0).rg;
        float depth = textureLod(uActiveDepth, uv, 0.0).r;
        vec3 rawRadiance = textureLod(uRawRadiance, uv, 0.0).rgb;
        vec3 sharpRadiance = textureLod(uSharpRadiance, uv, 0.0).rgb;
        vec3 debugColor = vec3(0.0);
        if (debugView == 1) {
            debugColor = hdr;
        } else if (debugView == 2) {
            debugColor = pow(max(albedo.rgb, vec3(0.0)), vec3(1.0 / 2.2));
        } else if (debugView == 3) {
            debugColor = normalRough.rgb;
        } else if (debugView == 4) {
            vec3 worldNormal = normalRough.rgb * 2.0 - 1.0;
            debugColor = dot(worldNormal, worldNormal) > 1e-4
                ? normalize(worldNormal) * 0.5 + 0.5
                : vec3(0.5);
        } else if (debugView == 5) {
            float roughness = normalRough.a > 1.0 ? normalRough.a - 1.0 : normalRough.a;
            debugColor = vec3(clamp(roughness, 0.0, 1.0));
        } else if (debugView == 6) {
            debugColor = vec3(clamp(material.r, 0.0, 1.0));
        } else if (debugView == 7) {
            debugColor = vec3(clamp(material.g * 4.0, 0.0, 1.0));
        } else if (debugView == 8) {
            debugColor = clamp(material.rgb, vec3(0.0), vec3(1.0));
        } else if (debugView == 9) {
            debugColor = vec3(clamp(1.0 - exp(-max(depth, 0.0) * 0.025), 0.0, 1.0));
        } else if (debugView == 10) {
            debugColor = vec3(clamp(motion * 0.05 + 0.5, 0.0, 1.0), 0.5);
        } else if (debugView == 11) {
            debugColor = rawRadiance;
        } else if (debugView == 12) {
            debugColor = sharpRadiance;
        } else if (debugView == 13) {
#if VS_ACTIVE_RENDER_TIER >= 2
            debugColor = sampleSharcDebug(uv);
#endif
        } else if (debugView == 14) {
#if VS_ACTIVE_RENDER_TIER >= 2
            debugColor = sampleRestirDebug(uv);
#endif
        } else if (debugView == 15) {
            vec2 moments = textureLod(uSvgfMoments, uv, 0.0).rg;
            float variance = max(moments.y - moments.x * moments.x, 0.0);
            debugColor = vec3(clamp(log2(1.0 + variance * 32.0) * 0.2, 0.0, 1.0));
        }
        vec3 debugSrgb = pow(clamp(debugColor, 0.0, 1.0), vec3(1.0 / 2.2));
        imageStore(uOutSrgb, px, vec4(debugSrgb, 1.0));
        return;
    }

    // Time-of-day & dimension exposure curve:
    // crisp sunlit daylight, luminous golden hour, readable starry nights, atmospheric Nether & End.
    int dimId = vsDimensionId();
    float sunElevation = clamp(vsWorld.sunDir.y, -1.0, 1.0);
    float dayFactor = (dimId == 0) ? smoothstep(-0.10, 0.22, sunElevation) : 0.0;
    float goldenFactor = (dimId == 0)
        ? smoothstep(-0.10, 0.05, sunElevation) * (1.0 - smoothstep(0.12, 0.34, sunElevation))
        : 0.0;
    float adaptiveExposure = (dimId == 1)
        ? 1.14
        : (dimId == 2)
            ? 1.26
            : (mix(1.28, 0.99, dayFactor) + goldenFactor * 0.06) * (1.0 + vsWorld.rain * 0.10);

    // Soft optical bloom: warm lantern/star presence at night & golden hour, luminous glints at noon
    float bloomIntensity = mix(0.095, 0.052, dayFactor) + goldenFactor * 0.024;
    hdr += sampleKarisTentBloom(uv, texelSize, hdr) * bloomIntensity;

    uint mode = uint(clamp(VS_PARAM_TONE_MAPPING + 0.5, 0.0, 2.0));
    VsPostContext postCtx = VsPostContext(adaptiveExposure, bloomIntensity, mode);
    vs_dispatch_hook_post_grade(hdr, uv, postCtx);

    vec3 srgb = pow(clamp(hdr, 0.0, 1.0), vec3(1.0 / 2.2));
    imageStore(uOutSrgb, px, vec4(srgb, 1.0));
}
