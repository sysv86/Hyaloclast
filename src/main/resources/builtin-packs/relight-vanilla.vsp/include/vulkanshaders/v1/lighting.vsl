#ifndef VULKANSHADERS_V1_LIGHTING_VSL
#define VULKANSHADERS_V1_LIGHTING_VSL

#include <vulkanshaders/v1/common.vsl>
#include <vulkanshaders/v1/restir.vsl>

// Obsidian Meridian (Hyaloclast) lighting, optics, rain wetness, caustics, LabPBR, and SHaRC primitives.
// Tier 0/1: CSM / SSGI; Tier 2/3: RayQuery / Hardware Path Tracing + SHaRC + ReSTIR DI.

#ifdef VS_HIGH_END_GPU
const float VS_FROXEL_MAX_DIST = 224.0;
#else
const float VS_FROXEL_MAX_DIST = 144.0;
#endif

vec4 vsSampleFroxelFog(sampler2DArray fog, vec2 uv, float distanceToCamera) {
    if (distanceToCamera <= 12.0) {
        return vec4(0.0, 0.0, 0.0, 1.0);
    }
    int layerCount = max(textureSize(fog, 0).z, 1);
    float depth01 = log(clamp(distanceToCamera, 12.0, VS_FROXEL_MAX_DIST) / 12.0)
        / log(VS_FROXEL_MAX_DIST / 12.0);
    float layerPosition = depth01 * float(layerCount) - 1.0;
    int layer0 = clamp(int(floor(layerPosition)), 0, layerCount - 1);
    int layer1 = min(layer0 + 1, layerCount - 1);
    float blend = clamp(layerPosition - float(layer0), 0.0, 1.0);
    vec4 a = textureLod(fog, vec3(uv, float(layer0)), 0.0);
    vec4 b = textureLod(fog, vec3(uv, float(layer1)), 0.0);
    return mix(a, b, blend);
}

float vsTraceShadow(vec3 worldPos, vec3 normal, vec3 lightDir, float coneRadius) {
    float ndotl = max(dot(normal, lightDir), 0.0);
    float bias = clamp(coneRadius * 0.5, 0.01, 0.15);
    return smoothstep(0.0, 0.15 + bias, ndotl);
}

vec3 vsTraceReflection(vec3 worldPos, vec3 normal, vec3 viewDir, float roughness) {
    vec3 refl = reflect(-viewDir, normal);
    float up = clamp(refl.y, 0.0, 1.0);
    float horizon = pow(1.0 - up, 2.6);
    vec3 zenithCol = vec3(0.16, 0.38, 0.78);
    vec3 horizonCol = vec3(0.56, 0.72, 0.92);
    vec3 groundCol = vec3(0.14, 0.16, 0.19);
    vec3 skyEnv = mix(zenithCol, horizonCol, horizon);
    skyEnv = mix(groundCol, skyEnv, smoothstep(-0.20, 0.06, refl.y));
    return skyEnv * (1.0 - roughness * 0.72);
}

vec3 vsSampleIndirectGI(vec3 worldPos, vec3 normal, vec3 albedo) {
    float skyFactor = clamp(normal.y * 0.5 + 0.5, 0.12, 1.0);
    vec3 groundBounce = vec3(0.10, 0.105, 0.115);
    vec3 skyBounce = vec3(0.22, 0.30, 0.44);
    return albedo * mix(groundBounce, skyBounce, skyFactor);
}

vec3 vsWaterHalfSpace(vec3 direction, vec3 normal) {
    return normalize(direction + normal * max(0.005 - dot(direction, normal), 0.0));
}

vec3 vsWaterReflection(vec3 incident, vec3 waveNormal, vec3 geometryNormal) {
    vec3 reflected = reflect(incident, waveNormal);
    float waveWeight = smoothstep(0.0, 0.12, dot(reflected, geometryNormal));
    return normalize(mix(reflect(incident, geometryNormal), reflected, waveWeight));
}

float vsWaterOptics(vec3 incident, vec3 waveNormal, vec3 geometryNormal, bool submerged,
                    out vec3 transmission) {
    float eta = submerged ? 1.333 : (1.0 / 1.333);
    vec3 refracted = refract(incident, waveNormal, eta);
    if (dot(refracted, refracted) < 1e-6) {
        transmission = vec3(0.0);
        return 1.0;
    }

    float cosIncident = max(0.001, dot(-incident, waveNormal));
    float cosTransmitted = max(0.001, dot(-refracted, waveNormal));
    float s = (eta * cosIncident - cosTransmitted) / (eta * cosIncident + cosTransmitted);
    float p = (cosIncident - eta * cosTransmitted) / (cosIncident + eta * cosTransmitted);
    transmission = vsWaterHalfSpace(refracted, -geometryNormal);
    return 0.5 * (s * s + p * p);
}

vec3 vsWaterTint(vec3 biomeColor, float skyLight, float daylight) {
    // Realistic turquoise-to-cobalt volume scatter gently harmonized with Minecraft biome water tint
    vec3 deepCobalt = vec3(0.006, 0.048, 0.088);
    vec3 shallowTurquoise = vec3(0.012, 0.072, 0.095);
    vec3 baseScatter = mix(deepCobalt, shallowTurquoise, clamp(daylight, 0.0, 1.0))
        + biomeColor * vec3(0.048, 0.092, 0.098);
    return baseScatter * mix(0.065, 1.0, clamp(skyLight * mix(0.18, 1.0, daylight), 0.0, 1.0));
}

vec3 vsWaterTransmission(vec3 radiance, vec3 tint, float distanceInWater) {
    // Beer-Lambert wavelength-dependent optical absorption: red attenuates rapidly,
    // preserving crystal turquoise shallows and rich cobalt-teal depths.
    vec3 transmittance = exp(-max(distanceInWater, 0.0) * vec3(0.35, 0.092, 0.048));
    return mix(tint, radiance, transmittance);
}

float vsWaterCausticPattern(vec2 proj, float t) {
    vec2 p1 = proj * 0.92 + vec2(t * 0.30, -t * 0.19);
    vec2 p2 = (proj * 1.38) * mat2(0.80, -0.60, 0.60, 0.80) + vec2(-t * 0.26, t * 0.34);
    vec2 p3 = (proj * 2.15) * mat2(0.60, 0.80, -0.80, 0.60) + vec2(t * 0.22, t * 0.17);

    float w1 = abs(sin(p1.x + sin(p1.y * 1.25 + t * 0.65)) + cos(p1.y + cos(p1.x * 1.18 - t * 0.48)));
    float w2 = abs(sin(p2.x - cos(p2.y * 1.12 - t * 0.58)) + cos(p2.y + sin(p2.x * 1.34 + t * 0.72)));
    float w3 = abs(sin(p3.x + cos(p3.y * 1.08 + t * 0.90)) + cos(p3.y - sin(p3.x * 1.10 - t * 0.75)));

    float primaryRidge = pow(clamp(1.0 - min(w1, w2) * 0.54, 0.0, 1.0), 3.4);
    float fineNet = pow(clamp(1.0 - w3 * 0.50, 0.0, 1.0), 2.8) * 0.35;
    return clamp(primaryRidge * 0.68 + fineNet * 0.24, 0.0, 1.0);
}

// Dual-layer interfering shallow-water refractive caustics projected along sun direction
float vsWaterCaustics(vec3 worldPosAbs, vec3 sunDir, float timeSec) {
    vec2 proj = worldPosAbs.xz - sunDir.xz * (worldPosAbs.y / max(sunDir.y, 0.25));
    return vsWaterCausticPattern(proj, timeSec * 1.12);
}

// Subtle RGB chromatic dispersion caustics for crisp sunlit shallow water
vec3 vsWaterCausticsRgb(vec3 worldPosAbs, vec3 sunDir, float timeSec) {
    vec2 proj = worldPosAbs.xz - sunDir.xz * (worldPosAbs.y / max(sunDir.y, 0.25));
    float t = timeSec * 1.12;
    vec2 disp = vec2(0.032, -0.022);
    float cR = vsWaterCausticPattern(proj + disp, t);
    float cG = vsWaterCausticPattern(proj, t);
    float cB = vsWaterCausticPattern(proj - disp, t);
    return vec3(cR, cG, cB);
}

// Smooth transition from analytic RT point lights (scanned within 24 blocks) to vanilla blocklight fallback
float vsBlockLightFallback(vec3 cameraRelativePosition) {
    vec3 distance = abs(cameraRelativePosition);
    return smoothstep(17.0, 23.0, max(distance.x, max(distance.y, distance.z)));
}

vec3 vsFaceWaterNormal(vec3 normal, vec3 viewDir) {
    return normalize(normal + viewDir * max(0.01 - dot(normal, viewDir), 0.0));
}

// Natural multi-frequency world-space rain puddle distribution (prevents uniform wet-plastic coating)
float vsRainPuddleMask(vec3 worldPosAbs, vec3 normal, float skyLight, float rain, float wetnessParam) {
    if (rain <= 0.01 || skyLight < 0.72 || wetnessParam <= 0.01) {
        return 0.0;
    }
    float upMask = smoothstep(0.55, 0.92, normal.y);
    float skyMask = smoothstep(0.72, 0.95, skyLight);
    vec2 p = worldPosAbs.xz * 0.14;
    vec2 warp = vec2(
        sin(p.y * 1.35 + cos(p.x * 0.92)),
        cos(p.x * 1.28 - sin(p.y * 1.04))
    ) * 0.45;
    vec2 pw = p + warp;
    float coarse = sin(pw.x * 1.65 + sin(pw.y * 1.22)) * 0.5
                 + cos(pw.y * 1.95 - cos(pw.x * 1.78)) * 0.5;
    float fine = sin(pw.x * 4.30 - pw.y * 3.10) * 0.25
               + cos(pw.y * 3.85 + pw.x * 2.95) * 0.25;
    float puddle = smoothstep(-0.12, 0.62, coarse * 0.78 + fine * 0.22);
    return upMask * skyMask * rain * wetnessParam * mix(0.24, 1.0, puddle);
}

void vsApplyRainWetness(
    inout VsSurface s,
    vec3 worldPosAbs,
    float skyLight,
    float rain,
    float wetnessParam,
    float porosity
) {
    float wet = vsRainPuddleMask(worldPosAbs, s.normal, skyLight, rain, wetnessParam);
    if (wet <= 0.001) return;
    float p = clamp(porosity, 0.0, 1.0);
    // Physically grounded porous darkening driven by LabPBR porosity + puddle specular smoothing
    s.albedo *= mix(1.0, mix(0.88, 0.56, p), wet * (1.0 - s.metallic));
    s.roughness = mix(s.roughness, min(s.roughness, mix(0.08, 0.22, p * 0.5)), wet * 0.84);
    s.f0 = mix(s.f0, 0.02, wet * (1.0 - s.metallic));
}

void vsApplyRainWetness(inout VsSurface s, vec3 worldPosAbs, float skyLight, float rain, float wetnessParam) {
    float fallbackPorosity = smoothstep(0.35, 0.85, s.roughness);
    vsApplyRainWetness(s, worldPosAbs, skyLight, rain, wetnessParam, fallbackPorosity);
}

vec3 evaluateCookTorrance(
    vec3 albedo,
    vec3 N,
    vec3 V,
    vec3 L,
    float roughness,
    float metallic,
    float f0
) {
    float NoV = max(dot(N, V), 1e-4);
    float NoL = max(dot(N, L), 0.0);
    if (NoL <= 0.0) {
        return vec3(0.0);
    }
    vec3 Hsum = V + L;
    vec3 H = dot(Hsum, Hsum) > 1e-8 ? normalize(Hsum) : N;
    float NoH = max(dot(N, H), 0.0);
    float VoH = max(dot(V, H), 0.0);

    float a = max(roughness * roughness, 0.002);
    float a2 = a * a;
    float denom = (NoH * NoH * (a2 - 1.0) + 1.0);
    float D = a2 / max(3.14159265 * denom * denom, 1e-6);

    float k = (roughness + 1.0);
    k = (k * k) * 0.125;
    float Gv = NoV / (NoV * (1.0 - k) + k);
    float Gl = NoL / (NoL * (1.0 - k) + k);
    float G = Gv * Gl;

    vec3 F0 = mix(vec3(f0), albedo, metallic);
    vec3 F = F0 + (vec3(1.0) - F0) * pow(clamp(1.0 - VoH, 0.0, 1.0), 5.0);

    // Restrain grazing-angle specular energy on matte dielectrics to prevent plastic glare
    float roughSpecDamp = mix(1.0, 0.38, smoothstep(0.62, 0.96, roughness) * (1.0 - metallic));
    vec3 spec = ((D * G * F) / max(4.0 * NoV * NoL, 1e-5)) * roughSpecDamp;
    vec3 kD = (vec3(1.0) - F) * (1.0 - metallic);
    vec3 diff = kD * albedo * (1.0 / 3.14159265);
    return (diff + spec) * NoL;
}

// --- PCG RNG & Orthonormal Basis / Importance Sampling ---

uint vsPcgHash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

uint vsReservoirTag(VsEmissiveLight light, vec3 cameraPosition, uint frameIndex) {
    uvec3 block = uvec3(ivec3(floor(light.posRadius.xyz + cameraPosition)));
    uint hash = block.x * 73856093u ^ block.y * 19349663u ^ block.z * 83492791u;
    return vsPcgHash(hash) ^ frameIndex;
}

VsSurface vsWaterGlintSurface(VsSurface water) {
    water.albedo = vec3(0.0);
    water.roughness = max(water.roughness, 0.16);
    water.f0 = 0.02;
    return water;
}

vec3 vsEmissiveRadiance(
    VsEmissiveLight light,
    VsSurface s,
    vec3 point,
    vec3 viewDir,
    vec3 cameraPosAbs
) {
    vec3 delta = light.posRadius.xyz - point;
    float distanceSq = dot(delta, delta);
    vec3 toLight = delta * inversesqrt(max(distanceSq, 1e-4));
    float atten = vsEmissiveAttenuation(distanceSq, light.posRadius.w);
    if (atten <= 1e-6) {
        return vec3(0.0);
    }
    vec3 flickerSeed = vsIsHeldLight(light)
        ? (((vsLightFlags(light) & 8u) != 0u) ? vec3(1.0, 0.0, 0.0) : vec3(0.0))
        : (light.posRadius.xyz + cameraPosAbs);
    float flicker = vsHasFlameFlicker(light)
        ? vsFlameFlicker(flickerSeed, vsWorld.gameTimeSec)
        : 1.0;
    vec3 brdf = evaluateCookTorrance(s.albedo, s.normal, viewDir, toLight, s.roughness, s.metallic, s.f0);
    // Warm subsurface wrap on foliage and snow near torches/lanterns
    if (s.subsurface > 0.01) {
        float wrap = max(0.0, (dot(s.normal, toLight) + 0.45) / 1.45);
        // Normalize the wrapped diffuse lobe by PI so SSS does not add unnormalized emittance.
        brdf += s.albedo * wrap * s.subsurface * (0.20 / 3.14159265);
    }
    return brdf * light.colorIntensity.rgb * (light.colorIntensity.a * flicker * atten);
}

vec3 vsEmissiveRadiance(VsEmissiveLight light, VsSurface s, vec3 point, vec3 viewDir) {
    return vsEmissiveRadiance(light, s, point, viewDir, vsWorld.cameraPosFrac);
}

float vsRandFloat(inout uint state) {
    state = vsPcgHash(state);
    return float(state & 0x00FFFFFFu) * (1.0 / 16777216.0);
}

void vsBuildOnb(vec3 N, out vec3 T, out vec3 B) {
    vec3 up = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    T = normalize(cross(up, N));
    B = cross(N, T);
}

vec3 vsSampleCosineHemisphere(vec3 N, vec2 u) {
    float phi = 6.283185307 * u.x;
    float r = sqrt(clamp(u.y, 0.0, 1.0));
    float x = r * cos(phi);
    float y = r * sin(phi);
    float z = sqrt(max(1.0 - u.y, 0.0));
    vec3 T, B;
    vsBuildOnb(N, T, B);
    return normalize(T * x + B * y + N * z);
}

vec3 vsSampleGgxHalfVector(vec3 N, float roughness, vec2 u) {
    float a = max(roughness * roughness, 0.002);
    float a2 = a * a;
    float phi = 6.283185307 * u.x;
    float cosTheta = sqrt((1.0 - u.y) / max(1.0 + (a2 - 1.0) * u.y, 1e-6));
    float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));
    vec3 T, B;
    vsBuildOnb(N, T, B);
    vec3 H = T * (cos(phi) * sinTheta) + B * (sin(phi) * sinTheta) + N * cosTheta;
    return normalize(H);
}

vec2 vsConcentricDisk(vec2 u) {
    vec2 uOffset = 2.0 * u - vec2(1.0);
    if (uOffset.x == 0.0 && uOffset.y == 0.0) {
        return vec2(0.0);
    }
    float theta;
    float r;
    if (abs(uOffset.x) > abs(uOffset.y)) {
        r = uOffset.x;
        theta = 0.785398163 * (uOffset.y / uOffset.x);
    } else {
        r = uOffset.y;
        theta = 1.570796327 - 0.785398163 * (uOffset.x / uOffset.y);
    }
    return r * vec2(cos(theta), sin(theta));
}

vec3 vsSampleSunDisk(vec3 lightDir, float radius, vec2 sampleUv) {
    vec3 tangent, bitangent;
    vsBuildOnb(lightDir, tangent, bitangent);
    vec2 disk = vsConcentricDisk(sampleUv) * radius;
    return normalize(lightDir + tangent * disk.x + bitangent * disk.y);
}

// --- LabPBR 1.3 Material Decoding ---

// Hardcoded linear metal F0 RGB table for LabPBR 1.3 _s.g codes 230..237:
// Iron, Gold, Aluminum, Chrome, Copper, Lead, Platinum, Silver.
vec3 vsLabPbrMetalF0(int code) {
    const vec3 METALS[8] = vec3[8](
        vec3(0.53123, 0.51236, 0.49583),
        vec3(0.94423, 0.77610, 0.37340),
        vec3(0.91230, 0.91385, 0.91968),
        vec3(0.55560, 0.55454, 0.55478),
        vec3(0.92595, 0.72090, 0.50415),
        vec3(0.63248, 0.62594, 0.64148),
        vec3(0.67885, 0.64240, 0.58841),
        vec3(0.96200, 0.94947, 0.92212)
    );
    return METALS[clamp(code - 230, 0, 7)];
}

void vsApplyLabPbr(
    vec4 normalSample,
    vec4 specularSample,
    vec3 geomN,
    vec4 geomTangent,
    bool hasNormalTex,
    bool hasSpecularTex,
    inout VsSurface s,
    out float outPorosity
) {
    s.normal = geomN;
    outPorosity = smoothstep(0.35, 0.85, s.roughness);
    if (hasNormalTex) {
        vec2 nXY = (normalSample.xy * 2.0 - 1.0) * 1.35;
        float nXYLenSq = dot(nXY, nXY);
        if (nXYLenSq < 1.8) {
            if (nXYLenSq > 0.96) {
                nXY *= inversesqrt(nXYLenSq) * 0.98;
            }
            float nZ = sqrt(max(1.0 - dot(nXY, nXY), 0.0));
            vec3 tN = normalize(vec3(nXY, nZ));
            vec3 fallbackT = abs(geomN.x) < 0.9 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 0.0, 1.0);
            vec3 projT = geomTangent.xyz - geomN * dot(geomN, geomTangent.xyz);
            vec3 T = dot(projT, projT) > 1e-6
                ? normalize(projT)
                : normalize(fallbackT - geomN * dot(geomN, fallbackT));
            float hand = geomTangent.w < 0.0 ? -1.0 : 1.0;
            vec3 rawB = cross(geomN, T);
            vec3 B = (dot(rawB, rawB) > 1e-8 ? normalize(rawB) : vec3(0.0, 0.0, 1.0)) * hand;
            vec3 worldN = T * tN.x + B * tN.y + geomN * tN.z;
            s.normal = dot(worldN, worldN) > 1e-8 ? normalize(worldN) : geomN;
        }
        s.ao *= mix(1.0, clamp(normalSample.b, 0.05, 1.0), 0.72);
    }
    if (hasSpecularTex) {
        bool isMissingSentinel = (specularSample.r < 0.002 && specularSample.g < 0.002
            && specularSample.b < 0.002 && specularSample.a >= (254.5 / 255.0));
        if (!isMissingSentinel) {
            float perceptualSmoothness = clamp(specularSample.r, 0.0, 1.0);
            float rough = 1.0 - perceptualSmoothness;
            s.roughness = clamp(rough * rough, 0.04, 1.0);

            int gCode = int(floor(specularSample.g * 255.0 + 0.5));
            if (gCode >= 230 && gCode <= 237) {
                vec3 metalF0 = vsLabPbrMetalF0(gCode);
                s.metallic = 1.0;
                s.albedo = metalF0;
                s.f0 = max(metalF0.r, max(metalF0.g, metalF0.b));
            } else if (gCode >= 238) {
                s.metallic = 1.0;
                s.f0 = 0.90;
            } else {
                s.metallic = 0.0;
                s.f0 = clamp(specularSample.g, 0.02, 0.90);
            }

            float bVal = specularSample.b;
            if (bVal <= (64.5 / 255.0)) {
                outPorosity = clamp(bVal * (255.0 / 64.0), 0.0, 1.0);
            } else {
                outPorosity = 0.0;
                s.subsurface = max(s.subsurface, clamp((bVal - 64.5 / 255.0) / (190.5 / 255.0), 0.0, 1.0));
            }

            // LabPBR 1.3: alpha 255 (1.0) means zero emission; 0..254 maps linearly (unified 2.2 scale)
            if (specularSample.a < (254.5 / 255.0)) {
                s.emission = max(s.emission, specularSample.a * (255.0 / 254.0) * 2.2);
            }
        }
    }
}

void vsApplyLabPbr(
    vec4 normalSample,
    vec4 specularSample,
    vec3 geomN,
    vec4 geomTangent,
    bool hasNormalTex,
    bool hasSpecularTex,
    inout VsSurface s
) {
    float unusedPorosity;
    vsApplyLabPbr(normalSample, specularSample, geomN, geomTangent, hasNormalTex, hasSpecularTex, s, unusedPorosity);
}

// --- SHaRC Spatial Hash Radiance Cache (BDA) ---

#if !defined(VS_ACTIVE_RENDER_TIER) || (VS_ACTIVE_RENDER_TIER >= 2)
layout(buffer_reference, std430, buffer_reference_align = 8) buffer VsSharcHashEntryBuf {
    uint64_t keys[];
};

struct VsSharcAccumVoxel {
    uvec4 accumulatedRadianceAndSamples;
};

layout(buffer_reference, std430, buffer_reference_align = 16) buffer VsSharcAccumBuf {
    VsSharcAccumVoxel voxels[];
};

struct VsSharcResolvedVoxel {
    vec3 radiance;
    float sampleWeight;
    uint age;
    uint pad0;
    uint pad1;
    uint pad2;
};

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer VsSharcResolvedBuf {
    VsSharcResolvedVoxel voxels[];
};

uint64_t sharcHashMix64(uint64_t k) {
    k ^= k >> 33ul;
    k *= 0xff51afd7ed558ccdul;
    k ^= k >> 33ul;
    k *= 0xc4ceb9fe1a85ec53ul;
    k ^= k >> 33ul;
    return k;
}

uint64_t sharcHashCell(vec3 worldPosAbs, vec3 normal, float sceneScale, vec3 camPosAbs) {
    float dist = length(worldPosAbs - camPosAbs);
    float s = max(sceneScale, 1e-3);
    int lod = clamp(int(floor(log2(max(dist * 0.06 * s, 1.0)))), 0, 7);
    float voxelSize = exp2(float(lod)) * 0.5 / s;

    ivec3 cell = ivec3(floor(worldPosAbs / voxelSize));
    ivec3 nQ = ivec3(round(clamp(normal, vec3(-1.0), vec3(1.0)) * 2.0)) + ivec3(2);
    uint normBits = uint((nQ.x & 7) | ((nQ.y & 7) << 3) | ((nQ.z & 7) << 6) | ((lod & 7) << 9));

    uint64_t key = uint64_t(uint(cell.x)) * 73856093ul
                 ^ uint64_t(uint(cell.y)) * 19349663ul
                 ^ uint64_t(uint(cell.z)) * 83492791ul
                 ^ (uint64_t(normBits) << 32ul);
    key = sharcHashMix64(key);
    return key | 1ul;
}
#endif

void sharcAccumulate(SharcConfig cfg, vec3 worldPosAbs, vec3 normal, vec3 radiance) {
#if VS_ACTIVE_RENDER_TIER >= 2
    if (cfg.capacity == 0u) {
        return;
    }
    uint64_t hashAddr = vsPackU64(cfg.hashEntriesAddress);
    uint64_t accumAddr = vsPackU64(cfg.accumulationAddress);
    if (hashAddr == 0ul || accumAddr == 0ul) {
        return;
    }

    VsSharcHashEntryBuf hashBuf = VsSharcHashEntryBuf(hashAddr);
    VsSharcAccumBuf accumBuf = VsSharcAccumBuf(accumAddr);

    uint64_t key = sharcHashCell(worldPosAbs, normal, cfg.sceneScale, cfg.cameraPosition.xyz);
    uint capMask = cfg.capacity - 1u;

    for (uint probe = 0u; probe < 8u; ++probe) {
        uint slot = (uint(key) + probe) & capMask;
        uint64_t existing = atomicCompSwap(hashBuf.keys[slot], 0ul, key);
        if (existing == 0xFFFFFFFFFFFFFFFFul) {
            existing = atomicCompSwap(hashBuf.keys[slot], 0xFFFFFFFFFFFFFFFFul, key);
            if (existing == 0xFFFFFFFFFFFFFFFFul) {
                existing = 0ul;
            }
        }
        if (existing == 0ul || existing == key) {
            float scale = max(cfg.radianceScale, 1.0);
            uvec3 qRad = uvec3(clamp(radiance * scale, vec3(0.0), vec3(16777215.0)));
            atomicAdd(accumBuf.voxels[slot].accumulatedRadianceAndSamples.x, qRad.x);
            atomicAdd(accumBuf.voxels[slot].accumulatedRadianceAndSamples.y, qRad.y);
            atomicAdd(accumBuf.voxels[slot].accumulatedRadianceAndSamples.z, qRad.z);
            atomicAdd(accumBuf.voxels[slot].accumulatedRadianceAndSamples.w, 1u);
            return;
        }
    }
#endif
}

bool sharcResolveLookup(
    SharcConfig cfg,
    vec3 worldPosAbs,
    vec3 normal,
    out vec3 outRadiance,
    out float outWeight
) {
    outRadiance = vec3(0.0);
    outWeight = 0.0;
#if VS_ACTIVE_RENDER_TIER >= 2
    if (cfg.capacity == 0u) {
        return false;
    }
    uint64_t hashAddr = vsPackU64(cfg.hashEntriesAddress);
    uint64_t resolvedAddr = vsPackU64(cfg.resolvedAddress);
    if (hashAddr == 0ul || resolvedAddr == 0ul) {
        return false;
    }

    VsSharcHashEntryBuf hashBuf = VsSharcHashEntryBuf(hashAddr);
    VsSharcResolvedBuf resolvedBuf = VsSharcResolvedBuf(resolvedAddr);

    uint64_t key = sharcHashCell(worldPosAbs, normal, cfg.sceneScale, cfg.cameraPosition.xyz);
    uint capMask = cfg.capacity - 1u;

    for (uint probe = 0u; probe < 8u; ++probe) {
        uint slot = (uint(key) + probe) & capMask;
        uint64_t entryKey = atomicLoad(hashBuf.keys[slot], gl_ScopeDevice, gl_StorageSemanticsNone, gl_SemanticsRelaxed);
        if (entryKey == 0ul) {
            return false;
        }
        if (entryKey == key) {
            VsSharcResolvedVoxel v = resolvedBuf.voxels[slot];
            if (v.sampleWeight > 0.5) {
                outRadiance = v.radiance;
                outWeight = v.sampleWeight;
                return true;
            }
            return false;
        }
    }
#endif
    return false;
}

#endif
