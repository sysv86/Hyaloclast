#include <vulkanshaders/v1/common.vsl>

// Gentle organic multi-harmonic flame breath for torches, lanterns, and campfires
float sv_flameFlicker(float timeSec, float dist) {
    float slowBreath = sin(timeSec * 4.4 + dist * 0.35) * 0.022;
    float fineDance = cos(timeSec * 9.8 + dist * 0.72 + 0.6) * 0.012;
    return 0.972 + slowBreath + fineDance;
}

// @hook(stage = "block_light", priority = 10)
// Sunlit Vanilla - Cozy hearth-warm 10-kind block light curves with gentle organic flame flicker
// and smooth non-clipping near-field falloff.
// Three-stop warm blackbody torch ramp adapted from Miniature Shader (MIT License) for linear HDR.
void sv_block_light(inout vec3 radiance, in uint lightKind, in float dist) {
    float nearness = clamp(1.0 - (dist - 0.38) / 5.8, 0.0, 1.0);
    float hotCore = pow(nearness, 3.6);
    float flicker = 1.0;

    vec3 tint;
    if (lightKind == 1u) {
        // Soul fire / soul lantern: serene spectral cyan-turquoise -> pale ice-cyan core
        vec3 outerSoul = vec3(0.08, 0.48, 0.78);
        vec3 midSoul   = vec3(0.26, 0.80, 0.96);
        vec3 coreSoul  = vec3(0.74, 0.96, 1.00);
        tint = mix(mix(outerSoul, midSoul, nearness), coreSoul, hotCore);
        flicker = 0.97 + 0.03 * sin(vsWorld.gameTimeSec * 4.1 + dist * 0.65);
    } else if (lightKind == 2u) {
        // Lava / magma: deep volcanic ember-orange -> molten amber-gold core
        vec3 outerMagma = vec3(0.96, 0.16, 0.03);
        vec3 midMagma   = vec3(1.00, 0.44, 0.08);
        vec3 coreMagma  = vec3(1.00, 0.78, 0.28);
        tint = mix(mix(outerMagma, midMagma, nearness), coreMagma, hotCore);
        flicker = 0.975 + 0.025 * sin(vsWorld.gameTimeSec * 2.0 + dist * 0.38);
    } else if (lightKind == 3u) {
        // Sea lantern / beacon / conduit: crisp marine aqua -> pearl-white core
        vec3 outerSea = vec3(0.26, 0.76, 0.90);
        vec3 midSea   = vec3(0.60, 0.92, 0.98);
        vec3 coreSea  = vec3(0.90, 0.99, 1.00);
        tint = mix(mix(outerSea, midSea, nearness), coreSea, hotCore);
    } else if (lightKind == 4u) {
        // Redstone torch / ore: rich ruby crimson -> warm scarlet core
        vec3 outerRed = vec3(0.86, 0.05, 0.04);
        vec3 midRed   = vec3(0.98, 0.16, 0.10);
        vec3 coreRed  = vec3(1.00, 0.38, 0.24);
        tint = mix(mix(outerRed, midRed, nearness), coreRed, hotCore);
        flicker = 0.975 + 0.025 * sin(vsWorld.gameTimeSec * 6.0 + dist * 0.95);
    } else if (lightKind == 5u) {
        // Glowstone / shroomlight / amber lantern: warm honey gold -> creamy soft-ivory core
        vec3 outerAmber = vec3(0.98, 0.56, 0.16);
        vec3 midAmber   = vec3(1.00, 0.76, 0.36);
        vec3 coreAmber  = vec3(1.00, 0.94, 0.72);
        tint = mix(mix(outerAmber, midAmber, nearness), coreAmber, hotCore);
    } else if (lightKind == 6u) {
        // End rod / amethyst: delicate lavender-violet -> crystalline white core
        vec3 outerAmethyst = vec3(0.64, 0.52, 0.96);
        vec3 midAmethyst   = vec3(0.86, 0.78, 1.00);
        vec3 coreAmethyst  = vec3(0.98, 0.96, 1.00);
        tint = mix(mix(outerAmethyst, midAmethyst, nearness), coreAmethyst, hotCore);
    } else if (lightKind == 7u) {
        // Sculk / deep-dark: deep ocean-teal -> soft bioluminescent sculk-cyan core
        vec3 outerSculk = vec3(0.05, 0.34, 0.46);
        vec3 midSculk   = vec3(0.16, 0.70, 0.82);
        vec3 coreSculk  = vec3(0.48, 0.94, 1.00);
        tint = mix(mix(outerSculk, midSculk, nearness), coreSculk, hotCore);
        flicker = 0.93 + 0.07 * sin(vsWorld.gameTimeSec * 2.1);
    } else if (lightKind == 8u) {
        // Copper / emerald / ender flame: verdigris-emerald -> bright mint core
        vec3 outerVerdigris = vec3(0.09, 0.62, 0.38);
        vec3 midVerdigris   = vec3(0.32, 0.88, 0.60);
        vec3 coreVerdigris  = vec3(0.72, 1.00, 0.84);
        tint = mix(mix(outerVerdigris, midVerdigris, nearness), coreVerdigris, hotCore);
    } else if (lightKind == 9u) {
        // Arcane magenta / enchanted violet: royal violet -> luminous lavender core
        vec3 outerArcane = vec3(0.56, 0.16, 0.88);
        vec3 midArcane   = vec3(0.80, 0.44, 0.98);
        vec3 coreArcane  = vec3(0.96, 0.76, 1.00);
        tint = mix(mix(outerArcane, midArcane, nearness), coreArcane, hotCore);
    } else {
        // Default (0u): Torch / lantern / campfire - cozy hearth-warm blackbody firelight
        vec3 outerHearth = vec3(0.96, 0.32, 0.07);
        vec3 midAmber    = vec3(1.02, 0.60, 0.20);
        vec3 innerFlame  = vec3(1.02, 0.91, 0.68);
        tint = mix(mix(outerHearth, midAmber, nearness), innerFlame, hotCore);
        flicker = sv_flameFlicker(vsWorld.gameTimeSec, dist);
    }

    // Smooth non-clipping near-field falloff so walls beside torches retain crisp texture detail
    float falloff = 1.0 / (1.0 + dist * dist * 0.095);
    vec3 shaped = tint * (mix(0.94, 1.26, falloff) * flicker);

    if (dot(radiance, radiance) <= 1e-6) {
        radiance = shaped;
    } else {
        radiance *= shaped;
    }
}
