#version 460
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D uCurrentColor;
layout(set = 0, binding = 1) uniform sampler2D uHistoryColor; // Linear RGBA16F (RES_TSR_HISTORY)
layout(set = 0, binding = 2) uniform sampler2D uVelocity;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D uUpscaledOutput;
layout(set = 0, binding = 4) uniform sampler2D uLinearDepth;
layout(set = 0, binding = 5) uniform sampler2D uNormalRoughness;

layout(push_constant) uniform TsrPush {
    vec2 jitterOffset;
    float historyWeight;
    float sharpness;
} pc;

vec3 rgbToYCoCg(vec3 c) {
    return vec3(
        0.25 * c.r + 0.5 * c.g + 0.25 * c.b,
        0.5 * c.r - 0.5 * c.b,
        -0.25 * c.r + 0.5 * c.g - 0.25 * c.b
    );
}

vec3 yCoCgToRgb(vec3 ycc) {
    float tmp = ycc.x - ycc.z;
    return vec3(tmp + ycc.y, ycc.x + ycc.z, tmp - ycc.y);
}

float luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// Karis tone compression for firefly-free temporal variance clipping in linear HDR space
vec3 karisCompress(vec3 c) {
    return c / (1.0 + max(luminance(c), 0.0));
}

vec3 karisDecompress(vec3 c) {
    return c / max(1.0 - max(luminance(c), 0.0), 1e-4);
}

// 5-tap Catmull-Rom bicubic filter preventing bilinear blur in TSR history
vec3 sampleHistoryCatmullRom(sampler2D tex, vec2 uv, vec2 texSize) {
    vec2 samplePos = uv * texSize;
    vec2 texPos1 = floor(samplePos - 0.5) + 0.5;
    vec2 f = samplePos - texPos1;

    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);

    vec2 w12 = w1 + w2;
    vec2 offset12 = w2 / max(w12, vec2(1e-5));

    vec2 invTexSize = 1.0 / texSize;
    vec2 tc0 = (texPos1 - 1.0) * invTexSize;
    vec2 tc3 = (texPos1 + 2.0) * invTexSize;
    vec2 tc12 = (texPos1 + offset12) * invTexSize;

    vec3 result = vec3(0.0);
    result += textureLod(tex, vec2(tc12.x, tc0.y), 0.0).rgb * (w12.x * w0.y);
    result += textureLod(tex, vec2(tc0.x, tc12.y), 0.0).rgb * (w0.x * w12.y);
    result += textureLod(tex, vec2(tc12.x, tc12.y), 0.0).rgb * (w12.x * w12.y);
    result += textureLod(tex, vec2(tc3.x, tc12.y), 0.0).rgb * (w3.x * w12.y);
    result += textureLod(tex, vec2(tc12.x, tc3.y), 0.0).rgb * (w12.x * w3.y);
    return max(result, vec3(0.0));
}

void main() {
    ivec2 outPx = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outRes = imageSize(uUpscaledOutput);
    if (outPx.x >= outRes.x || outPx.y >= outRes.y) {
        return;
    }

    vec2 outTexel = 1.0 / vec2(outRes);
    vec2 uv = (vec2(outPx) + 0.5) * outTexel;
    vec2 srcSize = vec2(textureSize(uCurrentColor, 0));
    vec2 srcTexel = 1.0 / srcSize;

    // 3x3 depth-dilated closest-surface velocity selection
    // Tier 0/1/2 use Reverse-Z hardware depth (closer = LARGER d); Tier 3 uses positive linear viewZ (closer = SMALLER d).
    vec2 bestUv = uv;
#if defined(VS_ACTIVE_RENDER_TIER) && (VS_ACTIVE_RENDER_TIER >= 3)
    float bestDepth = 1.0e9;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec2 suv = clamp(uv + vec2(x, y) * srcTexel, vec2(0.0), vec2(1.0));
            float d = textureLod(uLinearDepth, suv, 0.0).r;
            if (d > 0.0 && d < bestDepth) {
                bestDepth = d;
                bestUv = suv;
            }
        }
    }
#else
    float bestDepth = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec2 suv = clamp(uv + vec2(x, y) * srcTexel, vec2(0.0), vec2(1.0));
            float d = textureLod(uLinearDepth, suv, 0.0).r;
            if (d > bestDepth) {
                bestDepth = d;
                bestUv = suv;
            }
        }
    }
#endif

    vec2 motion = textureLod(uVelocity, bestUv, 0.0).xy;
    vec2 prevUv = uv - motion;

    // 3x3 YCoCg variance bounding box in compressed linear HDR space; cache cardinal taps for CAS.
    vec3 m1 = vec3(0.0);
    vec3 m2 = vec3(0.0);
    vec3 nMin = vec3(1e9);
    vec3 nMax = vec3(-1e9);
    vec3 nCrossMin = vec3(1e9);
    vec3 nCrossMax = vec3(-1e9);
    vec3 cardN = vec3(0.0);
    vec3 cardS = vec3(0.0);
    vec3 cardW = vec3(0.0);
    vec3 cardE = vec3(0.0);

    vec2 unjitterUv = clamp(uv - pc.jitterOffset * srcTexel, vec2(0.0), vec2(1.0));
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec2 sampleUv = clamp(unjitterUv + vec2(x, y) * srcTexel, vec2(0.0), vec2(1.0));
            vec3 rawC = textureLod(uCurrentColor, sampleUv, 0.0).rgb;
            vec3 c = any(isnan(rawC)) || any(isinf(rawC)) ? vec3(0.0) : max(rawC, vec3(0.0));
            if (x == 0 && y == -1) cardN = c;
            else if (x == 0 && y == 1) cardS = c;
            else if (x == -1 && y == 0) cardW = c;
            else if (x == 1 && y == 0) cardE = c;
            vec3 ycc = rgbToYCoCg(karisCompress(c));
            m1 += ycc;
            m2 += ycc * ycc;
            nMin = min(nMin, ycc);
            nMax = max(nMax, ycc);
            if (abs(x) + abs(y) <= 1) {
                nCrossMin = min(nCrossMin, ycc);
                nCrossMax = max(nCrossMax, ycc);
            }
        }
    }

    vec3 mu = m1 * (1.0 / 9.0);
    vec3 sigma = sqrt(max(m2 * (1.0 / 9.0) - mu * mu, vec3(0.0)));
    float gamma = 1.15;
    vec3 boxMin = max(mix(nMin, nCrossMin, 0.5), mu - gamma * sigma);
    vec3 boxMax = min(mix(nMax, nCrossMax, 0.5), mu + gamma * sigma);

    vec3 curRgb = (abs(srcSize.x - float(outRes.x)) < 0.5 && length(pc.jitterOffset) < 0.01)
        ? max(texelFetch(uCurrentColor, outPx, 0).rgb, vec3(0.0))
        : sampleHistoryCatmullRom(uCurrentColor, unjitterUv, srcSize);
    bool validHistory = all(greaterThanEqual(prevUv, vec2(0.0))) && all(lessThanEqual(prevUv, vec2(1.0)));

    vec3 resolvedRgb = curRgb;
    if (validHistory) {
        vec3 rawHist = sampleHistoryCatmullRom(uHistoryColor, prevUv, vec2(outRes));
        vec3 histRgb = any(isnan(rawHist)) || any(isinf(rawHist)) ? curRgb : max(rawHist, vec3(0.0));
        vec3 histYcc = rgbToYCoCg(karisCompress(histRgb));
        vec3 clampedHist = karisDecompress(yCoCgToRgb(clamp(histYcc, boxMin, boxMax)));

        // Reactive weighting: reduce temporal lag on water ripples (>1.0 marker) & bright emissives
        float roughness = textureLod(uNormalRoughness, uv, 0.0).a;
        float rawRoughness = (roughness > 1.0) ? (roughness - 1.0) : roughness;
        float reactive = (roughness > 1.0 || rawRoughness < 0.14) ? 0.55 : 0.0;
        float lumaDiff = abs(luminance(curRgb) - luminance(histRgb)) / max(max(luminance(curRgb), luminance(histRgb)), 0.1);
        reactive = clamp(reactive + smoothstep(0.4, 1.5, lumaDiff) * 0.45, 0.0, 0.85);

        float motionLen = length(motion * vec2(outRes));
        float baseWeight = clamp(pc.historyWeight * exp(-motionLen * 0.08), 0.0, 0.95);
        float blend = baseWeight * (1.0 - reactive);
        resolvedRgb = mix(curRgb, clampedHist, blend);
    }

    // Contrast-Adaptive Sharpening (CAS-style) reusing cardinal neighborhood samples
    if (pc.sharpness > 0.001) {
        vec3 ringAvg = (cardN + cardS + cardW + cardE) * 0.25;
        vec3 highFreq = resolvedRgb - ringAvg;
        float sharpAmount = clamp(pc.sharpness * 0.55, 0.0, 0.55);
        resolvedRgb = max(resolvedRgb + highFreq * sharpAmount, vec3(0.0));
    }

    imageStore(uUpscaledOutput, outPx, vec4(max(resolvedRgb, vec3(0.0)), 1.0));
}
