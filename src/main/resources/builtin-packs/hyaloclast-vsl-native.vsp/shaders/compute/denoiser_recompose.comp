#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D inDiff;
layout(set = 0, binding = 1) uniform sampler2D inSpec;
layout(set = 0, binding = 2) uniform sampler2D inAlbedo;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D outDenoised;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D outSharp;
layout(set = 0, binding = 5) uniform sampler2D inRawRadiance;
layout(set = 0, binding = 6) uniform sampler2D inViewZ;

layout(push_constant) uniform DenoiserRecomposePush {
    uint width;
    uint height;
    uint pad0;
    uint pad1;
} pc;

vec3 sanitizeColor(vec3 c) {
    return (any(isnan(c)) || any(isinf(c))) ? vec3(0.0) : max(c, vec3(0.0));
}

vec3 reblurRgb(vec3 signal) {
    return sanitizeColor(vec3(
        signal.x + signal.y - signal.z,
        signal.x + signal.z,
        signal.x - signal.y - signal.z
    ));
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.width) || px.y >= int(pc.height)) {
        return;
    }
    if (texelFetch(inViewZ, px, 0).r >= 65536.0) {
        imageStore(outDenoised, px, vec4(sanitizeColor(texelFetch(inRawRadiance, px, 0).rgb), 1.0));
        imageStore(outSharp, px, vec4(0.0));
        return;
    }

    vec4 diffSample = texelFetch(inDiff, px, 0);
    vec4 specSample = texelFetch(inSpec, px, 0);
    vec3 albedoRaw = sanitizeColor(texelFetch(inAlbedo, px, 0).rgb);

    vec3 diffRgb = reblurRgb(diffSample.rgb);
    vec3 specRgb = reblurRgb(specSample.rgb);

#if defined(VS_ACTIVE_RENDER_TIER) && (VS_ACTIVE_RENDER_TIER >= 3)
    vec3 albedoLin = albedoRaw;
#else
    vec3 albedoLin = pow(albedoRaw, vec3(2.2));
#endif

    vec3 recomposed = diffRgb * max(albedoLin, vec3(0.035)) + specRgb;

    imageStore(outDenoised, px, vec4(clamp(recomposed, vec3(0.0), vec3(32.0)), 1.0));
    imageStore(outSharp, px, vec4(clamp(specRgb, vec3(0.0), vec3(32.0)), max(specSample.a, 0.0)));
}
