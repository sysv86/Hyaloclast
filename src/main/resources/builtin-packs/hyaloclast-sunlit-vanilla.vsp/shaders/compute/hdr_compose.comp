#version 460
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D uWorldHdr;
layout(set = 0, binding = 1) uniform sampler2D uUiSrgb;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D uSwapchainOut;

layout(push_constant) uniform HdrComposePush {
    float peakBrightnessNits;
    float paperWhiteNits;
    uint outputMode; // 0 = SDR sRGB, 1 = scRGB Linear (R16G16B16A16_SFLOAT), 2 = HDR10 ST2084 PQ
    uint uiOnly;     // 0 = compose world HDR + UI, non-zero = encode uUiSrgb directly (menu / title screen)
} pc;

const float HDR_BLOOM_THRESHOLD = 1.32;
const float HDR_BLOOM_KNEE = 0.68;
const float HDR_BLOOM_TEXEL_LIMIT = 8.0;

vec3 evaluateHdrBloomWeight(vec3 s) {
    if (any(isnan(s)) || any(isinf(s))) {
        return vec3(0.0);
    }
    s = clamp(s, vec3(0.0), vec3(HDR_BLOOM_TEXEL_LIMIT));
    float luma = dot(s, vec3(0.2126, 0.7152, 0.0722));
    float soft = clamp(luma - HDR_BLOOM_THRESHOLD + HDR_BLOOM_KNEE, 0.0, 2.0 * HDR_BLOOM_KNEE);
    soft = (soft * soft) / (4.0 * HDR_BLOOM_KNEE + 1e-4);
    float contrib = max(soft, luma - HDR_BLOOM_THRESHOLD) / max(luma, 1e-4);
    float karis = 1.0 / (1.0 + luma * 0.35);
    return s * (contrib * karis);
}

vec3 sampleHdrBloomTap(vec2 uv) {
    vec3 s = textureLod(uWorldHdr, clamp(uv, vec2(0.0), vec2(1.0)), 0.0).rgb;
    return evaluateHdrBloomWeight(max(s, vec3(0.0)));
}

// 3-ring Karis-weighted optical bloom (1.8px, 4.5px, 9.5px) applied before scRGB/PQ/SDR output.
vec3 sampleHdrSoftBloom(vec2 uv, vec2 texelSize, vec3 centerHdr) {
    vec2 r1 = texelSize * 1.8;
    vec2 r2 = texelSize * 4.5;
    vec2 r3 = texelSize * 9.5;
    vec3 c0 = evaluateHdrBloomWeight(centerHdr) * 0.16;

    vec3 ring1 = (
        sampleHdrBloomTap(uv + vec2( r1.x,  r1.y)) +
        sampleHdrBloomTap(uv + vec2(-r1.x,  r1.y)) +
        sampleHdrBloomTap(uv + vec2( r1.x, -r1.y)) +
        sampleHdrBloomTap(uv + vec2(-r1.x, -r1.y))
    ) * 0.095;

    vec3 ring2 = (
        sampleHdrBloomTap(uv + vec2( r2.x,  0.0)) +
        sampleHdrBloomTap(uv + vec2(-r2.x,  0.0)) +
        sampleHdrBloomTap(uv + vec2( 0.0,  r2.y)) +
        sampleHdrBloomTap(uv + vec2( 0.0, -r2.y))
    ) * 0.070;

    vec3 ring3 = (
        sampleHdrBloomTap(uv + vec2( r3.x,  r3.y) * 0.7071) +
        sampleHdrBloomTap(uv + vec2(-r3.x,  r3.y) * 0.7071) +
        sampleHdrBloomTap(uv + vec2( r3.x, -r3.y) * 0.7071) +
        sampleHdrBloomTap(uv + vec2(-r3.x, -r3.y) * 0.7071)
    ) * 0.045;

    return c0 + ring1 + ring2 + ring3;
}

// Khronos PBR Neutral tone mapper with softened toe (0.015) preserving hue and shadow detail
vec3 khronosPbrNeutral(vec3 color) {
    const float toe = 0.015;
    const float startCompression = 0.80 - toe;
    const float desaturation = 0.14;

    float x = min(color.r, min(color.g, color.b));
    float offset = x < (2.0 * toe) ? (x - (x * x) / (4.0 * toe)) : toe;
    color = max(color - offset, vec3(0.0));

    float peak = max(color.r, max(color.g, color.b));
    if (peak < startCompression) return color;

    const float d = 1.0 - startCompression;
    float newPeak = 1.0 - d * d / (peak + d - startCompression);
    color *= newPeak / peak;

    float g = 1.0 - 1.0 / (desaturation * (peak - newPeak) + 1.0);
    return clamp(mix(color, vec3(newPeak), g), 0.0, 1.0);
}

// Smooth HDR peak roll-off to avoid harsh channel clipping on solar corona and emissives
vec3 softClipPeakNits(vec3 linearNits, float peakNits) {
    float safePeak = max(peakNits, 200.0);
    float maxC = max(linearNits.r, max(linearNits.g, linearNits.b));
    float knee = safePeak * 0.82;
    if (maxC <= knee) {
        return linearNits;
    }
    float span = safePeak - knee;
    float mapped = knee + span * ((maxC - knee) / (maxC - knee + span));
    return linearNits * (mapped / max(maxC, 1e-4));
}

vec3 encodePqSt2084(vec3 linearNits) {
    vec3 y = clamp(linearNits / 10000.0, vec3(0.0), vec3(1.0));
    const float m1 = 0.1593017578125;
    const float m2 = 78.84375;
    const float c1 = 0.8359375;
    const float c2 = 18.8515625;
    const float c3 = 18.6875;
    vec3 ym1 = pow(y, vec3(m1));
    return pow((c1 + c2 * ym1) / (1.0 + c3 * ym1), vec3(m2));
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 res = imageSize(uSwapchainOut);
    if (px.x >= res.x || px.y >= res.y) {
        return;
    }

    vec2 texelSize = 1.0 / vec2(res);
    vec2 uv = (vec2(px) + 0.5) * texelSize;
    vec4 uiSample = textureLod(uUiSrgb, uv, 0.0);

    float paperScale = max(pc.paperWhiteNits, 80.0) / 80.0;
    vec3 uiLinear = pow(max(uiSample.rgb, vec3(0.0)), vec3(2.2));

    vec3 outColor;
    if (pc.uiOnly != 0u) {
        if (pc.outputMode == 1u) {
            outColor = uiLinear * paperScale;
        } else if (pc.outputMode == 2u) {
            vec3 uiNits = min(uiLinear * pc.paperWhiteNits, vec3(pc.peakBrightnessNits));
            outColor = encodePqSt2084(uiNits);
        } else {
            outColor = uiLinear;
        }
        imageStore(uSwapchainOut, px, vec4(outColor, 1.0));
        return;
    }

    vec3 worldLinear = max(textureLod(uWorldHdr, uv, 0.0).rgb, vec3(0.0));
    if (any(isnan(worldLinear)) || any(isinf(worldLinear))) {
        worldLinear = vec3(0.0);
    }

    // Apply calibrated exposure and soft optical bloom before scRGB / HDR10 PQ / SDR output.
    const float HDR_EXPOSURE = 1.04;
    const float HDR_BLOOM_STRENGTH = 0.052;
    worldLinear = worldLinear * HDR_EXPOSURE + sampleHdrSoftBloom(uv, texelSize, worldLinear) * HDR_BLOOM_STRENGTH;

    if (pc.outputMode == 1u) {
        // scRGB 16-bit float (1.0 = 80 nits) with smooth peak roll-off
        vec3 worldNits = softClipPeakNits(worldLinear * pc.paperWhiteNits, pc.peakBrightnessNits);
        vec3 worldScRgb = worldNits / 80.0;
        vec3 uiScRgb = uiLinear * paperScale;
        outColor = mix(worldScRgb, uiScRgb, uiSample.a);
    } else if (pc.outputMode == 2u) {
        // HDR10 ST2084 PQ with smooth highlight knee
        vec3 worldNits = softClipPeakNits(worldLinear * pc.paperWhiteNits, pc.peakBrightnessNits);
        vec3 uiNits = uiLinear * pc.paperWhiteNits;
        outColor = encodePqSt2084(mix(worldNits, uiNits, uiSample.a));
    } else {
        // SDR Khronos PBR Neutral
        vec3 mapped = khronosPbrNeutral(worldLinear);
        outColor = mix(mapped, uiLinear, uiSample.a);
    }

    imageStore(uSwapchainOut, px, vec4(outColor, 1.0));
}
