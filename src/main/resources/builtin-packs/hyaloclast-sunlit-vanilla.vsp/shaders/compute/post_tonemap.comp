#version 460

#include <vulkanshaders/v1/common.vsl>

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 1) uniform sampler2D uWorldHdr;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D uOutSrgb;

// Restrained, non-glowstick bloom threshold and soft knee:
// Gives sun corona, torches, lanterns, and magma a wide, soft optical halo without harsh fringes.
const float BLOOM_THRESHOLD = 1.32;
const float BLOOM_KNEE = 0.68;
const float BLOOM_TEXEL_LIMIT = 6.5;

vec3 evaluateBloomWeight(vec3 s) {
    if (any(isnan(s)) || any(isinf(s))) {
        return vec3(0.0);
    }
    s = clamp(s, vec3(0.0), vec3(BLOOM_TEXEL_LIMIT));
    float luma = dot(s, vec3(0.2126, 0.7152, 0.0722));
    float soft = clamp(luma - BLOOM_THRESHOLD + BLOOM_KNEE, 0.0, 2.0 * BLOOM_KNEE);
    soft = (soft * soft) / (4.0 * BLOOM_KNEE + 1e-4);
    float contrib = max(soft, luma - BLOOM_THRESHOLD) / max(luma, 1e-4);
    float karis = 1.0 / (1.0 + luma * 0.40);
    return s * (contrib * karis);
}

vec3 extractSoftBloomTap(vec2 uv) {
    vec3 s = textureLod(uWorldHdr, clamp(uv, vec2(0.0), vec2(1.0)), 0.0).rgb;
    return evaluateBloomWeight(max(s, vec3(0.0)));
}

// 3-ring Karis-weighted optical halo (1.8px, 4.5px, 9.5px) for smooth wide glow.
vec3 sampleKarisTentBloom(vec2 uv, vec2 texelSize, vec3 centerHdr) {
    vec2 r1 = texelSize * 1.8;
    vec2 r2 = texelSize * 4.5;
    vec2 r3 = texelSize * 9.5;
    vec3 c0 = evaluateBloomWeight(centerHdr) * 0.16;

    vec3 ring1 = (
        extractSoftBloomTap(uv + vec2( r1.x,  r1.y)) +
        extractSoftBloomTap(uv + vec2(-r1.x,  r1.y)) +
        extractSoftBloomTap(uv + vec2( r1.x, -r1.y)) +
        extractSoftBloomTap(uv + vec2(-r1.x, -r1.y))
    ) * 0.095;

    vec3 ring2 = (
        extractSoftBloomTap(uv + vec2( r2.x,  0.0)) +
        extractSoftBloomTap(uv + vec2(-r2.x,  0.0)) +
        extractSoftBloomTap(uv + vec2( 0.0,  r2.y)) +
        extractSoftBloomTap(uv + vec2( 0.0, -r2.y))
    ) * 0.070;

    vec3 ring3 = (
        extractSoftBloomTap(uv + vec2( r3.x,  r3.y) * 0.7071) +
        extractSoftBloomTap(uv + vec2(-r3.x,  r3.y) * 0.7071) +
        extractSoftBloomTap(uv + vec2( r3.x, -r3.y) * 0.7071) +
        extractSoftBloomTap(uv + vec2(-r3.x, -r3.y) * 0.7071)
    ) * 0.045;

    return c0 + ring1 + ring2 + ring3;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 res = imageSize(uOutSrgb);
    if (px.x >= res.x || px.y >= res.y) {
        return;
    }

    vec2 texelSize = 1.0 / vec2(res);
    vec2 uv = (vec2(px) + 0.5) * texelSize;

    vec3 hdr = textureLod(uWorldHdr, uv, 0.0).rgb;
    if (any(isnan(hdr)) || any(isinf(hdr))) {
        hdr = vec3(0.0);
    }
    hdr = max(hdr, vec3(0.0));

    // Time-of-day & dimension exposure curve:
    // crisp sunlit daylight, luminous golden hour, readable starry nights, atmospheric Nether & End.
    int dimId = vsDimensionId();
    float sunElevation = clamp(vsWorld.sunDir.y, -1.0, 1.0);
    float dayFactor = (dimId == 0) ? smoothstep(-0.10, 0.22, sunElevation) : 0.0;
    float goldenFactor = (dimId == 0)
        ? smoothstep(-0.10, 0.05, sunElevation) * (1.0 - smoothstep(0.12, 0.34, sunElevation))
        : 0.0;
    float adaptiveExposure = (dimId == 1)
        ? 1.14
        : (dimId == 2)
            ? 1.26
            : (mix(1.26, 0.92, dayFactor) + goldenFactor * 0.05) * (1.0 + vsWorld.rain * 0.10);

    // Soft optical bloom: warm lantern/star presence at night & golden hour, restrained at high noon
    float bloomIntensity = mix(0.072, 0.038, dayFactor) + goldenFactor * 0.018;
    hdr += sampleKarisTentBloom(uv, texelSize, hdr) * bloomIntensity;

    uint mode = uint(clamp(VS_PARAM_TONE_MAPPING + 0.5, 0.0, 2.0));
    VsPostContext postCtx = VsPostContext(adaptiveExposure, bloomIntensity, mode);
    vs_dispatch_hook_post_grade(hdr, uv, postCtx);

    vec3 srgb = pow(clamp(hdr, 0.0, 1.0), vec3(1.0 / 2.2));
    imageStore(uOutSrgb, px, vec4(srgb, 1.0));
}
