#version 460

#include <vulkanshaders/v1/common.vsl>

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 1) uniform sampler2D uRawRadiance;
layout(set = 0, binding = 2) uniform sampler2D uNormalRoughness;
layout(set = 0, binding = 3) uniform sampler2D uVelocity;
layout(set = 0, binding = 4) uniform sampler2D uLinearDepth;
layout(set = 0, binding = 5) uniform sampler2D uHistoryRadiance;
layout(set = 0, binding = 6) uniform sampler2D uHistoryMoments;
layout(set = 0, binding = 7, rgba16f) uniform writeonly image2D outAccumRadiance;
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D outMoments;
layout(set = 0, binding = 9) uniform sampler2D gAlbedo;
#if VS_ACTIVE_RENDER_TIER >= 2
layout(set = 0, binding = 10) uniform sampler2D uSharpRadiance;
#endif

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);
#if VS_ACTIVE_RENDER_TIER >= 3
const float MAX_HISTORY_LENGTH = 64.0;
const float MIN_HISTORY_ALPHA = 0.025;
const float MIN_HISTORY_NORMAL_ALIGNMENT = 0.86;
#else
const float MAX_HISTORY_LENGTH = 24.0;
const float MIN_HISTORY_ALPHA = 0.06;
const float MIN_HISTORY_NORMAL_ALIGNMENT = 0.92;
#endif

vec3 diffuseSignal(ivec2 p) {
    vec3 radiance = texelFetch(uRawRadiance, p, 0).rgb;
#if VS_ACTIVE_RENDER_TIER >= 2
    radiance -= texelFetch(uSharpRadiance, p, 0).rgb;
#endif
#if defined(VS_ACTIVE_RENDER_TIER) && (VS_ACTIVE_RENDER_TIER >= 3)
    vec3 albedo = max(texelFetch(gAlbedo, p, 0).rgb, vec3(0.0));
#else
    vec3 albedo = pow(max(texelFetch(gAlbedo, p, 0).rgb, vec3(0.0)), vec3(2.2));
#endif
    if (any(isnan(radiance)) || any(isinf(radiance))) return vec3(0.0);
    return clamp(radiance / max(albedo, vec3(0.035)), vec3(0.0), vec3(32.0));
}

vec2 signNotZero(vec2 v) {
    return mix(vec2(-1.0), vec2(1.0), greaterThanEqual(v, vec2(0.0)));
}

float encodeNormal(vec3 normal) {
    vec3 n = normal / max(dot(abs(normal), vec3(1.0)), 1e-5);
    vec2 oct = n.z >= 0.0 ? n.xy : (1.0 - abs(n.yx)) * signNotZero(n.xy);
    ivec2 q = ivec2(round((oct * 0.5 + 0.5) * 31.0));
    return float(q.x + 32 * q.y);
}

vec3 decodeNormal(float code) {
    int bits = int(code);
    vec2 oct = vec2(bits & 31, bits >> 5) * (2.0 / 31.0) - 1.0;
    vec3 n = vec3(oct, 1.0 - abs(oct.x) - abs(oct.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * signNotZero(n.xy);
    return normalize(n);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outAccumRadiance);
    if (any(greaterThanEqual(p, size))) return;

    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    float depth = texelFetch(uLinearDepth, p, 0).r;
#if VS_ACTIVE_RENDER_TIER == 3
    bool sky = depth >= 65536.0 || depth <= 0.0;
    vec4 view = vsWorld.invProj * vec4(uv * 2.0 - 1.0, 0.5, 1.0);
    vec3 viewRay = view.xyz / max(abs(view.w), 1e-6);
    vec3 position = viewRay * (depth / max(abs(viewRay.z), 1e-4));
#else
    bool sky = depth <= 1e-6;
    vec4 view = vsWorld.invProj * vec4(uv * 2.0 - 1.0, max(depth, 1e-6), 1.0);
    vec3 position = view.xyz / view.w;
#endif
    if (sky) {
        imageStore(outAccumRadiance, p, vec4(texelFetch(uRawRadiance, p, 0).rgb, 0.0));
        imageStore(outMoments, p, vec4(0.0));
        return;
    }

    float distanceToCamera = length(position);
    vec3 previousPosition = (vsWorld.invView * vec4(position, 0.0)).xyz + vsWorld.cameraDelta;
    float expectedDepth = length(previousPosition);
    vec3 rawNormal = texelFetch(uNormalRoughness, p, 0).xyz * 2.0 - 1.0;
    vec3 normal = dot(rawNormal, rawNormal) > 1e-6 ? normalize(rawNormal) : vec3(0.0, 1.0, 0.0);
    vec3 current = diffuseSignal(p);
    float currentLuma = dot(current, LUMA);

    vec2 motion = texelFetch(uVelocity, p, 0).xy;
    vec2 historyPixel = vec2(p) - motion * vec2(size);
    vec3 history = vec3(0.0);
    vec2 moments = vec2(0.0);
    float count = 0.0;
    float weight = 0.0;
    if (vsWorld.frameIndex != 0 && all(greaterThanEqual(historyPixel, vec2(-0.5))) &&
        all(lessThan(historyPixel, vec2(size) - 0.5))) {
        ivec2 base = ivec2(floor(historyPixel));
        vec2 frac = fract(historyPixel);
        float tolerance = max(0.06, 0.025 * expectedDepth);
        for (int y = 0; y < 2; ++y) {
            for (int x = 0; x < 2; ++x) {
                ivec2 q = base + ivec2(x, y);
                if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size))) continue;
                vec4 previous = texelFetch(uHistoryMoments, q, 0);
                if (previous.b < 1.0 || previous.b > MAX_HISTORY_LENGTH ||
                    abs(previous.a - expectedDepth) > tolerance) continue;
                vec4 sampleRadiance = texelFetch(uHistoryRadiance, q, 0);
                if (any(isnan(sampleRadiance)) || any(isinf(sampleRadiance)) ||
                    sampleRadiance.a < 0.0 || sampleRadiance.a > 1023.0 ||
                    dot(normal, decodeNormal(sampleRadiance.a)) < MIN_HISTORY_NORMAL_ALIGNMENT) continue;
                vec2 bilinear = mix(1.0 - frac, frac, bvec2(x != 0, y != 0));
                float w = bilinear.x * bilinear.y;
                history += sampleRadiance.rgb * w;
                moments += previous.rg * w;
                count += previous.b * w;
                weight += w;
            }
        }
    }

    vec2 currentMoments = vec2(currentLuma, currentLuma * currentLuma);
    float historyLength = 1.0;
    if (weight > 0.1) {
        history /= weight;
        moments /= weight;
        float deviation = sqrt(max(moments.y - moments.x * moments.x, 0.015));
        float darkeningThreshold = max(0.60, 3.0 * deviation + 0.20);
        if (currentLuma + darkeningThreshold >= moments.x) {
            historyLength = min(count / weight + 1.0, MAX_HISTORY_LENGTH);
            float lumaLimit = moments.x + 4.0 * deviation + 0.35;
            float alpha = max(1.0 / historyLength, MIN_HISTORY_ALPHA);
            float cap = mix(lumaLimit, currentLuma, 0.16);
            current *= min(1.0, cap / max(currentLuma, 1e-5));
            current = mix(history, current, alpha);
            currentMoments = mix(moments, currentMoments, max(alpha, 0.12));
        }
    }

    imageStore(outAccumRadiance, p, vec4(current, encodeNormal(normal)));
    imageStore(outMoments, p, vec4(currentMoments, historyLength, distanceToCamera));
}
