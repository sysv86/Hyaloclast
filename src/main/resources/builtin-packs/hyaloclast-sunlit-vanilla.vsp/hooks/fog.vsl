#include <vulkanshaders/v1/common.vsl>

float sv_fogMiePhase(float cosTheta, float g) {
    float g2 = g * g;
    float denom = max(1.0 + g2 - 2.0 * g * cosTheta, 1e-4);
    return (1.0 - g2) / (12.56637061 * pow(denom, 1.5));
}

// @hook(stage = "fog", priority = 100)
// Sunlit Vanilla - Clean breathable distance haze, gentle valley mist anchored to true world altitude,
// soft golden-hour forward scatter, restrained Tier 0..2 froxel fog, and clear fluid optical absorption.
void sv_fog(in float dist, in vec3 dir, inout vec3 scatter, inout vec3 transmittance) {
    // Fluid optical media across all tiers
    if (vsWorld.eyeInFluid == 1) {
        vec3 sunDirW = normalize(vsWorld.sunDir + vec3(0.0, 1e-5, 0.0));
        float dayW = smoothstep(-0.10, 0.22, sunDirW.y);
        vec3 absorb = exp(-max(dist, 0.0) * vec3(0.24, 0.078, 0.044));
        float fwd = sv_fogMiePhase(dot(dir, sunDirW), 0.70);
        vec3 deepWaterCol = mix(vec3(0.006, 0.025, 0.046), vec3(0.022, 0.130, 0.175), dayW);
        vec3 causticGlow = vec3(0.09, 0.25, 0.30) * (fwd * 0.20 * dayW * smoothstep(-0.1, 0.6, dir.y));
        transmittance *= absorb;
        scatter += (deepWaterCol + causticGlow) * (vec3(1.0) - absorb);
        return;
    }
    if (vsWorld.eyeInFluid == 2) {
        float lavaFactor = exp(-max(dist, 0.0) * 0.52);
        transmittance *= lavaFactor;
        scatter += vec3(0.85, 0.22, 0.03) * (1.0 - lavaFactor);
        return;
    }

    vec3 sunDir = normalize(vsWorld.sunDir + vec3(0.0, 1e-5, 0.0));
    float dayFactor = smoothstep(-0.09, 0.22, sunDir.y);
    float cosTheta = dot(dir, sunDir);

    // Preserve Tiers 0..2 froxel volumetric_fog pass with clean, breathable vanilla restraint
    if (VS_ACTIVE_RENDER_TIER <= 2) {
        if (vsDimensionId() == 0) {
            float sunWarmth = pow(clamp(cosTheta * 0.5 + 0.5, 0.0, 1.0), 2.8) * dayFactor * (1.0 - vsWorld.rain * 0.75);
            scatter *= mix(vec3(0.84, 0.87, 0.90), vec3(0.98, 0.90, 0.80), sunWarmth * 0.45);
            transmittance = mix(vec3(1.0), transmittance, 0.86);
        }
        return;
    }

    int dimId = vsDimensionId();
    float biomeDensity = vsBiomeFogDensityScale();

    if (dimId == 1) {
        float d = clamp(VS_PARAM_FOG_DENSITY * 3.5 * biomeDensity, 0.003, 0.038);
        float factor = clamp(exp(-max(dist - 12.0, 0.0) * d * 0.38), 0.20, 1.0);
        vec3 netherFog = vsHasBiomeTelemetry() ? vsBiomeFogTint() : vec3(0.25, 0.065, 0.035);
        transmittance *= factor;
        scatter += netherFog * (1.0 - factor);
        return;
    }

    if (dimId == 2) {
        float d = clamp(VS_PARAM_FOG_DENSITY * 1.25 * biomeDensity, 0.0009, 0.017);
        float factor = clamp(exp(-max(dist - 30.0, 0.0) * d * 0.20), 0.30, 1.0);
        transmittance *= factor;
        scatter += vec3(0.021, 0.014, 0.044) * (1.0 - factor);
        return;
    }

    // Overworld: breathable distance haze + gentle valley mist anchored to true world Y = 64
    float baseDensity = clamp(VS_PARAM_FOG_DENSITY, 0.0, 0.02) * biomeDensity
        * (1.0 + vsWorld.rain * 0.72 + vsWorld.thunder * 0.25);

    float camY = (dot(uSharc.cfg.cameraPosition.xyz, uSharc.cfg.cameraPosition.xyz) > 1e-4)
        ? uSharc.cfg.cameraPosition.y
        : (64.0 + vsWorld.cameraPosFrac.y);
    float rayEndY = camY + dir.y * dist;
    float valleyMist = clamp(exp(-(rayEndY - 64.0) * 0.015), 0.12, 1.40);
    float effectiveDist = max(dist - 34.0, 0.0) * valleyMist;
    float factor = clamp(exp(-effectiveDist * baseDensity * 0.062), 0.40, 1.0);

    float goldenFactor = smoothstep(-0.14, 0.04, sunDir.y) * (1.0 - smoothstep(0.10, 0.32, sunDir.y));
    vec3 baseDayFog = mix(vec3(0.50, 0.74, 0.97), vsBiomeFogTint(), vsHasBiomeTelemetry() ? 0.45 : 0.0);
    vec3 dayFog = mix(baseDayFog, vec3(1.02, 0.60, 0.32), goldenFactor * 0.68);
    vec3 nightFog = mix(vec3(0.016, 0.028, 0.060), vsBiomeFogTint() * 0.05, vsHasBiomeTelemetry() ? 0.30 : 0.0);
    vec3 fogTint = mix(nightFog, dayFog, dayFactor);

    // Soft golden-hour forward scatter
    float mie = sv_fogMiePhase(cosTheta, 0.70);
    float godrayScale = clamp(VS_PARAM_GODRAYS_INTENSITY, 0.0, 2.0);
    vec3 sunGlow = mix(vec3(1.04, 0.94, 0.78), vec3(1.26, 0.62, 0.26), goldenFactor)
        * mie * (0.14 + 0.10 * godrayScale) * dayFactor * (1.0 - vsWorld.rain * 0.74);
    fogTint += sunGlow;

    fogTint = mix(fogTint, vec3(0.22, 0.26, 0.32) * mix(0.17, 1.0, dayFactor), vsWorld.rain * 0.74);
    transmittance *= factor;
    scatter += fogTint * (1.0 - factor);
}
